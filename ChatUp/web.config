<?xml version="1.0" encoding="utf-8"?>
<!--
  Publishing adds the ASP.NET Core module (handlers / aspNetCore) to this file.
  Security headers are added by SecurityHeadersMiddleware; this file only stops IIS
  from advertising itself (Server needs IIS 10 / Windows Server 2016 or newer).
-->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <security>
        <requestFiltering removeServerHeader="true" />
      </security>
      <httpProtocol>
        <customHeaders>
          <remove name="X-Powered-By" />
        </customHeaders>
      </httpProtocol>
    </system.webServer>
  </location>
</configuration>
