@inject NavigationManager Navigation

@if (Show)
{
    <div class="se-backdrop">
        <div class="se-card" role="alertdialog" aria-modal="true" aria-labelledby="se-title" aria-describedby="se-text">
            <div class="se-icon"><i class="fa-solid fa-clock-rotate-left"></i></div>
            <h2 id="se-title">Your session has expired</h2>
            <p id="se-text">For your security you've been signed out. Sign in again to pick up where you left off.</p>
            <button class="se-btn" @onclick="GoToLogin">
                <i class="fa-solid fa-right-to-bracket"></i> Sign in again
            </button>
        </div>
    </div>
}

@code {
    [Parameter] public bool Show { get; set; }
    [Parameter] public EventCallback<bool> ShowChanged { get; set; }

    private async Task GoToLogin()
    {
        await ShowChanged.InvokeAsync(false);
        Navigation.NavigateTo("/login", forceLoad: true);
    }
}
