@inherits LayoutComponentBase
@inject IJSRuntime JS
<PageTitle>Login</PageTitle>

<div class="lg">
    <!-- LEFT: brand panel (hidden on small screens) -->
    <section class="lg-brand" aria-hidden="true">
        <img src="/images/bg.png" class="lg-brand-bg" alt="" />
        <div class="lg-brand-overlay"></div>
        <div class="lg-brand-content">
            <img src="/images/odeccilogo.svg" alt="" class="lg-brand-logo" />
            <h1>Support that keeps <span>every client</span> moving.</h1>
            <ul>
                <li><i class="fa-solid fa-bolt"></i> Real-time ticket chat</li>
                <li><i class="fa-solid fa-stopwatch"></i> Business-hours SLA tracking</li>
                <li><i class="fa-solid fa-shield-halved"></i> Secure, role-based access</li>
            </ul>
        </div>
    </section>

    <!-- RIGHT: form area -->
    <section class="lg-form">
        <div class="aurora aurora-1"></div>
        <div class="aurora aurora-2"></div>
        <div class="aurora aurora-3"></div>
        <div class="lg-grid"></div>

        <!-- Falling objects -->
        <div class="falling-container" id="falling"></div>

        <div class="lg-mobile-brand">
            <img src="/images/odeccilogo.svg" alt="Odecci" />
        </div>

        <div class="login-content">
            @Body
        </div>

        <footer class="lg-foot">© @DateTime.Now.Year Odecci · Secure sign-in</footer>
    </section>
</div>

@* Page-level rule: the split screen never scrolls on desktop, but must scroll on phones *@
<style>
    @@media (min-width: 900px) {
        html, body { height: 100%; overflow: hidden; }
    }
</style>

@code {
    private bool _started;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !_started)
        {
            _started = true;
            var shapes = new[] { "✦", "✧", "★", "☆", "◆", "◇", "○", "●", "▲", "▼", "❤", "☾" };
            try
            {
                await JS.InvokeVoidAsync("startFalling", "falling", shapes, 250);
            }
            catch (JSException)
            {
                // Decorative only — the form works without it
            }
        }
    }
}
