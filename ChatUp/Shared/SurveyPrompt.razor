<div class="sp">
    <span class="sp-icon"><i class="fa-regular fa-comment-dots"></i></span>
    <div>
        <strong>@Title</strong>
        <span>
            Please take our
            <a target="_blank" rel="noopener" href="https://go.microsoft.com/fwlink/?linkid=2186158">brief survey</a>
            and tell us what you think.
        </span>
    </div>
</div>

@code {
    // Demonstrates how a parent component can supply parameters
    [Parameter]
    public string? Title { get; set; }
}
