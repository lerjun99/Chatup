@inherits LayoutComponentBase
@implements IDisposable
@attribute [StreamRendering]
@using ChatUp.Application.Auth.Commands
@using Microsoft.AspNetCore.Components.Routing
@using Microsoft.AspNetCore.SignalR.Client
@inject ChatUp.Services.SessionService SessionService
@inject NavigationManager Navigation
@inject IDialogService DialogService
@inject TitleService TitleService
@inject UserState UserState
@inject IJSRuntime JS
@inject HttpClient Http
@inject ChatUp.Services.LinkService LinkService
@inject ChatUp.Services.ChatService ChatService
@inject Blazored.SessionStorage.ISessionStorageService SessionStorage
@inject Blazored.LocalStorage.ILocalStorageService LocalStorage
@inject AuthenticationStateProvider AuthStateProvider
@inject ChatUp.Services.Security.ActivityIdentity ActivityIdentity
@inject ChatUp.Services.Security.SessionGuard SessionGuard
@using ChatUp.Services.Security
<FluentToastProvider />
<FluentDialogProvider />
<FluentTooltipProvider />
<FluentMessageBarProvider />
<FluentMenuProvider />

@if (_isPublicRoute)
{
    @Body
}
else if (_gate != GateState.Granted)
{
    @* Nothing from the page is rendered (or loaded) until the API confirms the session *@
    <div class="app-gate" role="status" aria-live="polite">
        @if (_gate == GateState.Unavailable)
        {
            <i class="fa-solid fa-plug-circle-exclamation app-gate-icon"></i>
            <h2>Can't confirm your session</h2>
            <p>The server isn't responding right now. Check your connection, then try again.</p>
            <div class="app-gate-actions">
                <button class="app-gate-btn" @onclick="RetryGateAsync">Try again</button>
                <a class="app-gate-link" href="/login">Go to sign in</a>
            </div>
        }
        else
        {
            <span class="app-gate-spinner" aria-hidden="true"></span>
            <p>Checking your session…</p>
        }
    </div>
}
else
{
<div class="app @(_navCollapsed ? "is-nav-collapsed" : "") @(_drawerOpen ? "is-drawer-open" : "")"
     @onkeydown="OnKeyDown">

    <!-- ============ SIDEBAR / DRAWER ============ -->
    <aside id="sidebarNav" class="app-sidebar" tabindex="-1" @ref="_sidebar">
        <NavMenu Collapsed="@(_navCollapsed && !_drawerOpen)"
                 ActiveKey="@ActiveItem?.Key"
                 OpenTicketCount="_openTicketCount"
                 OnNavigate="CloseDrawer"
                 OnLogout="NavigateToLogout"
                 OnToggleCollapse="ToggleCollapse" />
    </aside>
    <div class="app-scrim" @onclick="CloseDrawer"></div>

    <!-- ============ MAIN ============ -->
    <div class="app-main">
        <header class="app-topbar">
            <button class="app-icon-btn app-only-mobile" title="Open menu"
                    aria-controls="sidebarNav" aria-expanded="@_drawerOpen" @onclick="OpenDrawer">
                <i class="fa-solid fa-bars"></i>
            </button>

            <div class="app-title">
                <div class="app-crumb">
                    <span>@(ActiveItem?.Section ?? "ChatUp")</span>
                    @if (ActiveItem != null)
                    {
                        <i class="fa-solid fa-chevron-right"></i>
                        <span>@ActiveItem.Label</span>
                    }
                </div>
                <h1 title="@PageTitle">@PageTitle</h1>
            </div>

            <div class="app-actions">
                <InstallAppButton />
                @if (InboxUrl != null)
                {
                    <a class="app-icon-btn app-inbox-btn" href="@InboxUrl" title="@(_openTicketCount > 0 ? $"Inbox · {_openTicketCount} open tickets" : "Inbox")">
                        <i class="fa-regular fa-envelope"></i>
                        @if (_openTicketCount > 0)
                        {
                            <span class="app-bell-badge is-muted">@(_openTicketCount > 99 ? "99+" : _openTicketCount.ToString())</span>
                        }
                    </a>
                }
                @if (_hubUserId is int bellUserId)
                {
                    <NotificationBell UserId="bellUserId" />
                }

                <div class="app-user">
                    <button class="app-user-btn" aria-haspopup="menu" aria-expanded="@_userMenuOpen" @onclick="ToggleUserMenu">
                        <span class="app-avatar">
                            @if (!string.IsNullOrEmpty(UserState.AvatarUrl))
                            {
                                <img src="@UserState.AvatarUrl" alt="" />
                            }
                            else
                            {
                                @Initials(UserState.Username)
                            }
                        </span>
                        <span class="app-user-text">
                            <strong>@(UserState.Username ?? "Account")</strong>
                            <small>@ChatUp.Shared.NavCatalog.RoleLabel(UserState.UserType)</small>
                        </span>
                        <i class="fa-solid fa-chevron-down app-user-caret"></i>
                    </button>

                    @if (_userMenuOpen)
                    {
                        <div class="app-menu-backdrop" @onclick="CloseUserMenu"></div>
                        <div class="app-menu" role="menu">
                            <div class="app-menu-head">
                                <span class="app-avatar app-avatar-lg">
                                    @if (!string.IsNullOrEmpty(UserState.AvatarUrl))
                                    {
                                        <img src="@UserState.AvatarUrl" alt="" />
                                    }
                                    else
                                    {
                                        @Initials(UserState.Username)
                                    }
                                </span>
                                <div>
                                    <strong>@UserState.Username</strong>
                                    <small><span class="app-dot"></span> @ChatUp.Shared.NavCatalog.RoleLabel(UserState.UserType) · Online</small>
                                </div>
                            </div>
                            <button role="menuitem" class="app-menu-item" @onclick="NavigateAccount">
                                <i class="fa-regular fa-user"></i> My profile
                            </button>
                            <button role="menuitem" class="app-menu-item" @onclick="NavigateChangePassword">
                                <i class="fa-solid fa-key"></i> Change password
                            </button>
                            <div class="app-menu-sep"></div>
                            <button role="menuitem" class="app-menu-item is-danger" @onclick="NavigateToLogout">
                                <i class="fa-solid fa-right-from-bracket"></i> Log out
                            </button>
                        </div>
                    }
                </div>
            </div>
        </header>

        <article class="app-content">
            @if (_forbidden)
            {
                <div class="app-gate app-gate-inline" role="alert">
                    <i class="fa-solid fa-lock app-gate-icon"></i>
                    <h2>You don't have access to this page</h2>
                    <p>Your account (@ChatUp.Shared.NavCatalog.RoleLabel(UserState.UserType)) can't open this page. Ask an administrator if you need it.</p>
                    <div class="app-gate-actions">
                        <a class="app-gate-btn" href="@HomeUrl">Back to my workspace</a>
                    </div>
                </div>
            }
            else
            {
                @Body
            }
        </article>
    </div>

    <!-- ============ MOBILE TAB BAR ============ -->
    <nav class="app-tabbar" aria-label="Quick navigation">
        @foreach (var item in TabItems)
        {
            var url = ChatUp.Shared.NavCatalog.BuildUrl(item, UserState.UserId, LinkService);
            var isActive = item.Key == ActiveItem?.Key;
            <a @key="item.Key" href="@(url ?? "#")" class="app-tab @(isActive ? "is-active" : "")" aria-current="@(isActive ? "page" : null)">
                <span class="app-tab-icon">
                    <i class="@item.Icon"></i>
                    @if (item.Key == "inbox" && _openTicketCount > 0)
                    {
                        <span class="app-tab-badge">@(_openTicketCount > 99 ? "99+" : _openTicketCount.ToString())</span>
                    }
                </span>
                <span>@item.Label</span>
            </a>
        }
        <button class="app-tab @(_drawerOpen ? "is-active" : "")" @onclick="OpenDrawer">
            <span class="app-tab-icon"><i class="fa-solid fa-grip"></i></span>
            <span>More</span>
        </button>
    </nav>
</div>
}

<SessionExpiredModal @bind-Show="_showSessionExpired" />

@code {
    private const string CollapsedStorageKey = "navCollapsed";

    private bool _showSessionExpired;
    private bool _drawerOpen;
    private bool _focusSidebar;
    private bool _navCollapsed;
    private bool _userMenuOpen;
    private int _openTicketCount;
    private int? _countUserId;
    private bool _ticketUpdateHooked;
    private CancellationTokenSource? _countCts;
    private int? _hubUserId;
    private ElementReference _sidebar;
    private string PageTitle = string.Empty;

    private ChatUp.Shared.NavItem? ActiveItem => ChatUp.Shared.NavCatalog.Active(Navigation.Uri);

    // The bottom bar shows the first four destinations; everything else lives behind "More"
    private IEnumerable<ChatUp.Shared.NavItem> TabItems =>
        ChatUp.Shared.NavCatalog.VisibleFor(UserState.UserType).Take(4);

    private string? InboxUrl
    {
        get
        {
            var inbox = ChatUp.Shared.NavCatalog.Items.First(i => i.Key == "inbox");
            return inbox.IsVisibleFor(UserState.UserType)
                ? ChatUp.Shared.NavCatalog.BuildUrl(inbox, UserState.UserId, LinkService)
                : null;
        }
    }

    // =============================
    // LIFECYCLE
    // =============================
    protected override void OnInitialized()
    {
        PageTitle = TitleService.Title == "Default Title" ? string.Empty : TitleService.Title;
        TitleService.OnTitleChanged += HandleTitleChanged;
        UserState.OnChange += HandleUserStateChanged;
        SessionService.OnSessionExpired += HandleSessionExpired;
        ChatService.OnOpenTicketCountChanged += HandleOpenTicketCountChanged;
        Navigation.LocationChanged += HandleLocationChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            if (RouteAccess.IsPublic(Navigation.Uri))
            {
                _isPublicRoute = true;
                StateHasChanged();
                return;
            }

            await InitializeAppAsync();
        }

        if (_focusSidebar)
        {
            _focusSidebar = false;
            await _sidebar.FocusAsync(); // move focus into the drawer for keyboard/screen-reader users
        }
    }

    // =============================
    // SESSION GUARD — every route needs a live session
    // =============================
    private enum GateState { Checking, Granted, Unavailable }

    private GateState _gate = GateState.Checking;
    private bool _isPublicRoute;
    private bool _forbidden;
    private bool _appStarted;
    private IDisposable? _navigationGuard;

    private string HomeUrl
    {
        get
        {
            var first = ChatUp.Shared.NavCatalog.VisibleFor(UserState.UserType).FirstOrDefault();
            return first == null ? "/login" : ChatUp.Shared.NavCatalog.BuildUrl(first, UserState.UserId, LinkService) ?? "/login";
        }
    }

    /// <summary>
    /// Confirms the session with the API before anything from the page renders. A missing, logged-out or expired
    /// session goes to sign in; a link that isn't for this role shows "no access"; another user's link is corrected.
    /// </summary>
    private async Task InitializeAppAsync()
    {
        var check = await SessionGuard.CheckAsync();
        if (!await HandleInactiveAsync(check))
            return;

        if (!_appStarted)
        {
            _appStarted = true;
            await StartAppAsync(check);
        }

        // A link with someone else's id: reload on the user's own id rather than render the other user's page
        var decision = RouteAccess.Evaluate(Navigation.Uri, UserState.UserId, UserState.UserType, LinkService, out var redirectTo);
        if (decision == RouteDecision.Redirect && redirectTo != null)
        {
            Navigation.NavigateTo(redirectTo, forceLoad: true, replace: true);
            return;
        }

        _forbidden = decision == RouteDecision.Forbidden;
        _navigationGuard ??= Navigation.RegisterLocationChangingHandler(OnLocationChangingAsync);
        _gate = GateState.Granted;
        StateHasChanged();
    }

    /// <summary>True when the session is active; otherwise sends the user where they need to go.</summary>
    private async Task<bool> HandleInactiveAsync(SessionCheck check)
    {
        switch (check.Status)
        {
            case SessionStatus.Active:
                ApplySession(check);
                return true;

            case SessionStatus.Expired:
                Navigation.NavigateTo("/session-expired", forceLoad: true, replace: true);
                return false;

            case SessionStatus.SignedOut:
                await SessionGuard.ClearAsync(); // leftovers would make the sign-in page bounce back here
                Navigation.NavigateTo("/login", forceLoad: true, replace: true);
                return false;

            default:
                _gate = GateState.Unavailable;
                StateHasChanged();
                return false;
        }
    }

    /// <summary>The API's answer is the truth about who is signed in (also fills in "remember me" tabs).</summary>
    private void ApplySession(SessionCheck check)
    {
        UserState.UserId = check.UserId;
        UserState.UserType = check.UserType;
        if (!string.IsNullOrWhiteSpace(check.Username))
            UserState.Username = check.Username;
        if (check.ClientId.HasValue)
            UserState.ClientId = check.ClientId;
    }

    /// <summary>Runs before every in-app navigation: no live session, no navigation.</summary>
    private async ValueTask OnLocationChangingAsync(LocationChangingContext context)
    {
        var target = Navigation.ToAbsoluteUri(context.TargetLocation).ToString();
        if (RouteAccess.IsPublic(target))
            return;

        SessionCheck check;
        try
        {
            check = await SessionGuard.CheckAsync(context.CancellationToken);
        }
        catch (OperationCanceledException)
        {
            return; // superseded by a newer navigation
        }

        if (check.Status != SessionStatus.Active)
        {
            context.PreventNavigation();
            await InvokeAsync(() => HandleInactiveAsync(check));
            return;
        }

        ApplySession(check);

        var decision = RouteAccess.Evaluate(target, check.UserId, check.UserType, LinkService, out var redirectTo);
        if (decision == RouteDecision.Redirect && redirectTo != null)
        {
            context.PreventNavigation();
            _ = InvokeAsync(() => Navigation.NavigateTo(redirectTo, replace: true));
        }
    }

    private async Task RetryGateAsync()
    {
        _gate = GateState.Checking;
        StateHasChanged();
        await InitializeAppAsync();
    }

    private async Task StartAppAsync(SessionCheck check)
    {
        {
            await UserState.LoadAsync();
            ApplySession(check); // storage may be stale or empty; the API's values win
            await LoadActivityIdentityAsync();
            LogPageView(Navigation.Uri);

            try
            {
                _navCollapsed = await LocalStorage.GetItemAsync<bool>(CollapsedStorageKey);
            }
            catch
            {
                // Storage unavailable — keep the default expanded sidebar
            }

            await LoadTicketCountAsync();
        }
    }

    private async Task LoadTicketCountAsync()
    {
        var userId = UserState.UserId;

        // Fall back to the encrypted id kept in session storage
        if (!userId.HasValue)
        {
            var savedUserId = await SessionStorage.GetItemAsync<string>("UserId");
            if (!string.IsNullOrEmpty(savedUserId) &&
                int.TryParse(LinkService.Unprotect(Uri.UnescapeDataString(savedUserId)), out var parsed))
            {
                userId = parsed;
                UserState.UserId = parsed;
            }
        }

        if (!userId.HasValue || UserState.UserType == 5)
            return;

        _countUserId = userId;

        // The realtime connection starts with the app, not only on the inbox: notifications, badges and
        // dashboards need it on every page
        try
        {
            await ChatService.StartAsync(userId.Value);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Realtime connection failed: {ex.Message}");
        }

        _hubUserId = userId;

        try
        {
            await ChatService.LoadOpenTicketCount(userId.Value);

            // Keep the count fresh (debounced: a burst of ticket events costs one request)
            if (!_ticketUpdateHooked)
            {
                ChatService.OnTicketUpdated += HandleTicketUpdated;
                _ticketUpdateHooked = true;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Open ticket count failed: {ex.Message}");
        }
    }

    private void HandleTicketUpdated()
    {
        _countCts?.Cancel();
        var cts = _countCts = new CancellationTokenSource();
        _ = InvokeAsync(async () =>
        {
            try
            {
                await Task.Delay(800, cts.Token);
                if (_countUserId.HasValue)
                    await ChatService.LoadOpenTicketCount(_countUserId.Value);
            }
            catch (TaskCanceledException) { }
            catch (Exception ex) { Console.WriteLine($"Open ticket count failed: {ex.Message}"); }
        });
    }

    public void Dispose()
    {
        TitleService.OnTitleChanged -= HandleTitleChanged;
        UserState.OnChange -= HandleUserStateChanged;
        SessionService.OnSessionExpired -= HandleSessionExpired;
        ChatService.OnOpenTicketCountChanged -= HandleOpenTicketCountChanged;
        Navigation.LocationChanged -= HandleLocationChanged;
        _navigationGuard?.Dispose();
        if (_ticketUpdateHooked)
            ChatService.OnTicketUpdated -= HandleTicketUpdated;
        _countCts?.Cancel();
    }

    // =============================
    // EVENT HANDLERS
    // =============================
    private void HandleTitleChanged(string title)
    {
        PageTitle = title;
        InvokeAsync(StateHasChanged);
    }

    private void HandleUserStateChanged() => InvokeAsync(StateHasChanged);

    private void HandleOpenTicketCountChanged(int count)
    {
        _openTicketCount = count;
        InvokeAsync(StateHasChanged);
    }

    private void HandleLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        // Close overlays on navigation and refresh the active item
        _drawerOpen = false;
        _userMenuOpen = false;
        if (_gate == GateState.Granted)
            _forbidden = RouteAccess.Evaluate(e.Location, UserState.UserId, UserState.UserType, LinkService, out _) == RouteDecision.Forbidden;
        InvokeAsync(StateHasChanged);
        LogPageView(e.Location);
    }

    // =============================
    // AUDIT LOG
    // =============================
    private const string AuditSessionKey = "auditSessionId";
    private string? _lastLoggedPage;

    /// <summary>
    /// Lets the API know who is acting: the signed-in user's session token (the API verifies it) and one session id
    /// per browser tab, kept across page reloads so Login → … → Logout reads as one session.
    /// </summary>
    private async Task LoadActivityIdentityAsync()
    {
        try
        {
            var stored = await SessionStorage.GetItemAsync<string>("AuthToken");
            if (string.IsNullOrEmpty(stored))
                stored = await LocalStorage.GetItemAsync<string>("AuthToken");
            if (!string.IsNullOrEmpty(stored))
            {
                var token = LinkService.Unprotect(Uri.UnescapeDataString(stored));
                ActivityIdentity.UserToken = string.IsNullOrWhiteSpace(token) ? null : token;
            }

            var sessionId = await SessionStorage.GetItemAsync<string>(AuditSessionKey);
            if (string.IsNullOrWhiteSpace(sessionId))
                await SessionStorage.SetItemAsync(AuditSessionKey, ActivityIdentity.SessionId);
            else
                ActivityIdentity.SessionId = sessionId;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Audit identity not loaded: {ex.Message}");
        }
    }

    /// <summary>Reports the page the user opened (fire-and-forget; never slows navigation).</summary>
    private void LogPageView(string uri)
    {
        if (string.IsNullOrEmpty(ActivityIdentity.UserToken))
            return;

        var path = new Uri(uri).AbsolutePath;
        var first = path.Trim('/').Split('/', StringSplitOptions.RemoveEmptyEntries).FirstOrDefault() ?? string.Empty;
        var route = "/" + first; // the rest of the path is usually an encrypted id

        if (route == _lastLoggedPage)
            return;
        _lastLoggedPage = route;

        var title = ChatUp.Shared.NavCatalog.Active(uri)?.Label
                    ?? (string.IsNullOrWhiteSpace(PageTitle) ? ChatUp.Application.Auditing.ChangeFormatter.Humanize(first.Replace('-', ' ')) : PageTitle);

        _ = Task.Run(async () =>
        {
            try
            {
                await Http.PostAsJsonAsync($"{AppConfig.ChatUrl}AdminActivity/PageView", new { Route = route, Title = title });
            }
            catch { /* page visits are best effort */ }
        });
    }

    private async void HandleSessionExpired()
    {
        await InvokeAsync(() =>
        {
            _showSessionExpired = true;
            StateHasChanged();
        });
    }

    private void OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
        {
            _drawerOpen = false;
            _userMenuOpen = false;
        }
    }

    // =============================
    // NAV STATE
    // =============================
    private void OpenDrawer()
    {
        _drawerOpen = true;
        _userMenuOpen = false;
        _focusSidebar = true;
    }

    private void CloseDrawer() => _drawerOpen = false;

    private async Task ToggleCollapse()
    {
        _navCollapsed = !_navCollapsed;
        try
        {
            await LocalStorage.SetItemAsync(CollapsedStorageKey, _navCollapsed);
        }
        catch
        {
            // Not persisted — still works for this session
        }
    }

    private void ToggleUserMenu() => _userMenuOpen = !_userMenuOpen;
    private void CloseUserMenu() => _userMenuOpen = false;

    // =============================
    // ACCOUNT
    // =============================
    private string? OwnToken =>
        UserState.UserId.HasValue ? Uri.EscapeDataString(LinkService.Protect(UserState.UserId.Value.ToString())) : null;

    private void NavigateAccount()
    {
        _userMenuOpen = false;
        if (OwnToken is string token)
            Navigation.NavigateTo($"/user-registers/{token}");
    }

    private void NavigateChangePassword()
    {
        _userMenuOpen = false;
        if (OwnToken is string token)
            Navigation.NavigateTo($"/change-password/{token}", true);
    }

    private async Task NavigateToLogout()
    {
        _userMenuOpen = false;

        try
        {
            var dialog = await DialogService.ShowConfirmationAsync("Are you sure you want to log out?", "Log out", "Cancel", "Log out");
            var result = await dialog.Result;
            if (result.Cancelled) return;

            var userId = UserState?.UserId;
            if (userId.HasValue)
            {
                try
                {
                    // 🟢 Notify chat service user is offline, then the backend
                    if (ChatService != null)
                        await ChatService.SetUserOfflineAsync(userId.Value);

                    var logoutCommand = new LogoutCommand { UserId = userId.Value };
                    var response = await Http.PostAsJsonAsync($"{AppConfig.ChatUrl}Auth/Logout/logout", logoutCommand);
                    Console.WriteLine($"Logout API: {response.StatusCode}");
                }
                catch (Exception ex)
                {
                    Console.WriteLine($"Logout service error: {ex.Message}");
                }
            }

            // 🧹 Clear both session & local storage
            await SessionStorage.ClearAsync();
            await LocalStorage.ClearAsync();
            ActivityIdentity.UserToken = null;

            if (UserState != null)
            {
                UserState.UserId = null;
                UserState.Username = null;
                UserState.UserType = 0;
            }

            if (AuthStateProvider is CustomAuthStateProvider provider)
                provider.NotifyUserLogout();

            if (ChatService != null)
                await ChatService.DisposeAsync();

            Navigation.NavigateTo("/", forceLoad: true);
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"Logout failed: {ex.Message}");
            await DialogService.ShowErrorAsync("Logout failed. Please try again later.");
        }
    }

    private static string Initials(string? name)
    {
        var parts = (name ?? string.Empty).Split(new[] { ' ', '.', '_' }, StringSplitOptions.RemoveEmptyEntries);
        return parts.Length switch
        {
            0 => "?",
            1 => parts[0][..1].ToUpperInvariant(),
            _ => $"{parts[0][0]}{parts[^1][0]}".ToUpperInvariant()
        };
    }
}
