@inherits LayoutComponentBase
@implements IDisposable
@attribute [StreamRendering]
@using ChatUp.Application.Auth.Commands
@using Microsoft.AspNetCore.Components.Routing
@using Microsoft.AspNetCore.SignalR.Client
@inject ChatUp.Services.SessionService SessionService
@inject NavigationManager Navigation
@inject IDialogService DialogService
@inject TitleService TitleService
@inject UserState UserState
@inject IJSRuntime JS
@inject HttpClient Http
@inject ChatUp.Services.LinkService LinkService
@inject ChatUp.Services.ChatService ChatService
@inject Blazored.SessionStorage.ISessionStorageService SessionStorage
@inject Blazored.LocalStorage.ILocalStorageService LocalStorage
@inject AuthenticationStateProvider AuthStateProvider
<FluentToastProvider />
<FluentDialogProvider />
<FluentTooltipProvider />
<FluentMessageBarProvider />
<FluentMenuProvider />

<div class="app @(_navCollapsed ? "is-nav-collapsed" : "") @(_drawerOpen ? "is-drawer-open" : "")"
     @onkeydown="OnKeyDown">

    <!-- ============ SIDEBAR / DRAWER ============ -->
    <aside id="sidebarNav" class="app-sidebar" tabindex="-1" @ref="_sidebar">
        <NavMenu Collapsed="@(_navCollapsed && !_drawerOpen)"
                 ActiveKey="@ActiveItem?.Key"
                 OpenTicketCount="_openTicketCount"
                 OnNavigate="CloseDrawer"
                 OnLogout="NavigateToLogout"
                 OnToggleCollapse="ToggleCollapse" />
    </aside>
    <div class="app-scrim" @onclick="CloseDrawer"></div>

    <!-- ============ MAIN ============ -->
    <div class="app-main">
        <header class="app-topbar">
            <button class="app-icon-btn app-only-mobile" title="Open menu"
                    aria-controls="sidebarNav" aria-expanded="@_drawerOpen" @onclick="OpenDrawer">
                <i class="fa-solid fa-bars"></i>
            </button>

            <div class="app-title">
                <div class="app-crumb">
                    <span>@(ActiveItem?.Section ?? "ChatUp")</span>
                    @if (ActiveItem != null)
                    {
                        <i class="fa-solid fa-chevron-right"></i>
                        <span>@ActiveItem.Label</span>
                    }
                </div>
                <h1 title="@PageTitle">@PageTitle</h1>
            </div>

            <div class="app-actions">
                @if (InboxUrl != null)
                {
                    <a class="app-icon-btn app-bell" href="@InboxUrl" title="@(_openTicketCount > 0 ? $"{_openTicketCount} open tickets" : "Inbox")">
                        <i class="fa-regular fa-bell"></i>
                        @if (_openTicketCount > 0)
                        {
                            <span class="app-bell-badge">@(_openTicketCount > 99 ? "99+" : _openTicketCount.ToString())</span>
                        }
                    </a>
                }

                <div class="app-user">
                    <button class="app-user-btn" aria-haspopup="menu" aria-expanded="@_userMenuOpen" @onclick="ToggleUserMenu">
                        <span class="app-avatar">
                            @if (!string.IsNullOrEmpty(UserState.AvatarUrl))
                            {
                                <img src="@UserState.AvatarUrl" alt="" />
                            }
                            else
                            {
                                @Initials(UserState.Username)
                            }
                        </span>
                        <span class="app-user-text">
                            <strong>@(UserState.Username ?? "Account")</strong>
                            <small>@ChatUp.Shared.NavCatalog.RoleLabel(UserState.UserType)</small>
                        </span>
                        <i class="fa-solid fa-chevron-down app-user-caret"></i>
                    </button>

                    @if (_userMenuOpen)
                    {
                        <div class="app-menu-backdrop" @onclick="CloseUserMenu"></div>
                        <div class="app-menu" role="menu">
                            <div class="app-menu-head">
                                <span class="app-avatar app-avatar-lg">
                                    @if (!string.IsNullOrEmpty(UserState.AvatarUrl))
                                    {
                                        <img src="@UserState.AvatarUrl" alt="" />
                                    }
                                    else
                                    {
                                        @Initials(UserState.Username)
                                    }
                                </span>
                                <div>
                                    <strong>@UserState.Username</strong>
                                    <small><span class="app-dot"></span> @ChatUp.Shared.NavCatalog.RoleLabel(UserState.UserType) · Online</small>
                                </div>
                            </div>
                            <button role="menuitem" class="app-menu-item" @onclick="NavigateAccount">
                                <i class="fa-regular fa-user"></i> My profile
                            </button>
                            <button role="menuitem" class="app-menu-item" @onclick="NavigateChangePassword">
                                <i class="fa-solid fa-key"></i> Change password
                            </button>
                            <div class="app-menu-sep"></div>
                            <button role="menuitem" class="app-menu-item is-danger" @onclick="NavigateToLogout">
                                <i class="fa-solid fa-right-from-bracket"></i> Log out
                            </button>
                        </div>
                    }
                </div>
            </div>
        </header>

        <article class="app-content">
            @Body
        </article>
    </div>

    <!-- ============ MOBILE TAB BAR ============ -->
    <nav class="app-tabbar" aria-label="Quick navigation">
        @foreach (var item in TabItems)
        {
            var url = ChatUp.Shared.NavCatalog.BuildUrl(item, UserState.UserId, LinkService);
            var isActive = item.Key == ActiveItem?.Key;
            <a @key="item.Key" href="@(url ?? "#")" class="app-tab @(isActive ? "is-active" : "")" aria-current="@(isActive ? "page" : null)">
                <span class="app-tab-icon">
                    <i class="@item.Icon"></i>
                    @if (item.Key == "inbox" && _openTicketCount > 0)
                    {
                        <span class="app-tab-badge">@(_openTicketCount > 99 ? "99+" : _openTicketCount.ToString())</span>
                    }
                </span>
                <span>@item.Label</span>
            </a>
        }
        <button class="app-tab @(_drawerOpen ? "is-active" : "")" @onclick="OpenDrawer">
            <span class="app-tab-icon"><i class="fa-solid fa-grip"></i></span>
            <span>More</span>
        </button>
    </nav>
</div>

<SessionExpiredModal @bind-Show="_showSessionExpired" />

@code {
    private const string CollapsedStorageKey = "navCollapsed";

    private bool _showSessionExpired;
    private bool _drawerOpen;
    private bool _focusSidebar;
    private bool _navCollapsed;
    private bool _userMenuOpen;
    private int _openTicketCount;
    private int? _countUserId;
    private IDisposable? _ticketUpdateSubscription;
    private ElementReference _sidebar;
    private string PageTitle = string.Empty;

    private ChatUp.Shared.NavItem? ActiveItem => ChatUp.Shared.NavCatalog.Active(Navigation.Uri);

    // The bottom bar shows the first four destinations; everything else lives behind "More"
    private IEnumerable<ChatUp.Shared.NavItem> TabItems =>
        ChatUp.Shared.NavCatalog.VisibleFor(UserState.UserType).Take(4);

    private string? InboxUrl
    {
        get
        {
            var inbox = ChatUp.Shared.NavCatalog.Items.First(i => i.Key == "inbox");
            return inbox.IsVisibleFor(UserState.UserType)
                ? ChatUp.Shared.NavCatalog.BuildUrl(inbox, UserState.UserId, LinkService)
                : null;
        }
    }

    // =============================
    // LIFECYCLE
    // =============================
    protected override void OnInitialized()
    {
        PageTitle = TitleService.Title == "Default Title" ? string.Empty : TitleService.Title;
        TitleService.OnTitleChanged += HandleTitleChanged;
        UserState.OnChange += HandleUserStateChanged;
        SessionService.OnSessionExpired += HandleSessionExpired;
        ChatService.OnOpenTicketCountChanged += HandleOpenTicketCountChanged;
        Navigation.LocationChanged += HandleLocationChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await UserState.LoadAsync();

            try
            {
                _navCollapsed = await LocalStorage.GetItemAsync<bool>(CollapsedStorageKey);
            }
            catch
            {
                // Storage unavailable — keep the default expanded sidebar
            }

            await LoadTicketCountAsync();

            // Re-render once with the loaded user — previously this ran after *every* render,
            // which kept the whole layout re-rendering in a loop
            StateHasChanged();
        }

        if (_focusSidebar)
        {
            _focusSidebar = false;
            await _sidebar.FocusAsync(); // move focus into the drawer for keyboard/screen-reader users
        }
    }

    private async Task LoadTicketCountAsync()
    {
        var userId = UserState.UserId;

        // Fall back to the encrypted id kept in session storage
        if (!userId.HasValue)
        {
            var savedUserId = await SessionStorage.GetItemAsync<string>("UserId");
            if (!string.IsNullOrEmpty(savedUserId) &&
                int.TryParse(LinkService.Unprotect(Uri.UnescapeDataString(savedUserId)), out var parsed))
            {
                userId = parsed;
                UserState.UserId = parsed;
            }
        }

        if (!userId.HasValue || UserState.UserType == 5)
            return;

        _countUserId = userId;

        try
        {
            await ChatService.LoadOpenTicketCount(userId.Value);

            // Keep the count fresh — one subscription, disposed with the layout
            _ticketUpdateSubscription ??= ChatService.HubConnection?.On("ReceiveTicketUpdate", async () =>
            {
                if (_countUserId.HasValue)
                    await ChatService.LoadOpenTicketCount(_countUserId.Value);
            });
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Open ticket count failed: {ex.Message}");
        }
    }

    public void Dispose()
    {
        TitleService.OnTitleChanged -= HandleTitleChanged;
        UserState.OnChange -= HandleUserStateChanged;
        SessionService.OnSessionExpired -= HandleSessionExpired;
        ChatService.OnOpenTicketCountChanged -= HandleOpenTicketCountChanged;
        Navigation.LocationChanged -= HandleLocationChanged;
        _ticketUpdateSubscription?.Dispose();
    }

    // =============================
    // EVENT HANDLERS
    // =============================
    private void HandleTitleChanged(string title)
    {
        PageTitle = title;
        InvokeAsync(StateHasChanged);
    }

    private void HandleUserStateChanged() => InvokeAsync(StateHasChanged);

    private void HandleOpenTicketCountChanged(int count)
    {
        _openTicketCount = count;
        InvokeAsync(StateHasChanged);
    }

    private void HandleLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        // Close overlays on navigation and refresh the active item
        _drawerOpen = false;
        _userMenuOpen = false;
        InvokeAsync(StateHasChanged);
    }

    private async void HandleSessionExpired()
    {
        await InvokeAsync(() =>
        {
            _showSessionExpired = true;
            StateHasChanged();
        });
    }

    private void OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
        {
            _drawerOpen = false;
            _userMenuOpen = false;
        }
    }

    // =============================
    // NAV STATE
    // =============================
    private void OpenDrawer()
    {
        _drawerOpen = true;
        _userMenuOpen = false;
        _focusSidebar = true;
    }

    private void CloseDrawer() => _drawerOpen = false;

    private async Task ToggleCollapse()
    {
        _navCollapsed = !_navCollapsed;
        try
        {
            await LocalStorage.SetItemAsync(CollapsedStorageKey, _navCollapsed);
        }
        catch
        {
            // Not persisted — still works for this session
        }
    }

    private void ToggleUserMenu() => _userMenuOpen = !_userMenuOpen;
    private void CloseUserMenu() => _userMenuOpen = false;

    // =============================
    // ACCOUNT
    // =============================
    private string? OwnToken =>
        UserState.UserId.HasValue ? Uri.EscapeDataString(LinkService.Protect(UserState.UserId.Value.ToString())) : null;

    private void NavigateAccount()
    {
        _userMenuOpen = false;
        if (OwnToken is string token)
            Navigation.NavigateTo($"/user-registers/{token}");
    }

    private void NavigateChangePassword()
    {
        _userMenuOpen = false;
        if (OwnToken is string token)
            Navigation.NavigateTo($"/change-password/{token}", true);
    }

    private async Task NavigateToLogout()
    {
        _userMenuOpen = false;

        try
        {
            var dialog = await DialogService.ShowConfirmationAsync("Are you sure you want to log out?", "Log out", "Cancel", "Log out");
            var result = await dialog.Result;
            if (result.Cancelled) return;

            var userId = UserState?.UserId;
            if (userId.HasValue)
            {
                try
                {
                    // 🟢 Notify chat service user is offline, then the backend
                    if (ChatService != null)
                        await ChatService.SetUserOfflineAsync(userId.Value);

                    var logoutCommand = new LogoutCommand { UserId = userId.Value };
                    var response = await Http.PostAsJsonAsync($"{AppConfig.ChatUrl}Auth/Logout/logout", logoutCommand);
                    Console.WriteLine($"Logout API: {response.StatusCode}");
                }
                catch (Exception ex)
                {
                    Console.WriteLine($"Logout service error: {ex.Message}");
                }
            }

            // 🧹 Clear both session & local storage
            await SessionStorage.ClearAsync();
            await LocalStorage.ClearAsync();

            if (UserState != null)
            {
                UserState.UserId = null;
                UserState.Username = null;
                UserState.UserType = 0;
            }

            if (AuthStateProvider is CustomAuthStateProvider provider)
                provider.NotifyUserLogout();

            if (ChatService != null)
                await ChatService.DisposeAsync();

            Navigation.NavigateTo("/", forceLoad: true);
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"Logout failed: {ex.Message}");
            await DialogService.ShowErrorAsync("Logout failed. Please try again later.");
        }
    }

    private static string Initials(string? name)
    {
        var parts = (name ?? string.Empty).Split(new[] { ' ', '.', '_' }, StringSplitOptions.RemoveEmptyEntries);
        return parts.Length switch
        {
            0 => "?",
            1 => parts[0][..1].ToUpperInvariant(),
            _ => $"{parts[0][0]}{parts[^1][0]}".ToUpperInvariant()
        };
    }
}
