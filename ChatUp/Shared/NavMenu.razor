@using ChatUp.Services
@inject ChatUp.Services.LinkService LinkService
@inject UserState UserState

<nav class="nv @(Collapsed ? "is-collapsed" : "")" aria-label="Main navigation">
    <div class="nv-brand">
        @if (Collapsed)
        {
            <span class="nv-mark" title="Odecci Support"><i class="fa-solid fa-headset"></i></span>
        }
        else
        {
            <img src="/images/odeccilogo.svg" alt="Odecci" class="nv-logo" />
        }
    </div>

    <div class="nv-scroll">
        @foreach (var section in Sections)
        {
            @if (!Collapsed)
            {
                <div class="nv-section">@section.Key</div>
            }
            else
            {
                <div class="nv-divider"></div>
            }

            <ul class="nv-list">
                @foreach (var item in section)
                {
                    var isActive = item.Key == ActiveKey;
                    var url = UrlFor(item);
                    <li @key="item.Key">
                        <a href="@(url ?? "#")"
                           class="nv-link @(isActive ? "is-active" : "")"
                           aria-current="@(isActive ? "page" : null)"
                           title="@(Collapsed ? item.Label : null)"
                           @onclick="OnNavigate">
                            <span class="nv-icon"><i class="@item.Icon"></i></span>
                            <span class="nv-label">@item.Label</span>
                            @if (item.Key == "inbox" && OpenTicketCount > 0)
                            {
                                <span class="nv-badge" title="@OpenTicketCount open tickets">@(OpenTicketCount > 99 ? "99+" : OpenTicketCount.ToString())</span>
                            }
                        </a>
                    </li>
                }
            </ul>
        }
    </div>

    <div class="nv-footer">
        <div class="nv-user" title="@(Collapsed ? UserState.Username : null)">
            <span class="nv-avatar">
                @if (!string.IsNullOrEmpty(UserState.AvatarUrl))
                {
                    <img src="@UserState.AvatarUrl" alt="" />
                }
                else
                {
                    @Initials(UserState.Username)
                }
                <span class="nv-presence"></span>
            </span>
            <span class="nv-user-text">
                <strong>@UserState.Username</strong>
                <small>@NavCatalog.RoleLabel(UserState.UserType)</small>
            </span>
        </div>

        <div class="nv-footer-actions">
            <button class="nv-footer-btn nv-collapse-btn" title="@(Collapsed ? "Expand sidebar" : "Collapse sidebar")" @onclick="OnToggleCollapse">
                <i class="fa-solid @(Collapsed ? "fa-angles-right" : "fa-angles-left")"></i>
            </button>
            <button class="nv-footer-btn is-danger" title="Log out" @onclick="OnLogout">
                <i class="fa-solid fa-right-from-bracket"></i>
                <span class="nv-label">Log out</span>
            </button>
        </div>
    </div>
</nav>

@code {
    [Parameter] public bool Collapsed { get; set; }
    [Parameter] public string? ActiveKey { get; set; }
    [Parameter] public int OpenTicketCount { get; set; }
    [Parameter] public EventCallback OnNavigate { get; set; }
    [Parameter] public EventCallback OnLogout { get; set; }
    [Parameter] public EventCallback OnToggleCollapse { get; set; }

    private IEnumerable<IGrouping<string, NavItem>> Sections =>
        NavCatalog.VisibleFor(UserState.UserType).GroupBy(i => i.Section);

    // Encrypted links are built once per user, not on every render
    private readonly Dictionary<string, string?> _urls = new();
    private int? _urlsForUser;

    private string? UrlFor(NavItem item)
    {
        if (_urlsForUser != UserState.UserId)
        {
            _urls.Clear();
            _urlsForUser = UserState.UserId;
        }

        if (!_urls.TryGetValue(item.Key, out var url))
            _urls[item.Key] = url = NavCatalog.BuildUrl(item, UserState.UserId, LinkService);

        return url;
    }

    private static string Initials(string? name)
    {
        var parts = (name ?? string.Empty).Split(new[] { ' ', '.', '_' }, StringSplitOptions.RemoveEmptyEntries);
        return parts.Length switch
        {
            0 => "?",
            1 => parts[0][..1].ToUpperInvariant(),
            _ => $"{parts[0][0]}{parts[^1][0]}".ToUpperInvariant()
        };
    }
}
