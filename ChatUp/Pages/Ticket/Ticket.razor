@using ChatUp.Services
@inject HttpClient Http
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthStateProvider
@inject UserState UserState
@inject IDialogService DialogService
@inject Blazored.SessionStorage.ISessionStorageService SessionStorage
@inject Blazored.LocalStorage.ILocalStorageService LocalStorage
@inject ChatUp.Services.ChatService ChatService
@inject ChatUp.Services.EmailService EmailService
@using Chat
<style>
    .priority-critical {
        background-color: #212529 !important;
        color: #fff !important;
        border-color: #212529 !important;
    }

    .priority-high {
        background-color: #dc3545 !important;
        color: #fff !important;
        border-color: #dc3545 !important;
    }

    .priority-medium {
        background-color: #ffc107 !important;
        color: #000 !important;
        border-color: #ffc107 !important;
    }

    .priority-low {
        background-color: #198754 !important;
        color: #fff !important;
        border-color: #198754 !important;
    }
</style>
@if (isSendingEmail)
{
    <div class="email-overlay">
        <div class="email-spinner">
            <img src="images/email-sendings.gif" alt="Sending Email..." class="email-gif" />
            <p>Sending emails... Please wait</p>
        </div>
    </div>
}
<h3 class="mb-4 text-primary fw-bold">
    <i class="bi bi-ticket-detailed me-2"></i> Ticket Details
</h3>

@if (ticket == null)
{
    <div class="text-center text-muted py-5">
        <div class="spinner-border text-primary mb-3" role="status"></div>
        <p><em>Loading ticket details...</em></p>
    </div>
}
else
{
    <div class="main-ticket-container">
    <div class="card border-0 shadow-lg rounded-4 p-3 p-md-4 mb-4 bg-light">
        <div class="row g-3">

            <!-- LEFT COLUMN -->
            <div class="col-12 col-lg-6">
                <h6 class="fw-bold text-dark mb-2">📄 Ticket Information</h6>

                <div class="small"><strong>Ticket No:</strong> @ticket.TicketNo</div>
                <div class="small"><strong>Date:</strong> @ticket.DateReceived.ToString("g")</div>
                <div class="small"><strong>Title:</strong> @ticket.IssueTitle</div>

                    <div class="mt-1 small">
                        <strong>Priority:</strong>

                        @if (UserState.UserType == 3)
                        {
                            <!-- 🔒 Read-only -->
                            <span class="@GetPriorityClass(selectedPriority)">
                                @selectedPriority
                            </span>
                        }
                        else
                        {
                            <select class="form-select form-select-sm d-inline-block w-auto ms-2 @GetPriorityDropdownClass(selectedPriority)"
                                    @onchange="OnPriorityChangedManual">

                                @foreach (var priority in Enum.GetValues<TicketPriority>())
                                {
                                    <option value="@priority" selected="@(priority == selectedPriority)">
                                        @priority
                                    </option>
                                }
                            </select>
                        }
                    </div>

                <div class="small"><strong>Due:</strong> @ticket.DueDate?.ToString("g")</div>
            </div>

            <!-- RIGHT COLUMN -->
            <div class="col-12 col-lg-6">
                <h6 class="fw-bold text-dark mb-2">👤 Related Details</h6>

                <div class="small"><strong>Requested By:</strong> @ticket.RequestedByName</div>
                <div class="small"><strong>Client:</strong> @ticket.ClientName</div>
                <div class="small"><strong>Project:</strong> @ticket.ProjectName</div>

                <div class="mt-1 small">
                    <strong>SLA:</strong>
                    @if (ticket.IsBreached)
                    {
                        <span class="badge bg-danger">Breached</span>
                    }
                    else
                    {
                        <span class="badge bg-success">On Track</span>
                    }
                </div>
            </div>

            <!-- CONCERN -->
            <div class="col-12">
                <details open class="concern-details">
                    <summary class="fw-semibold mb-2">📝 Concern</summary>
                    <div class="formatted-text small">
                        @ticket.Description
                    </div>
                </details>
            </div>
        </div>

        @if (UserState.UserType != 3)
        {
                <div class="row g-2 align-items-end">

                    <!-- STATUS -->
                    <div class="col-5 col-md-2">
                        <label class="form-label small mb-1">Status</label>
                        <select class="form-select form-select-sm"
                                value="@selectedStatus"
                                @onchange="OnStatusChanged">
                            @foreach (var status in Enum.GetValues<TicketStatus>())
                            {
                                <option value="@status">@status</option>
                            }
                        </select>
                    </div>

                    <!-- EMAIL TOGGLE -->
                    <div class="col-12 col-md-6">
                        @* <label class="form-label small mb-1">Email Notification</label> *@

                        <div class="form-check form-switch d-flex align-items-center"
                             style="height: 31px;">
                            <!-- match select height -->

                            <input class="form-check-input me-2"
                                   type="checkbox"
                                   @bind="sendEmail">

                            <label class="form-check-label small m-0">
                                Email: <strong>@(sendEmail ? "Yes" : "No")</strong>
                            </label>
                        </div>
                    </div>

                    <!-- REMARKS -->
                    <div class="col-12">
                        <label class="form-label small">Remarks</label>
                        <textarea class="form-control form-control-sm"
                                  rows="3"
                                  @bind="remarks"></textarea>
                    </div>

                </div>

            <!-- ACTION BUTTONS -->
            <div class="d-flex flex-wrap gap-2 mt-3">
                <button class="btn btn-secondary btn-sm" @onclick="GoBack">
                    ← Back
                </button>

                <button class="btn btn-primary btn-sm" @onclick="SubmitChanges">
                    Save
                </button>

                <button class="btn btn-outline-primary btn-sm"
                        @onclick="() => OpenInbox(ticket.TicketNo)">
                    Inbox
                </button>
            </div>
        }
    </div>

    <!-- HISTORY -->
    <div class="card border-0 shadow-lg rounded-4 p-3 p-md-4 bg-white">
        <h6 class="fw-bold mb-3">🕒 History</h6>

        <div class="history-container">
            @if (history == null)
            {
                <div class="text-center small text-muted">Loading...</div>
            }
            else if (!history.Any())
            {
                <div class="text-center small text-muted">No records</div>
            }
            else
            {
                @foreach (var h in history.OrderByDescending(x => x.UpdatedAt))
                {
                    <div class="history-item">
                        <div class="fw-semibold small">@h.UpdatedByName</div>
                        <div class="text-muted small">
                            @h.UpdatedAt.ToLocalTime().ToString("g")
                        </div>

                        <div class="small mt-1">
                            <span class="badge bg-secondary">@h.OldStatus</span>
                            →
                            <span class="badge bg-success">@h.NewStatus</span>
                        </div>

                        @if (!string.IsNullOrWhiteSpace(h.Remarks))
                        {
                            <div class="small text-muted mt-1">
                                <em>@h.Remarks</em>
                            </div>
                        }
                    </div>
                }
            }
        </div>
    </div>
    </div>
}
@code {
    private int? sessionUserType;
    private bool isUserLoaded = false;
    private bool sendEmail = false;
    private TicketPriority selectedPriority;
    [Parameter] public int TicketId { get; set; }
