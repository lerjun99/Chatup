@page "/tickets/{EncryptedId}"
@using System.Globalization
@using ChatUp.Application.Auth.Commands
@using ChatUp.Application.Features.Projects.DTOs
@using ChatUp.Application.Features.Ticket.DTOs
@using ChatUp.Domain.Entities
@using ChatUp.Services
@inject HttpClient Http
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthStateProvider
@inject UserState UserState
@inject IDialogService DialogService
@inject Blazored.SessionStorage.ISessionStorageService SessionStorage
@inject Blazored.LocalStorage.ILocalStorageService LocalStorage
@inject ChatUp.Services.ChatService ChatService
@inject ChatUp.Services.EmailService EmailService
@inject SlaService SlaService
@using Chat
<link href="css/tickets.css" rel="stylesheet" />

@if (isSendingEmail)
{
    <div class="email-overlay">
        <div class="email-spinner">
            <img src="images/email-sendings.gif" alt="Sending Email..." class="email-gif" />
            <p>Sending emails... Please wait</p>
        </div>
    </div>
}

<div class="tk tk-detail">
    @if (_notFound)
    {
        <div class="tk-card tk-empty">
            <i class="fa-regular fa-circle-question"></i>
            <p>This ticket couldn't be found.</p>
            <small class="tk-muted">It may have been removed, or you may not have access to it.</small>
            <button class="tk-btn tk-btn-ghost" @onclick="GoBack"><i class="fa-solid fa-arrow-left"></i> Back to tickets</button>
        </div>
    }
    else if (ticket == null)
    {
        <!-- ============ SKELETON ============ -->
        <div class="tk-skel tk-skel-hero"></div>
        <div class="tk-detail-grid">
            <div class="tk-detail-main">
                <div class="tk-card tk-skel" style="height:220px"></div>
                <div class="tk-card tk-skel" style="height:260px"></div>
            </div>
            <div class="tk-detail-side">
                <div class="tk-card tk-skel" style="height:260px"></div>
            </div>
        </div>
    }
    else
    {
        <!-- ============ HEADER ============ -->
        <header class="tk-hero tk-hero-detail">
            <div class="tk-hero-main">
                <button class="tk-back" @onclick="GoBack" title="Back to tickets">
                    <i class="fa-solid fa-arrow-left"></i>
                </button>
                <div class="tk-hero-text">
                    <div class="tk-eyebrow">
                        <span class="tk-mono">@ticket.TicketNo</span>
                        <span>· received @RelativeTime(ticket.DateReceived)</span>
                    </div>
                    <h1>@ticket.IssueTitle</h1>
                    <div class="tk-hero-chips">
                        <span class="tk-chip tk-chip-glass tk-st-@StatusCss(ticket.Status.ToString())"><span class="tk-dot"></span>@StatusLabel(ticket.Status.ToString())</span>
                        <span class="tk-prio tk-prio-glass tk-prio-@ticket.Priority.ToString().ToLowerInvariant()"><i class="@PriorityIcon(ticket.Priority)"></i> @ticket.Priority priority</span>
                    </div>
                </div>
            </div>
            @if (UserState.UserType != 3)
            {
                <button class="tk-btn tk-btn-glass" @onclick="() => OpenInbox(ticket.TicketNo)">
                    <i class="fa-regular fa-comments"></i> Open inbox
                </button>
            }
        </header>

        @if (_saveSuccess != null)
        {
            <div class="tk-alert tk-alert-ok" role="status">
                <i class="fa-solid fa-circle-check"></i>
                <span>@_saveSuccess</span>
                <button class="tk-icon-btn" title="Dismiss" @onclick="() => _saveSuccess = null"><i class="fa-solid fa-xmark"></i></button>
            </div>
        }
        @if (_saveError != null)
        {
            <div class="tk-alert tk-alert-error" role="alert">
                <i class="fa-solid fa-circle-exclamation"></i>
                <span>@_saveError</span>
                <button class="tk-icon-btn" title="Dismiss" @onclick="() => _saveError = null"><i class="fa-solid fa-xmark"></i></button>
            </div>
        }

        <div class="tk-detail-grid">
            <div class="tk-detail-main">

                <!-- ============ DETAILS ============ -->
                <section class="tk-card">
                    <h2 class="tk-card-title"><i class="fa-solid fa-circle-info"></i> Details</h2>
                    <dl class="tk-facts">
                        <div>
                            <dt>Requested by</dt>
                            <dd>@Fallback(ticket.RequestedByName)</dd>
                        </div>
                        <div>
                            <dt>Client</dt>
                            <dd>@Fallback(ticket.ClientName)</dd>
                        </div>
                        <div>
                            <dt>Project</dt>
                            <dd>@Fallback(ticket.ProjectName, "No project")</dd>
                        </div>
                        <div>
                            <dt>Assigned to</dt>
                            <dd>@Fallback(ticket.SupportedByName, "Unassigned")</dd>
                        </div>
                        <div>
                            <dt>Received</dt>
                            <dd>@ticket.DateReceived.ToLocalTime().ToString("MMM d, yyyy h:mm tt")</dd>
                        </div>
                        <div>
                            <dt>Due</dt>
                            <dd>@(ticket.DueDate.HasValue ? ticket.DueDate.Value.ToLocalTime().ToString("MMM d, yyyy h:mm tt") : "—")</dd>
                        </div>
                    </dl>
                </section>

                <!-- ============ CONCERN ============ -->
                <section class="tk-card">
                    <details open class="tk-concern">
                        <summary class="tk-card-title"><i class="fa-regular fa-file-lines"></i> Concern <i class="fa-solid fa-chevron-down tk-summary-caret"></i></summary>
                        <div class="tk-concern-body">
                            @if (string.IsNullOrWhiteSpace(ticket.Description))
                            {
                                <span class="tk-muted">No description provided.</span>
                            }
                            else
                            {
                                @ticket.Description
                            }
                        </div>
                    </details>
                </section>

                <!-- ============ UPDATE ============ -->
                @if (UserState.UserType != 3)
                {
                    <section class="tk-card tk-update">
                        <div class="tk-card-head">
                            <h2 class="tk-card-title"><i class="fa-solid fa-pen-to-square"></i> Update ticket</h2>
                            @if (IsDirty)
                            {
                                <span class="tk-dirty"><span class="tk-dot"></span> Unsaved changes</span>
                            }
                        </div>

                        <div class="tk-form-grid">
                            <label class="tk-field">
                                <span>Status</span>
                                <select class="tk-select" value="@selectedStatus" @onchange="OnStatusChanged">
                                    @foreach (var status in Enum.GetValues<TicketStatus>())
                                    {
                                        <option value="@status">@StatusLabel(status.ToString())</option>
                                    }
                                </select>
                            </label>

                            <label class="tk-field">
                                <span>Priority</span>
                                <select class="tk-select tk-select-prio tk-prio-@selectedPriority.ToString().ToLowerInvariant()" @onchange="OnPriorityChangedManual">
                                    @foreach (var priority in Enum.GetValues<TicketPriority>())
                                    {
                                        <option value="@priority" selected="@(priority == selectedPriority)">@priority</option>
                                    }
                                </select>
                                @if (selectedPriority != ticket.Priority)
                                {
                                    <small class="tk-hint"><i class="fa-solid fa-circle-info"></i> Changing priority recalculates the SLA due date.</small>
                                }
                            </label>

                            <label class="tk-field">
                                <span>Project</span>
                                <select class="tk-select" @bind="selectedProjectId">
                                    <option value="">— Select project —</option>
                                    @foreach (var project in filteredProjects)
                                    {
                                        <option value="@project.Id">@project.Title</option>
                                    }
                                </select>
                            </label>

                            <label class="tk-field tk-field-wide">
                                <span>Remarks</span>
                                <textarea class="tk-textarea" rows="4" placeholder="Add context for this update…" @bind="remarks" @bind:event="oninput"></textarea>
                            </label>
                        </div>

                        <div class="tk-actions">
                            <label class="tk-switch">
                                <input type="checkbox" @bind="sendEmail" />
                                <span class="tk-switch-track"><span></span></span>
                                <span class="tk-switch-label">
                                    Email the requester
                                    @if (sendEmail && !string.IsNullOrWhiteSpace(ticket.RequesterEmail))
                                    {
                                        <small class="tk-muted">(@ticket.RequesterEmail)</small>
                                    }
                                </span>
                            </label>

                            <div class="tk-actions-buttons">
                                @if (IsDirty)
                                {
                                    <button class="tk-btn tk-btn-ghost" @onclick="DiscardChanges" disabled="@_saving">Discard</button>
                                }
                                <button class="tk-btn tk-btn-primary" @onclick="SubmitChanges" disabled="@_saving">
                                    @if (_saving)
                                    {
                                        <i class="fa-solid fa-circle-notch fa-spin"></i>
                                        <span>Saving…</span>
                                    }
                                    else
                                    {
                                        <i class="fa-solid fa-floppy-disk"></i>
                                        <span>Save changes</span>
                                    }
                                </button>
                            </div>
                        </div>
                    </section>
                }
            </div>

            <aside class="tk-detail-side">
                <!-- ============ SLA ============ -->
                <section class="tk-card">
                    <h2 class="tk-card-title"><i class="fa-solid fa-stopwatch"></i> Service level</h2>
                    <SlaTimer Variant="full"
                              Received="ticket.DateReceived"
                              Due="ticket.DueDate"
                              Status="@ticket.Status.ToString()"
                              IsBreached="ticket.IsBreached"
                              Calendar="_slaCalendar" />
                </section>

                <!-- ============ HISTORY ============ -->
                <section class="tk-card">
                    <h2 class="tk-card-title"><i class="fa-solid fa-clock-rotate-left"></i> History</h2>

                    @if (history == null)
                    {
                        for (var i = 0; i < 3; i++)
                        {
                            <div class="tk-skel tk-skel-row"></div>
                        }
                    }
                    else if (!history.Any())
                    {
                        <div class="tk-empty tk-empty-sm">
                            <i class="fa-regular fa-clock"></i>
                            <p>No updates yet.</p>
                        </div>
                    }
                    else
                    {
                        <ol class="tk-timeline">
                            @foreach (var h in history)
                            {
                                <li @key="h.Id">
                                    <span class="tk-avatar">@Initials(h.UpdatedByName)</span>
                                    <div class="tk-timeline-body">
                                        <div class="tk-timeline-head">
                                            <span class="tk-strong">@Fallback(h.UpdatedByName, "System")</span>
                                            <time class="tk-muted tk-small" title="@h.UpdatedAt.ToLocalTime().ToString("MMM d, yyyy h:mm tt")">@RelativeTime(h.UpdatedAt)</time>
                                        </div>

                                        @if (!string.IsNullOrWhiteSpace(h.OldStatus) && !string.IsNullOrWhiteSpace(h.NewStatus))
                                        {
                                            <div class="tk-change">
                                                <span class="tk-chip tk-chip-sm tk-st-@StatusCss(h.OldStatus)"><span class="tk-dot"></span>@StatusLabel(h.OldStatus)</span>
                                                <i class="fa-solid fa-arrow-right-long tk-muted"></i>
                                                <span class="tk-chip tk-chip-sm tk-st-@StatusCss(h.NewStatus)"><span class="tk-dot"></span>@StatusLabel(h.NewStatus)</span>
                                            </div>
                                        }

                                        @if (h.OldProjectId != h.NewProjectId)
                                        {
                                            <div class="tk-change">
                                                <i class="fa-solid fa-folder-open tk-muted"></i>
                                                <span class="tk-tag">@Fallback(h.OldProjectName, "No project")</span>
                                                <i class="fa-solid fa-arrow-right-long tk-muted"></i>
                                                <span class="tk-tag tk-tag-accent">@Fallback(h.NewProjectName, "No project")</span>
                                            </div>
                                        }

                                        @if (!string.IsNullOrWhiteSpace(h.Remarks))
                                        {
                                            <blockquote class="tk-remark">@h.Remarks</blockquote>
                                        }
                                    </div>
                                </li>
                            }
                        </ol>
                    }
                </section>
            </aside>
        </div>
    }
</div>

@code {
    private int? sessionUserType;
    private bool isUserLoaded = false;
    private bool sendEmail = false;
    private TicketPriority selectedPriority;
    [Parameter] public int TicketId { get; set; }
    private TicketDto? ticket;
    private TicketStatus selectedStatus;
    private List<TicketHistoryDto>? history;
    private string? remarks;
    private bool isSendingEmail = false;
    [Parameter] public string EncryptedId { get; set; } = string.Empty;
    [Inject] public LinkService LinkService { get; set; } = default!;
    private bool sessionChecked = false;
    [Parameter] public EventCallback OnNavigate { get; set; }
    private List<ProjectDto> allProjects = new();
    private List<ProjectDto> filteredProjects = new();
    private int? selectedProjectId;

    private BusinessCalendar? _slaCalendar;
    private bool _notFound;
    private bool _saving;
    private string? _saveSuccess;
    private string? _saveError;

    private bool IsDirty =>
        ticket != null &&
        (selectedStatus != ticket.Status ||
         selectedPriority != ticket.Priority ||
         selectedProjectId != ticket.ProjectId ||
         (remarks ?? string.Empty) != (ticket.Concern ?? string.Empty));

    /* -------- nav helpers -------- */
    private void Navigate(string url)
    {
        Navigation.NavigateTo(url, forceLoad: false);
        if (OnNavigate.HasDelegate)
            OnNavigate.InvokeAsync();
    }

    private void OpenInbox(string ticketNo)
    {
        if (UserState.UserId.HasValue && ticket != null)
        {
            // 🔐 Encrypt user ID
            var token = LinkService.Protect(UserState.UserId.Value.ToString());
            var encodedToken = Uri.EscapeDataString(token);
            Navigation.NavigateTo($"/inbox/ticket/{encodedToken}/{ticketNo}/{ticket.Status}");
        }
    }

    private async Task LoadProjects()
    {
        try
        {
            if (!UserState.UserId.HasValue)
                return;
            var url = $"{AppConfig.ChatUrl}Projects/GetProjectsByUser/by-user/{UserState.UserId.Value}";
            var response = await Http.GetFromJsonAsync<List<ProjectDto>>(url);

            if (response != null)
            {
                allProjects = response;
                filteredProjects = allProjects;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"❌ Error loading projects: {ex.Message}");
        }
    }

    private async Task LoadSlaCalendar()
    {
        _slaCalendar = await SlaService.GetCalendarAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || sessionChecked)
            return;

        sessionChecked = true;

        // 🔐 Validate route param
        var decrypted = LinkService.Unprotect(Uri.UnescapeDataString(EncryptedId));

        if (string.IsNullOrEmpty(decrypted) || !int.TryParse(decrypted, out var ticketId))
        {
            Navigation.NavigateTo("/unauthorized", true);
            return;
        }

        TicketId = ticketId;

        // 🔐 Validate session BEFORE loading data
        var sessionOk = await LoadSessionUser();
        if (!sessionOk)
        {
            await PerformLogoutAsync(notifyBackend: false);
            return;
        }

        // ✅ Load data in parallel
        await Task.WhenAll(
            LoadProjects(),
            LoadTicket(),
            LoadHistory(),
            LoadSlaCalendar()
        );

        // ✅ Set selected project AFTER both loaded
        if (ticket != null)
        {
            selectedProjectId = ticket.ProjectId;

            // 🔧 Ensure project exists in dropdown
            if (ticket.ProjectId.HasValue && !filteredProjects.Any(p => p.Id == ticket.ProjectId))
            {
                filteredProjects.Insert(0, new ProjectDto
                {
                    Id = ticket.ProjectId.Value,
                    Title = ticket.ProjectName
                });
            }
        }
        StateHasChanged();
    }

    private async Task PerformLogoutAsync(bool notifyBackend = true)
    {
        try
        {
            if (notifyBackend && UserState.UserId.HasValue)
            {
                if (ChatService != null)
                    await ChatService.SetUserOfflineAsync(UserState.UserId.Value);

                var logoutCommand = new LogoutCommand { UserId = UserState.UserId.Value };
                await Http.PostAsJsonAsync(
                    AppConfig.ChatUrl + "Auth/Logout/logout",
                    logoutCommand
                );
            }

            await SessionStorage.ClearAsync();
            await LocalStorage.ClearAsync();

            UserState.UserId = null;
            UserState.Username = null;
            UserState.UserType = 0;

            if (AuthStateProvider is CustomAuthStateProvider customProvider)
                customProvider.NotifyUserLogout();

            if (ChatService != null)
                await ChatService.DisposeAsync();

            Navigation.NavigateTo("/", forceLoad: true);
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"Forced logout failed: {ex.Message}");
            Navigation.NavigateTo("/", forceLoad: true);
        }
    }

    private async Task<bool> LoadSessionUser()
    {
        try
        {
            string? encUserType = null;

            if (await SessionStorage.ContainKeyAsync("UserType"))
                encUserType = await SessionStorage.GetItemAsync<string>("UserType");
            else if (await LocalStorage.ContainKeyAsync("UserType"))
                encUserType = await LocalStorage.GetItemAsync<string>("UserType");

            if (string.IsNullOrWhiteSpace(encUserType))
                return false;

            var decrypted = LinkService.Unprotect(Uri.UnescapeDataString(encUserType));

            if (!int.TryParse(decrypted, out var userType))
                return false;

            UserState.UserType = userType;
            sessionUserType = userType;
            return true;
        }
        catch
        {
            return false;
        }
    }

    private void OnStatusChanged(ChangeEventArgs e)
    {
        if (Enum.TryParse<TicketStatus>(e.Value?.ToString(), out var newStatus))
            selectedStatus = newStatus;
    }

    private void OnPriorityChangedManual(ChangeEventArgs e)
    {
        if (Enum.TryParse<TicketPriority>(e.Value?.ToString(), out var newPriority))
            selectedPriority = newPriority;
    }

    private void DiscardChanges()
    {
        if (ticket == null) return;

        selectedStatus = ticket.Status;
        selectedPriority = ticket.Priority;
        selectedProjectId = ticket.ProjectId;
        remarks = ticket.Concern ?? string.Empty;
    }

    private async Task SubmitChanges()
    {
        if (ticket == null || _saving) return;

        _saving = true;
        _saveSuccess = null;
        _saveError = null;

        try
        {
            var payload = new
            {
                TicketId = ticket.Id,
                NewStatus = selectedStatus,
                NewPriority = selectedPriority,
                UpdatedBy = UserState.UserId,
                UpdatedAt = DateTime.UtcNow,
                ProjectId = selectedProjectId,
                Remarks = remarks
            };

            var response = await Http.PutAsJsonAsync($"{AppConfig.ChatUrl}Tickets/UpdateStatus", payload);

            if (!response.IsSuccessStatusCode)
            {
                _saveError = $"Couldn't save your changes ({(int)response.StatusCode}). Please try again.";
                return;
            }

            _saveSuccess = "Changes saved.";

            // Ticket and history are independent — refresh both at once
            await Task.WhenAll(LoadTicket(), LoadHistory());

            if (sendEmail)
                await SendUpdateEmailAsync();

            if (ChatService != null)
                await ChatService.NotifyTicketUpdateAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"❌ Error saving ticket: {ex.Message}");
            _saveError = "Couldn't save your changes. Check your connection and try again.";
        }
        finally
        {
            _saving = false;
            isSendingEmail = false; // never leave the overlay stuck
            StateHasChanged();
        }
    }

    private async Task SendUpdateEmailAsync()
    {
        if (ticket == null) return;

        if (string.IsNullOrWhiteSpace(ticket.RequesterEmail))
        {
            _saveSuccess = "Changes saved. No email was sent — the requester has no email address.";
            return;
        }

        isSendingEmail = true;
        StateHasChanged();

        string subject = $"[Ticket Update] {ticket.IssueTitle} - Status Changed to {selectedStatus}";
        string body = $@"
                            <html>
                              <head>
                                <meta charset='UTF-8'>
                              </head>
                              <body style='margin:0; padding:20px; font-family:Arial,sans-serif; background-color:#f9f9f9; color:#333;'>
                                <table width='100%' cellpadding='0' cellspacing='0' border='0' style='max-width:600px; margin:auto; background:#ffffff; border-collapse:collapse;'>
                                  <tr>
                                    <td style='padding:24px;'>
                                      <h2 style='color:#2a6ebb; margin:0 0 16px 0;'>Ticket Update Notification</h2>
                                      <p>Dear <strong>{ticket.RequestedByName}</strong>,</p>
                                      <p>Your ticket has been updated with the latest status.</p>
                                      <table width='100%' cellpadding='6' cellspacing='0' border='0' style='border-collapse:collapse; margin-top:10px;'>
                                        <tr style='background-color:#f3f6fa;'><td style='width:40%; font-weight:bold;'>Ticket Number:</td><td>{ticket.TicketNo}</td></tr>
                                        <tr><td style='font-weight:bold;'>Issue Title:</td><td>{ticket.IssueTitle}</td></tr>
                                        <tr style='background-color:#f3f6fa;'><td style='font-weight:bold;'>New Status:</td>
                                          <td><span style='padding:4px 10px; border-radius:4px; background-color:#2a6ebb; color:white;'>{selectedStatus}</span></td>
                                        </tr>
                                        <tr><td style='font-weight:bold;'>Remarks:</td><td>{remarks}</td></tr>
                                      </table>
                                      <p style='margin-top:30px; color:#555;'>Best regards,<br/><strong>Odecci Support Team</strong><br/><span style='font-size:12px; color:#888;'>This is an automated message. Please do not reply directly.</span></p>
                                    </td>
                                  </tr>
                                </table>
                              </body>
                            </html>";

        try
        {
            await EmailService.SendEmailAsync(ticket.RequesterEmail, subject, body);
            _saveSuccess = $"Changes saved and the requester was emailed ({ticket.RequesterEmail}).";
        }
        catch (Exception ex)
        {
            Console.WriteLine($"❌ Error sending email: {ex.Message}");
            _saveError = "Changes were saved, but the email notification couldn't be sent.";
        }
        finally
        {
            isSendingEmail = false;
        }
    }

    private async Task LoadTicket()
    {
        try
        {
            ticket = await Http.GetFromJsonAsync<TicketDto>($"{AppConfig.ChatUrl}Tickets/GetById/{TicketId}");

            if (ticket == null)
            {
                _notFound = true;
                return;
            }

            // CURRENT STATE (SOURCE OF TRUTH)
            selectedStatus = ticket.Status;
            selectedPriority = ticket.Priority;
            selectedProjectId = ticket.ProjectId;
            remarks = ticket.Concern ?? string.Empty;
        }
        catch (HttpRequestException ex) when (ex.StatusCode == System.Net.HttpStatusCode.NotFound)
        {
            _notFound = true;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading ticket: {ex.Message}");
            _notFound = ticket == null;
        }
    }

    private async Task LoadHistory()
    {
        try
        {
            var result = await Http.GetFromJsonAsync<List<TicketHistoryDto>>(
                $"{AppConfig.ChatUrl}Tickets/GetHistory/GetHistory/{TicketId}");
            history = result?.OrderByDescending(h => h.UpdatedAt).ToList() ?? new List<TicketHistoryDto>();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading history: {ex.Message}");
            history = new List<TicketHistoryDto>();
        }
    }

    private void GoBack()
    {
        if (UserState.UserId.HasValue)
        {
            // 🔐 Encrypt user ID
            var token = LinkService.Protect(UserState.UserId.Value.ToString());
            var encodedToken = Uri.EscapeDataString(token);
            Navigate($"/ticketlist/{encodedToken}");
        }
    }

    // =============================
    // FORMATTING
    // =============================
    private static string StatusLabel(string? status) => status switch
    {
        "InProgress" => "In progress",
        null or "" => "Unknown",
        _ => status
    };

    private static string StatusCss(string? status) => status switch
    {
        "Open" => "open",
        "InProgress" => "progress",
        "Resolved" => "resolved",
        "Closed" => "closed",
        "Rejected" => "rejected",
        "New" => "new",
        _ => "other"
    };

    private static string PriorityIcon(TicketPriority priority) => priority switch
    {
        TicketPriority.Critical => "fa-solid fa-fire",
        TicketPriority.High => "fa-solid fa-angles-up",
        TicketPriority.Medium => "fa-solid fa-equals",
        TicketPriority.Low => "fa-solid fa-angle-down",
        _ => "fa-regular fa-circle"
    };

    private static string Fallback(string? value, string fallback = "—") =>
        string.IsNullOrWhiteSpace(value) ? fallback : value;

    private static string Initials(string? name)
    {
        var parts = (name ?? string.Empty).Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return parts.Length switch
        {
            0 => "?",
            1 => parts[0][..1].ToUpperInvariant(),
            _ => $"{parts[0][0]}{parts[^1][0]}".ToUpperInvariant()
        };
    }

    private static string RelativeTime(DateTime utc)
    {
        var ago = DateTime.UtcNow - utc;
        if (ago.TotalMinutes < 1) return "just now";
        if (ago.TotalHours < 1) return $"{(int)ago.TotalMinutes}m ago";
        if (ago.TotalDays < 1) return $"{(int)ago.TotalHours}h ago";
        if (ago.TotalDays < 7) return $"{(int)ago.TotalDays}d ago";
        return utc.ToLocalTime().ToString("MMM d, yyyy", CultureInfo.InvariantCulture);
    }
}
