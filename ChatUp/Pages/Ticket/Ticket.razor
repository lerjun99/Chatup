        //         UpdatedBy = UserState.UserId,
        //         UpdatedAt = DateTime.UtcNow,
        //         remarks = remarks
        //     };

        //     try
        //     {
        //         var response = await Http.PutAsJsonAsync($"{AppConfig.ChatUrl}Tickets/UpdateStatus", payload);
        //         if (response.IsSuccessStatusCode)
        //         {
        //             updateMessage = $"✅ Status automatically updated to '{newStatus}'";
        //             await LoadHistory(); // refresh ticket history
        //         }
        //         else
        //         {
        //             updateMessage = "⚠ Failed to update ticket status.";
        //         }
        //     }
        //     catch (Exception ex)
        //     {
        //         updateMessage = $"Error updating status: {ex.Message}";
        //     }

        //     StateHasChanged();
        // }
        if (Enum.TryParse<TicketStatus>(e.Value?.ToString(), out var newStatus))
        {
            selectedStatus = newStatus;
            isModified = true; // Mark that something changed
            StateHasChanged();
        }
    }
    private async Task SubmitChanges()
    {
        if (ticket == null) return;

        try
        {
            var payload = new
            {
                TicketId = ticket.Id,
                NewStatus = selectedStatus,
                NewPriority = selectedPriority,
                UpdatedBy = UserState.UserId,
                UpdatedAt = DateTime.UtcNow,
                Remarks = remarks
            };

            var response = await Http.PutAsJsonAsync($"{AppConfig.ChatUrl}Tickets/UpdateStatus", payload);

            if (response.IsSuccessStatusCode)
            {
                updateMessage = "✅ Changes successfully saved.";
                isModified = false;

                await LoadTicket();
                await LoadHistory();

                // Send email

                StateHasChanged();
                if (sendEmail)
                {
                    isSendingEmail = true;
                    StateHasChanged();
                    string subject = $"[Ticket Update] {ticket.IssueTitle} - Status Changed to {selectedStatus}";
                    string body = $@"
                            <html>
                              <head>
                                <meta charset='UTF-8'>
                              </head>
                              <body style='margin:0; padding:20px; font-family:Arial,sans-serif; background-color:#f9f9f9; color:#333;'>
                                <table width='100%' cellpadding='0' cellspacing='0' border='0' style='max-width:600px; margin:auto; background:#ffffff; border-collapse:collapse;'>
                                  <tr>
                                    <td style='padding:24px;'>
                                      <h2 style='color:#2a6ebb; margin:0 0 16px 0;'>Ticket Update Notification</h2>
                                      <p>Dear <strong>{ticket.RequestedByName}</strong>,</p>
                                      <p>Your ticket has been updated with the latest status.</p>
                                      <table width='100%' cellpadding='6' cellspacing='0' border='0' style='border-collapse:collapse; margin-top:10px;'>
                                        <tr style='background-color:#f3f6fa;'><td style='width:40%; font-weight:bold;'>Ticket Number:</td><td>{ticket.TicketNo}</td></tr>
                                        <tr><td style='font-weight:bold;'>Issue Title:</td><td>{ticket.IssueTitle}</td></tr>
                                        <tr style='background-color:#f3f6fa;'><td style='font-weight:bold;'>New Status:</td>
                                          <td><span style='padding:4px 10px; border-radius:4px; background-color:#2a6ebb; color:white;'>{selectedStatus}</span></td>
                                        </tr>
                                        <tr><td style='font-weight:bold;'>Remarks:</td><td>{remarks}</td></tr>
                                      </table>
                                      <p style='margin-top:30px; color:#555;'>Best regards,<br/><strong>Odecci Support Team</strong><br/><span style='font-size:12px; color:#888;'>This is an automated message. Please do not reply directly.</span></p>
                                    </td>
                                  </tr>
                                </table>
                              </body>
                            </html>";

                    // You can use the actual client email from your ticket DTO
                    await EmailService.SendEmailAsync(ticket.RequesterEmail, subject, body);
                    await DialogService.ShowSuccessAsync("Email notification sent to the client!");
                }
                
                if (ChatService != null)
                {
                    await ChatService.NotifyTicketUpdateAsync();
                }
                isSendingEmail = false; // hide overlay
            }
            else
            {
                updateMessage = "⚠ Failed to save one or more updates.";
            }
        }
        catch (Exception ex)
        {
            updateMessage = $"Error: {ex.Message}";
        }

        StateHasChanged();
    }
    private async Task LoadTicket()
    {
        try
        {
            var url = Navigation.ToAbsoluteUri($"{AppConfig.ChatUrl}Tickets/GetById/{TicketId}");
            ticket = await Http.GetFromJsonAsync<TicketDto>(url);
            
            if (ticket == null)
            {
                Navigation.NavigateTo("/ticketlist");
                return;
            }

            // ✅ Set current status
           selectedStatus = ticket.Status;
           selectedPriority = ticket.Priority; // initialize dropdown

            // ✅ Load history next
            await LoadHistory();

            // ✅ Set remarks value
            if (history != null && history.Any())
            {
                // Get the latest remark from ticket history
                remarks = history.OrderByDescending(h => h.UpdatedAt)
                                 .FirstOrDefault()?.Remarks ?? string.Empty;
            }
            else
            {
                // Fallback: use remark stored directly in the ticket (if applicable)
                remarks = ticket.Concern ?? string.Empty;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading ticket: {ex.Message}");
        }
    }

    private async Task LoadHistory()
    {
        try
        {
      
            var url = Navigation.ToAbsoluteUri($"{AppConfig.ChatUrl}Tickets/GetHistory/GetHistory/{TicketId}");
            history = await Http.GetFromJsonAsync<List<TicketHistoryDto>>(url);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading history: {ex.Message}");
            history = new List<TicketHistoryDto>();
        }
    }

    private async Task UpdateStatus()
    {
        if (ticket == null) return;

        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User.Identity?.Name ?? "System";

        var payload = new
        {
            TicketId = ticket.Id,
            NewStatus = selectedStatus,
            UpdatedBy = UserState.UserId,
            UpdatedAt = DateTime.UtcNow,
            Remarks = remarks 
        };

        try
        {
            var response = await Http.PutAsJsonAsync($"{AppConfig.ChatUrl}Tickets/UpdateStatus", payload);
            if (response.IsSuccessStatusCode)
            {
                updateMessage = $"✅ Status updated to '{selectedStatus}' with remarks: {remarks}";
                remarks = string.Empty; // clear after update
                await LoadTicket();
                await LoadHistory();
            }
            else
            {
                updateMessage = "⚠ Failed to update ticket status.";
            }
        }
        catch (Exception ex)
        {
            updateMessage = $"Error: {ex.Message}";
        }
        StateHasChanged();
    }
