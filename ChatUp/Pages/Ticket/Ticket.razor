    // private void GoBack() => Navigation.NavigateTo("/ticketlist");
    private string GetPriorityDropdownClass(TicketPriority priority)
    {
        return priority switch
        {
            TicketPriority.Critical => "priority-critical",
            TicketPriority.High => "priority-high",
            TicketPriority.Medium => "priority-medium",
            TicketPriority.Low => "priority-low",
            _ => "priority-default"
        };
    }
    private void GoBack()
    {
        if (UserState.UserId.HasValue)
        {
            // 🔐 Encrypt user ID

            var token = LinkService.Protect(UserState.UserId.Value.ToString());
            var encodedToken = Uri.EscapeDataString(token);
            Navigate($"/ticketlist/{encodedToken}");
        }
    }
