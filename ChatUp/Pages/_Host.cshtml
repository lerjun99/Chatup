@page "/"
@using Microsoft.AspNetCore.Components.Web
@namespace ChatUp.Pages
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <base href="~/" />

    <!-- PWA: installable app -->
    <link rel="manifest" href="manifest.webmanifest" />
    <meta name="theme-color" content="#1e1b4b" />
    <meta name="application-name" content="ChatUp" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="ChatUp" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <link rel="apple-touch-icon" href="icons/apple-touch-icon.png" />

    <!-- CORE STYLES -->
    <link rel="stylesheet" href="css/bootstrap/bootstrap.min.css" />
    <link href="css/site.css" rel="stylesheet" />
    <link href="css/chat.css" rel="stylesheet" />
    <link href="css/otp.css" rel="stylesheet" />
    <link href="css/contract.css" rel="stylesheet" />
    <link href="css/applicant.css" rel="stylesheet" />
    <link href="css/intro.min.css" rel="stylesheet" />
    <link href="ChatUp.styles.css" rel="stylesheet" />
    <link href="css/notifications.css" rel="stylesheet" />
    <link href="css/pwa.css" rel="stylesheet" />

    <!-- ICONS -->
    <link rel="icon" type="image/png" href="~/images/odecci-icon.png" />
    <link href="fontawesome/css/all.min.css" rel="stylesheet" asp-append-version="true" />

    <!-- HEAD OUTLET (SAFE TO PRERENDER) -->
    <component type="typeof(HeadOutlet)" render-mode="ServerPrerendered" />
</head>

<body>
    <!-- MAIN APP (NO PRERENDER TO PREVENT DOUBLE EXECUTION) -->
    @{
        // The audit log records the browser's own address and device (the API only ever sees this web server)
        var forwardedFor = HttpContext.Request.Headers["X-Forwarded-For"].ToString();
        var remoteIp = HttpContext.Connection.RemoteIpAddress;
        var clientIp = !string.IsNullOrWhiteSpace(forwardedFor)
            ? forwardedFor.Split(',')[0].Trim()
            : (remoteIp == null ? null : (remoteIp.IsIPv4MappedToIPv6 ? remoteIp.MapToIPv4() : remoteIp).ToString());
        var clientAgent = HttpContext.Request.Headers.UserAgent.ToString();
    }
    <component type="typeof(App)" render-mode="Server" param-ClientIp="clientIp" param-ClientAgent="clientAgent" />

    <!-- BLAZOR ERROR UI -->
    <div id="blazor-error-ui">
        <environment include="Staging,Production">
            An error has occurred. This application may no longer respond until reloaded.
        </environment>
        <environment include="Development">
            An unhandled exception has occurred. See browser dev tools for details.
        </environment>
        <a href="" class="reload">Reload</a>
        <a class="dismiss">🗙</a>
    </div>
    <!-- Odecci Monitor -->
    <script src="js/monitor-config.js"></script>
    <script async src="https://monitoring.odecci.tech/sdk/v1/monitor.js"></script>
    <!-- CORE SCRIPTS -->
    <script src="js/bootstrap.bundle.min.js"></script>
    <script src="js/intro.min.js"></script>

    <!-- BLAZOR -->
    <script src="_framework/blazor.server.js"></script>

    <!-- CUSTOM JS (DEFERRED) -->
    <script src="js/chat.js" defer></script>
    <script src="js/notify.js" defer></script>
    <script src="js/pwa.js"></script>
    <script src="js/falling.js" defer></script>
    <script src="js/faceCamera.js" defer></script>
    <script src="js/activityTracker.js" defer></script>
    <script src="js/calendar.js" defer></script>
    <script src='https://cdn.jsdelivr.net/npm/fullcalendar@6.1.11/index.global.min.js'></script>
    <!-- HELPERS (a file, not inline: the Content-Security-Policy blocks inline scripts) -->
    <script src="js/helpers.js"></script>
</body>
</html>
