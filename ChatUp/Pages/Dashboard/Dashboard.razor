                <div class="grid grid-2 mb-4">
                    <div class="card">
                        <h3>Tickets by Status</h3>

                        <div class="bargraph-wrapper">
                            <div class="bargraph-yaxis">
                                <div>@MaxTickets</div>
                                <div>@(MaxTickets / 2)</div>
                                <div>0</div>
                            </div>

                            <div class="bargraph">
                                @RenderBar("Open", _Dashboard.TicketCounts.Open, "#3b82f6")
                                @RenderBar("In Progress", _Dashboard.TicketCounts.InProgress, "#22c55e")
                                @RenderBar("Closed", _Dashboard.TicketCounts.Closed, "#f97316")
                                @RenderBar("Rejected", _Dashboard.TicketCounts.Rejected, "#ef4444")
                                @RenderBar("Critical", _Dashboard.TicketCounts.Critical, "#7e22ce")
                            </div>
                        </div>
                    </div>
                    <!-- SLA Alerts -->
                    <div class="card" style="overflow:auto; max-height:300px">
                        <h3>SLA Alerts</h3>
                        <table class="table table-sm table-hover align-middle">
                            <thead class="table-primary">
                                <tr>
                                    <th>Ticket No.</th>
                                    <th>Client</th>
                                    <th>Status</th>
                                    <th>Elapsed</th>
                                    <th>SLA</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var t in tickets)
                                {
                                    var elapsed = DateTime.UtcNow - t.DateReceived;
                                    var timeLeft = t.DueDate.HasValue ? t.DueDate.Value - DateTime.UtcNow : TimeSpan.Zero;

                                    string elapsedFormatted = elapsed.TotalDays >= 1
                                    ? $"{(int)elapsed.TotalDays}d {(int)elapsed.Hours}h"
                                    : elapsed.TotalHours >= 1
                                    ? $"{(int)elapsed.TotalHours}h {(int)elapsed.Minutes}m"
                                    : $"{(int)elapsed.TotalMinutes}m";

                                    // Determine SLA badge CSS and text
                                    string slaClass = t.SlaStatus switch
                                    {
                                        "Breached" => "bg-danger",
                                        "NearSLA" => "bg-warning text-dark",
                                        "OnTrack" => "bg-success",
                                        _ => "bg-light text-dark"
                                    };

                                    string slaText = t.SlaStatus switch
                                    {
                                        "Breached" => "⚠ Breached",
                                        "NearSLA" => "⏳ Near SLA",
                                        "OnTrack" => "✅ On Track",
                                        _ => t.SlaStatus
                                    };

                                    <tr>
                                        <td><strong>@t.TicketNo</strong></td>
                                        <td>@t.ClientName</td>
                                        <td>
                                            <span class="badge @(GetBadgeClass(t.Status))">@t.Status</span>
                                        </td>
                                        <td><span class="elapsed-pill">@elapsedFormatted</span></td>
                                        <td>
                                            <span class="badge @slaClass">@slaText</span>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
                @if (UserState?.UserType != 3)
                {
                    <!-- Agent Productivity -->
                    <div class="card" style="overflow:auto; margin-bottom:15px">
                        <h3>Support Agent Productivity</h3>
                        <table class="table table-sm table-hover align-middle">
                            <thead>
                                <tr>
                                    <th>Agent</th>
                                    <th>Tickets Assigned</th>
                                    <th>Avg First Response (mins)</th>
                                    <th>Idle Time (mins)</th>
                                    <th>Proactiveness (%)</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var a in AgentStats)
                                {
                                    <tr>
                                        <td>@a.Name</td>
                                        <td>@a.TicketCount</td>
                                        <td>@($"{a.AvgFirstResponseMinutes:F1}")</td>
                                        <td>@($"{a.AvgIdleMinutes:F1}")</td>
                                        <td>@($"{a.ProactivenessPercent:F0}%")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                    <div class="card mb-4">

                        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
                            <div>
                                <h3 class="mb-0">Business Calendar</h3>
                                <small class="text-muted">@currentMonthLabel</small>
                            </div>

                            <div class="d-flex gap-2">
                                <select class="form-select form-select-sm"
                                        style="width:160px"
                                        @bind="selectedRegion"
                                        @bind:after="OnRegionChanged">
                                    <option value="PH">Philippines</option>
                                    <option value="US">United States</option>
                                </select>

                                <button class="btn btn-primary btn-sm" @onclick="SyncHolidays">
                                    Sync
                                </button>
                            </div>
                        </div>

                        <div class="gc-layout">

                            <!-- CALENDAR -->
                            <div id="calendar" class="gc-calendar"></div>

                            <!-- AGENDA -->
                            <div class="gc-agenda">

                                <h6>Agenda</h6>

                                @if (_agendaEvents.Any())
                                {
                                    <ul class="agenda-list">
                                        @foreach (var e in _agendaEvents.OrderBy(x => x.Start))
                                        {
                                            <li>
                                                <span class="dot" style="background:@e.Color"></span>
                                                <div>
                                                    <div class="title">@e.Title</div>
                                                    <div class="muted small">@e.Start.ToString("MMM dd yyyy")</div>
                                                </div>
                                            </li>
                                        }
                                    </ul>
                                }
                                else
                                {
                                    <div class="text-muted small">No events</div>
                                }

                            </div>

                        </div>
                    </div>
             
                <!-- Recent Tickets -->
                <div class="card mb-4">
                    <h3>Recent Tickets</h3>
                    <div class="mt-2" style="overflow:auto; height:250px;">
                        @foreach (var t in _Dashboard.RecentTickets.OrderByDescending(x => x.CreatedAt).Take(10))
                        {
                            <div class="ticket-item d-flex justify-content-between align-items-start mb-2">
                                <div>
                                    <div class="fw-600">• @t.Subject</div>
                                    <div class="muted">@t.ClientName • Created @t.CreatedAt.ToString("MMM dd, yyyy HH:mm")</div>
                                </div>
                                <div class="text-end">
                                    <span class="badge @(GetBadgeClass(t.Status))">@t.Status</span>
                                    <div class="muted mt-1">SLA: @t.SlaStatus</div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
              
                @if (UserState?.UserType != 3)
                {
                    <!-- Recent Activity -->
                    <div class="card mb-4" style="
                        overflow: scroll;
                        max-height: 300px;
                        ">
                        <h3>Recent Activity</h3>

                        @if (isLoadingActivity)
                        {
                            <div class="text-center py-3">
                                <i class="fa fa-spinner fa-spin"></i> Loading activity...
                            </div>
                        }
                        else if (_activity?.Items == null || !_activity.Items.Any())
                        {
                            <div class="text-muted py-2">No activity found for the selected date range.</div>
                        }
                        else
                        {
                            <div style="overflow:auto;">
                                <table class="table table-sm table-hover align-middle">
                                    <thead class="table-primary">
                                        <tr>
                                            <th style="width:170px;">Time</th>
                                            <th style="width:180px;">Actor</th>
                                            <th style="width:160px;">Type</th>
                                            <th style="width:140px;">Ticket</th>
                                            <th>Summary</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var a in _activity.Items)
                                        {
                                            <tr>
                                                <td>@a.OccurredAtUtc.ToLocalTime().ToString("MMM dd, yyyy HH:mm")</td>
                                                <td>@a.ActorName</td>
                                                <td>@a.ActivityType</td>
                                                <td>@(string.IsNullOrWhiteSpace(a.TicketNo) ? "-" : a.TicketNo)</td>
                                                <td>@a.Summary</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    </div>
                }
            }
        </section>
    </main>
</div>
@* <button class="mobile-menu-btn" @onclick="ToggleSidebar">Menu</button> *@
@code {

    private bool sidebarVisible = false;
    [Parameter]
    public string EncryptedId { get; set; }
    private bool isLoading = false;
    [Inject]
    public LinkService LinkService { get; set; }
    private int UserId;
    private List<ProjectDto> Projects = new();
    private int? SelectedProjectId;
    private List<ProjectDto> allProjects = new();
    private List<ProjectDto> filteredProjects = new();
    private string projectSearch = string.Empty;
    private int? projectFilter = null;
    private bool showProjectDropdown = false;
    private List<CalendarEventDto> events = new();
    private List<CalendarEventDto> agendaEvents = new();

    private DateTime selectedDate = DateTime.UtcNow;
    private string selectedPriority = "Medium";
    private List<object> calendarJsEvents = new();
    private string selectedRegion = "PH";
    private DateTime currentMonth = DateTime.UtcNow;

    private string currentMonthLabel => currentMonth.ToString("MMMM yyyy");
    private List<AgendaDto> _agendaEvents = new();
    private List<HolidayDto> holidays = new();
    private List<HolidayDto> filteredHolidays = new();

    private List<object> calendarEvents = new();

    private DotNetObjectReference<Dashboard>? objRef;
    private void BuildCalendarEvents()
    {
        var eventItems = events.Select(e => new CalendarJsEvent
        {
            id = e.Id,
            title = e.Title,
            start = e.Start.ToString("yyyy-MM-ddTHH:mm:ss"),
            end = e.End?.ToString("yyyy-MM-ddTHH:mm:ss"),
            color = e.Color,
            editable = true
        });

        var holidayItems = holidays.Select(h => new CalendarJsEvent
        {
            id = null,
            title = h.Name,
            start = h.Date.ToString("yyyy-MM-dd"),
            end = null,
            color = "#fecaca",
            editable = false,
            allDay = true,
            display = "background"
        });

        calendarJsEvents = eventItems
            .Concat(holidayItems)
            .Cast<object>()   // only needed if JS interop expects object
            .ToList();
    }
    [JSInvokable]
    public async Task OnDateClick(string date)
    {
        selectedDate = DateTime.Parse(date);

        // OPEN YOUR TICKET MODAL HERE
        await JS.InvokeVoidAsync("alert", $"Create ticket for {selectedDate:yyyy-MM-dd}");
    }

    [JSInvokable]
    public async Task OnEventDrop(string id, string newDate)
    {
        var ev = events.FirstOrDefault(x => x.Id == id);
        if (ev != null)
        {
            ev.Start = DateTime.Parse(newDate);
            BuildCalendarEvents();
            await RenderCalendar();
        }
    }

    private async Task RenderCalendar()
    {
        objRef = DotNetObjectReference.Create(this);

        await JS.InvokeVoidAsync(
            "renderCalendar",
            calendarJsEvents,
            objRef
        );
    }
    [JSInvokable]
    public async Task OnMonthChanged(string startDate)
    {
        var parsedDate = DateTime.Parse(startDate);

        // 🔥 Move to correct month (FullCalendar gives previous range start)
        selectedDate = parsedDate.AddMonths(1);

        // Optional: normalize to first day of month
        selectedDate = new DateTime(selectedDate.Year, selectedDate.Month, 1);

        currentMonth = selectedDate;

        UpdateAgenda();
        StateHasChanged();
    }
    private void UpdateAgenda()
    {
        _agendaEvents = holidays
            .Where(x => x.Date.Month == selectedDate.Month &&
                        x.Date.Year == selectedDate.Year)
            .Select(x => new AgendaDto
            {
                Title = x.Name,
                Start = x.Date,
                Color = "#ef4444" // holiday color
            })
            .OrderBy(x => x.Start)
            .ToList();
    }
    private string GetColor(string priority) => priority switch
    {
        "Critical" => "#dc2626",
        "High" => "#f97316",
        "Medium" => "#3b82f6",
        "Low" => "#22c55e",
        _ => "#6b7280"
    };
    void ToggleSidebar()
    {
        sidebarVisible = !sidebarVisible;
    }
    private int MaxTickets =>
        new[] {
            _Dashboard.TicketCounts.Open,
            _Dashboard.TicketCounts.InProgress,
            _Dashboard.TicketCounts.Closed,
            _Dashboard.TicketCounts.Rejected,
            _Dashboard.TicketCounts.Critical
        }.Max();

    private RenderFragment RenderBar(string label, int value, string color) => builder =>
    {
        var heightPercent = MaxTickets == 0 ? 0 : (value * 100.0 / MaxTickets);

        builder.OpenElement(0, "div");
        builder.AddAttribute(1, "class", "bar-item");

        builder.AddMarkupContent(2, $@"
            <div class='bar-value'>{value}</div>
            <div class='bar-column'>
                <div class='bar-fill' style='height:{heightPercent}%; background:{color}'></div>
            </div>
            <div class='bar-label'>{label}</div>
        ");

        builder.CloseElement();
    };
    private async Task LoadProjectsAsync()
    {
        try
        {
            var url = $"{AppConfig.ChatUrl}Projects/GetProjectsByUser/by-user/{UserId}";
            var response = await Http.GetFromJsonAsync<List<ProjectDto>>(url);

            if (response != null)
            {
                allProjects = response;
                filteredProjects = allProjects;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"❌ Error loading projects: {ex.Message}");
        }
    }
    private void FilterProjects()
    {
        if (string.IsNullOrWhiteSpace(projectSearch))
        {
            filteredProjects = allProjects;
        }
        else
        {
            filteredProjects = allProjects
                .Where(p => p.Title.Contains(projectSearch, StringComparison.OrdinalIgnoreCase))
                .ToList();
        }
    }
    private void OnProjectInput(ChangeEventArgs e)
    {
        projectSearch = e.Value?.ToString() ?? string.Empty;
        showProjectDropdown = true;

        filteredProjects = allProjects
            .Where(p => p.Title.Contains(projectSearch, StringComparison.OrdinalIgnoreCase))
            .ToList();
    }
    private async Task SelectProject(ProjectDto proj)
    {
        projectSearch = proj.Title;
        projectFilter = proj.Id;

        showProjectDropdown = false;

        _currentPage = 1;
        await LoadDashboardAsync(_currentPage);
    }
    private async Task HideProjectDropdown()
    {
        await Task.Delay(150); // allow click before closing
        showProjectDropdown = false;
    }
    // Dashboard Data
    private DashboardDto? _Dashboard { get; set; }

    // SLA Alerts
    private List<TicketSummaryDto> tickets => _Dashboard?.SlaAlerts.ToList() ?? new List<TicketSummaryDto>();
    private int _currentPage = 1;
    private int _totalPages = 1;
    private int _totalRecords = 0;
    private int FromPage => (_Dashboard != null) ? ((_Dashboard.CurrentPage - 1) * _Dashboard.SlaAlerts.Count() + 1) : 0;
    private int ToPage => (_Dashboard != null) ? Math.Min(_Dashboard.CurrentPage * _Dashboard.SlaAlerts.Count(), _totalRecords) : 0;

    // Agent Stats
    private IEnumerable<AgentStatDto> AgentStats => _Dashboard?.AgentStats ?? Enumerable.Empty<AgentStatDto>();

    // Recent Tickets
    private IEnumerable<TicketSummaryDto> RecentTickets => _Dashboard?.RecentTickets ?? Enumerable.Empty<TicketSummaryDto>();

    protected override async Task OnInitializedAsync()
    {
        await LoadDashboardAsync(_currentPage);
        await LoadActivityAsync(1);
        await LoadProjectsAsync(); // ✅ ADD
        await LoadCalendarData();
    }
    private async Task LoadCalendarData()
    {
        holidays = await Http.GetFromJsonAsync<List<HolidayDto>>(
            $"{AppConfig.ChatUrl}Holidays/Get/{selectedRegion}");
 
        ApplyMonthFilter();
        BuildCalendarEvents();
        BuildAgenda();

        await RenderCalendar();
    }

    private void ApplyMonthFilter()
    {
        filteredHolidays = holidays
            .Where(x => x.Date.Month == currentMonth.Month &&
                        x.Date.Year == currentMonth.Year)
            .ToList();
    }
   
    private void BuildAgenda()
    {
        _agendaEvents = holidays
      .Where(x => x.Date.Month == currentMonth.Month &&
                  x.Date.Year == currentMonth.Year)
      .Select(x => new AgendaDto
      {
          Title = x.Name,
          Start = x.Date,
          Color = "#ef4444"
      })
      .ToList();
    }
    private async Task SyncHolidays()
    {
        await Http.PostAsync(
