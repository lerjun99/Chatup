        get
        {
            var msgs = SelectedTicket?.Messages;
            if (SelectedTicket == null || msgs == null)
                return $"none|{isLoadingMessages}";

            return $"{SelectedTicket.Id}|{isLoadingMessages}|{isLoadingOlderMessages}|{allMessagesLoaded}|" +
                   $"{msgs.Count}|{msgs.FirstOrDefault()?.Id}|{msgs.LastOrDefault()?.Id}|" +
                   $"{msgs.Sum(m => m.Attachments?.Count ?? 0)}|{_messageVersion}";
        }
    }

    private static string StatusLabel(string? status) => status switch
