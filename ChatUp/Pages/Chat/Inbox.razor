    public DateTime? LastSupportReplyAt { get; set; }
    public DateTime? LastClientMessageAt { get; set; }
    private sealed class TicketUploadContentDto
    {
        public int Id { get; set; }
        public string FileName { get; set; } = string.Empty;
        public string FileType { get; set; } = string.Empty;
        public string Base64Content { get; set; } = string.Empty;
        public string? ThumbnailBase64 { get; set; }
    }

    private List<AttachmentItem> NewAttachments = new();
    private class AttachmentItem
    {
        public string Name { get; set; } = string.Empty;
        public string Type { get; set; } = string.Empty;
        public string Base64 { get; set; } = string.Empty;
    }
    private string? attachmentFileType;
    private int currentPage = 1;
    private int pageSize = 20;
    private bool hasMoreTickets = true;
    private int rating = 0;
    private bool canSubmitRating = false;
    private string modalMode = "ticket";
    private HubConnection? hubConnection;
    [Parameter]
    public string EncryptedId { get; set; }
    private CancellationTokenSource _cts;
    [Inject]
    public LinkService LinkService { get; set; }
    private int UserId;
    private List<TicketDto> Tickets = new();
    private TicketDto? SelectedTicket;
    // Auto-resize now happens in the browser (inboxBindComposer), so typing no longer
    // costs an extra JS interop round-trip per keystroke
    private string NewMessage { get; set; } = string.Empty;

    private static readonly JsonSerializerOptions EnumJsonOptions = CreateEnumJsonOptions();

    private static JsonSerializerOptions CreateEnumJsonOptions()
    {
        var options = new JsonSerializerOptions { PropertyNameCaseInsensitive = true };
        options.Converters.Add(new System.Text.Json.Serialization.JsonStringEnumConverter(JsonNamingPolicy.CamelCase));
        return options;
    }

    // ---------- Inbox UI state ----------
    private ElementReference composerWrapperRef;
    private string? _boundBodyId;
    private string? _boundInputId;
    private bool _isSending;
    private string? _sendError;
    private bool showNewMessagesPill;
    private bool showEmojiPicker;
    private readonly List<string> recentEmojis = new();
    private int _messageVersion;      // bumped when message content changes in place
    private int _selectionVersion;    // guards against out-of-order ticket loads

    private bool CanSend =>
        !_isSending && (!string.IsNullOrWhiteSpace(NewMessage) || NewAttachments.Any());

    // Filtering, searching and sorting all happen on the server, so the list is always complete and correctly
    // ordered (searching used to only look inside the few tickets already loaded)
    private IEnumerable<TicketDto> VisibleTickets => Tickets;

    // ---------- Filters ----------
    private bool IsStaff => UserState?.UserType is 1 or 2;
    private bool showRefine;
    private bool showAutoReply;
    private bool filterNeedsReply;
    private bool filterMine;
    private TicketPriority? filterPriority;
    private int? filterClientId;
    private string sortMode = "recent";
    private bool isSearching;
    private CancellationTokenSource? _searchCts;
    private CancellationTokenSource? _refreshCts;
    private int _loadVersion;                       // drops responses that belong to an older filter
    private readonly HashSet<int> unreadTicketIds = new();
    private const string FilterStorageKey = "inbox.filters.v1";

    private int NewCount;
    private int NeedsReplyCount;
    private int ActiveCount => OpenCount + InProgress + NewCount + ResolvedCount + RejectedCount;

    private int RefineCount => (filterPriority.HasValue ? 1 : 0) + (filterClientId.HasValue ? 1 : 0) + (sortMode != "recent" ? 1 : 0);
    private bool HasAnyFilter => !string.IsNullOrWhiteSpace(SearchText) || filterNeedsReply || filterMine || filterPriority.HasValue || filterClientId.HasValue;

    private sealed class SavedFilters
    {
        public bool NeedsReply { get; set; }
        public bool Mine { get; set; }
        public TicketPriority? Priority { get; set; }
        public int? ClientId { get; set; }
        public string Sort { get; set; } = "recent";
    }

    private async Task OnSearchInput(ChangeEventArgs e)
    {
        SearchText = e.Value?.ToString() ?? string.Empty;

        // Debounced: one request after typing pauses, earlier ones are cancelled
        _searchCts?.Cancel();
        var cts = _searchCts = new CancellationTokenSource();
        isSearching = true;

        try
        {
            await Task.Delay(350, cts.Token);
            await ReloadTicketsAsync();
        }
        catch (TaskCanceledException) { }
        finally
        {
            if (ReferenceEquals(cts, _searchCts))
                isSearching = false;
        }
    }

    private async Task ClearSearch()
    {
        _searchCts?.Cancel();
        isSearching = false;
        SearchText = string.Empty;
        await ReloadTicketsAsync();
    }

    private async Task ToggleNeedsReply()
    {
        filterNeedsReply = !filterNeedsReply;
        await SaveFiltersAndReloadAsync();
    }

    private async Task ToggleMine()
    {
        filterMine = !filterMine;
        await SaveFiltersAndReloadAsync();
    }

    private async Task OnPriorityChanged(ChangeEventArgs e)
    {
        filterPriority = Enum.TryParse<TicketPriority>(e.Value?.ToString(), out var p) ? p : null;
        await SaveFiltersAndReloadAsync();
    }

    private async Task OnClientFilterChanged(ChangeEventArgs e)
    {
        filterClientId = int.TryParse(e.Value?.ToString(), out var id) && id > 0 ? id : null;
        await SaveFiltersAndReloadAsync();
    }

    private async Task OnSortChanged(ChangeEventArgs e)
    {
        sortMode = e.Value?.ToString() is { Length: > 0 } s ? s : "recent";
        await SaveFiltersAndReloadAsync();
    }

    private async Task ResetRefine()
    {
        filterPriority = null;
        filterClientId = null;
        sortMode = "recent";
        await SaveFiltersAndReloadAsync();
    }

    private async Task ClearAllFilters()
    {
        _searchCts?.Cancel();
        SearchText = string.Empty;
        filterNeedsReply = false;
        filterMine = false;
        filterPriority = null;
        filterClientId = null;
        sortMode = "recent";
        await SaveFiltersAndReloadAsync();
    }

    private async Task SaveFiltersAndReloadAsync()
    {
        try
        {
            await LocalStorage.SetItemAsync(FilterStorageKey, new SavedFilters
            {
                NeedsReply = filterNeedsReply,
                Mine = filterMine,
                Priority = filterPriority,
                ClientId = filterClientId,
                Sort = sortMode
            });
        }
        catch { /* remembering filters is a convenience only */ }

        await ReloadTicketsAsync();
    }

    private async Task RestoreFiltersAsync()
    {
        try
        {
            var saved = await LocalStorage.GetItemAsync<SavedFilters>(FilterStorageKey);
            if (saved == null)
                return;

            filterNeedsReply = saved.NeedsReply && IsStaff;
            filterMine = saved.Mine && IsStaff;
            filterPriority = saved.Priority;
            filterClientId = saved.ClientId;
            sortMode = string.IsNullOrWhiteSpace(saved.Sort) ? "recent" : saved.Sort;
        }
        catch { }
    }

    /// <summary>First page for the current filters, replacing the list.</summary>
    private async Task ReloadTicketsAsync()
    {
        currentPage = 1;
        hasMoreTickets = true;
        Tickets.Clear();
        isLoadingTickets = false;
        await LoadMoreTickets(true);
    }

    /// <summary>
    /// Refreshes the list in place after realtime activity on a ticket that isn't loaded (several agents share a
    /// client, so tickets change under you). Debounced, keeps the scroll length, never shows skeletons.
    /// </summary>
    private void QueueSilentRefresh()
    {
        _refreshCts?.Cancel();
        var cts = _refreshCts = new CancellationTokenSource();

        _ = InvokeAsync(async () =>
        {
            try
            {
                await Task.Delay(1200, cts.Token);
                if (isLoadingTickets) return;

                var size = Math.Clamp(Tickets.Count, pageSize, 100);
                var response = await FetchTicketsAsync(1, size, cts.Token);
                if (response == null || cts.IsCancellationRequested) return;

                Tickets.Clear();
                Tickets.AddRange(response.Tickets);
                currentPage = (int)Math.Ceiling(response.Tickets.Count / (double)pageSize) + 1;
                hasMoreTickets = response.HasMore;
                ApplyCounts(response);
                StateHasChanged();
            }
            catch (TaskCanceledException) { }
            catch (Exception ex)
            {
                Console.WriteLine($"Silent refresh failed: {ex.Message}");
            }
        });
    }

    private string BuildTicketsUrl(int page, int size)
    {
        var url = $"{AppConfig.ChatUrl}TicketMessage/GetTickets/GetTickets" +
                  $"?userId={UserId}&includeMessages=false&includeHistories=false&page={page}&pageSize={size}&sort={sortMode}";

        if (SelectedStatusFilter.HasValue) url += $"&status={SelectedStatusFilter.Value}";
        if (!string.IsNullOrWhiteSpace(SearchText)) url += $"&search={Uri.EscapeDataString(SearchText.Trim())}";
        if (filterPriority.HasValue) url += $"&priority={filterPriority.Value}";
        if (filterClientId.HasValue) url += $"&clientId={filterClientId.Value}";
        if (filterNeedsReply) url += "&needsReply=true";
        if (filterMine) url += "&assignedToMe=true";
        return url;
    }

    private Task<TicketPagedResponse?> FetchTicketsAsync(int page, int size, CancellationToken ct = default) =>
        Http.GetFromJsonAsync<TicketPagedResponse>(BuildTicketsUrl(page, size), EnumJsonOptions, ct);

    private void ApplyCounts(TicketPagedResponse response)
    {
        int Count(TicketStatus s) => response.StatusCounts?.FirstOrDefault(c => c.Status == s)?.Count ?? 0;

        OpenCount = Count(TicketStatus.Open);
        InProgress = Count(TicketStatus.InProgress);
        NewCount = Count(TicketStatus.New);
        ResolvedCount = Count(TicketStatus.Resolved);
        RejectedCount = Count(TicketStatus.Rejected);
        ClosedCount = Count(TicketStatus.Closed);
        NeedsReplyCount = response.NeedsReplyCount;
    }

    private string PreviewPrefix(TicketDto t)
    {
        if (t.LastMessageIsAutoReply) return "Auto-reply:";
        if (t.LastMessageSenderId == UserId) return "You:";
        return $"{FirstName(t.LastMessageSenderName)}:";
    }

    private static string FirstName(string? name) =>
        string.IsNullOrWhiteSpace(name) ? "Someone" : name.Split(' ', StringSplitOptions.RemoveEmptyEntries)[0];

    private static string Initials(string? name)
    {
        var parts = (name ?? string.Empty).Split(new[] { ' ', '.', '_', '-' }, StringSplitOptions.RemoveEmptyEntries);
        return parts.Length switch
        {
            0 => "?",
            1 => parts[0][..1].ToUpperInvariant(),
            _ => $"{parts[0][0]}{parts[^1][0]}".ToUpperInvariant()
        };
    }

    // A stable colour per name for initials avatars
    private static int Hue(string? name)
    {
        unchecked
        {
            var h = 17;
            foreach (var c in name ?? string.Empty) h = h * 31 + c;
            return Math.Abs(h % 360);
        }
    }

    private static string AvatarSrc(string value) =>
        value.StartsWith("data:") || value.StartsWith("http") || value.StartsWith("/") || value.StartsWith("images/")
            ? value
            : $"data:image/png;base64,{value}";

    // Changes only when the visible conversation changes, so the message list
    // skips re-rendering while the user types
    private string MessageListKey
