        "Open" => "open",
        "InProgress" => "progress",
        "Resolved" => "resolved",
        "Closed" => "closed",
        "Rejected" => "rejected",
        "New" => "new",
        _ => "other"
    };

    private void ToggleEmojiPicker() => showEmojiPicker = !showEmojiPicker;

    private async Task InsertEmoji(string emoji)
