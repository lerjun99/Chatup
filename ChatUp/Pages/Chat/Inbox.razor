@page "/inbox/{EncryptedId}"
@page "/inbox/ticket/{EncryptedId}/{TicketNo}/{Status}"
@implements IDisposable
@using ChatUp.Application.Common.Helpers
@using ChatUp.Application.Features.Client.DTOs
@using ChatUp.Application.Features.Projects.DTOs
@using ChatUp.Application.Features.TicketMessage.Commands
@using ChatUp.Application.Features.TicketMessage.DTOs
@using ChatUp.Application.Features.User.DTOs
@using ChatUp.Application.Features.UserRegistration.Commands
@using ChatUp.Domain.Entities
@using ChatUp.Services
@inject HttpClient Http
@inject NavigationManager Navigation
@inject ChatUp.Services.ChatService ChatService
@inject TitleService TitleService
@inject UserState UserState
@inject IJSRuntime JS
@using Microsoft.AspNetCore.SignalR.Client
@inject IDialogService DialogService
@inject ChatUp.Services.TicketNotificationService _ticketNotificationService
@inject Blazored.SessionStorage.ISessionStorageService SessionStorage
@inject Blazored.LocalStorage.ILocalStorageService LocalStorage
<link href="css/ticket-chat.css" rel="stylesheet" />
<link href="css/inbox.css" rel="stylesheet" />

<div class="ix @(IsSidebarOpen ? "is-sidebar-open" : "") @(SelectedTicket != null ? "has-selection" : "")">

    <!-- ===================== SIDEBAR ===================== -->
    <aside class="ix-sidebar">
        <div class="ix-me" data-intro="This shows your profile and online status." data-step="1">
            <div class="ix-me-avatar">
                <img src="@(!string.IsNullOrEmpty(UserState.AvatarUrl) ? UserState.AvatarUrl : "/images/default-avatar.png")" alt="" />
                <span class="ix-presence @(IsOnline ? "is-online" : "")"></span>
            </div>
            <div class="ix-me-text">
                <div class="ix-me-name">@UserState.Username</div>
                <div class="ix-me-status">@(IsOnline ? "Online" : "Offline")</div>
            </div>
            <button class="ix-icon-btn ix-only-mobile" title="Close ticket list" @onclick="ToggleSidebar">
                <i class="fa-solid fa-xmark"></i>
            </button>
        </div>

        <div class="ix-sidebar-head" data-intro="Here you can see all your tickets and filter them by status." data-step="2">
            <div class="ix-sidebar-title">
                <h2>Inbox</h2>
                <span class="ix-count">@(OpenCount + InProgress + ClosedCount)</span>
            </div>

            <div class="ix-filters" role="tablist" aria-label="Filter tickets by status">
                <button role="tab" class="@(SelectedStatusFilter == null ? "is-active" : "")" @onclick="() => ApplyStatusFilter(null)">All</button>
                <button role="tab" class="@(SelectedStatusFilter == TicketStatus.Open ? "is-active" : "")" @onclick="() => ApplyStatusFilter(TicketStatus.Open)">
                    Open <span>@OpenCount</span>
                </button>
                <button role="tab" class="@(SelectedStatusFilter == TicketStatus.InProgress ? "is-active" : "")" @onclick="() => ApplyStatusFilter(TicketStatus.InProgress)">
                    In progress <span>@InProgress</span>
                </button>
                <button role="tab" class="@(SelectedStatusFilter == TicketStatus.Closed ? "is-active" : "")" @onclick="() => ApplyStatusFilter(TicketStatus.Closed)">
                    Closed <span>@ClosedCount</span>
                </button>
            </div>

            <div class="ix-search" data-intro="Search tickets by title or ticket number." data-step="3">
                <i class="fa-solid fa-magnifying-glass"></i>
                <input type="search" placeholder="Search title or ticket no." aria-label="Search tickets"
                       @bind="SearchText" @bind:event="oninput" />
                @if (!string.IsNullOrEmpty(SearchText))
                {
                    <button class="ix-search-clear" title="Clear search" @onclick='() => SearchText = string.Empty'>
                        <i class="fa-solid fa-xmark"></i>
                    </button>
                }
            </div>
        </div>

        <ul class="ix-tickets" data-intro="This is your ticket list. Click a ticket to open the conversation." data-step="4">
            @if (isLoadingTickets && !Tickets.Any())
            {
                for (var i = 0; i < 5; i++)
                {
                    <li class="ix-skel ix-skel-ticket"></li>
                }
            }
            else if (!VisibleTickets.Any())
            {
                <li class="ix-tickets-empty">
                    <i class="fa-regular fa-folder-open"></i>
                    <span>@(string.IsNullOrWhiteSpace(SearchText) ? "No tickets here yet." : $"No tickets match “{SearchText}”.")</span>
                </li>
            }
            else
            {
                @foreach (var ticket in VisibleTickets)
                {
                    <li @key="ticket.Id">
                        <button type="button" class="ix-ticket @(SelectedTicket?.Id == ticket.Id ? "is-active" : "")"
                                @onclick="@(() => SelectTicket(ticket))">
                            <img class="ix-ticket-avatar" alt="" title="@ticket.ClientName"
                                 src="@(!string.IsNullOrEmpty(ticket.ClientAvatar) ? ticket.ClientAvatar : "/images/default.png")" />
                            <div class="ix-ticket-main">
                                <div class="ix-ticket-top">
                                    <span class="ix-ticket-title" title="@ticket.IssueTitle">@ticket.IssueTitle</span>
                                    <span class="ix-ticket-time">@ticket.ResponseTime</span>
                                </div>
                                <div class="ix-ticket-bottom">
                                    <span class="ix-mono">@(ticket.IsCase ? ticket.CaseNo : ticket.TicketNo)</span>
                                    <span class="ix-status ix-st-@StatusCss(ticket.Status)"><span class="ix-dot"></span>@StatusLabel(ticket.Status)</span>
                                </div>
                                @if (!string.IsNullOrWhiteSpace(ticket.ClientName))
                                {
                                    <div class="ix-ticket-client">@ticket.ClientName</div>
                                }
                            </div>
                        </button>
                    </li>
                }
            }

            @if (isLoadingTickets && Tickets.Any())
            {
                <li class="ix-tickets-more"><i class="fa-solid fa-circle-notch fa-spin"></i> Loading more…</li>
            }

            @if (!isLoadingTickets && hasMoreTickets && Tickets.Any())
            {
                <li class="ix-tickets-more">
                    <button class="ix-link" @onclick="LoadMoreClick"><i class="fa-solid fa-chevron-down"></i> Load more tickets</button>
                </li>
            }
        </ul>

        <div class="ix-sidebar-foot">
            @if (UserState?.UserType is 1 or 2)
            {
                <button class="ix-btn ix-btn-primary ix-btn-block" title="Create New Ticket"
                        @onclick='() => OpenTicketModal("ticket")'
                        data-intro="Click here to create a new ticket" data-step="7">
                    <i class="fa-solid fa-plus"></i> New ticket
                </button>
            }

            @if (UserState?.UserType == 3)
            {
                <button class="ix-btn ix-btn-primary ix-btn-block" title="Create New Case"
                        @onclick='() => OpenTicketModal("case")'
                        data-intro="Click here to create a new case." data-step="7">
                    <i class="fa-solid fa-pen-to-square"></i> New case
                </button>
            }
        </div>
    </aside>

    <div class="ix-scrim" @onclick="ToggleSidebar"></div>

    <!-- ===================== CONVERSATION ===================== -->
    <main class="ix-chat" data-intro="This is where you view and respond to ticket messages." data-step="5">
        @if (SelectedTicket != null)
        {
            <header class="ix-chat-head">
                <button class="ix-icon-btn ix-only-mobile" title="Show tickets" @onclick="ToggleSidebar">
                    <i class="fa-solid fa-arrow-left"></i>
                </button>

                <div class="ix-chat-head-main">
                    @if (!isEditingTitle)
                    {
                        <div class="ix-chat-title">
                            <h1 title="@SelectedTicket.IssueTitle">@SelectedTicket.IssueTitle</h1>
                            <button class="ix-icon-btn ix-icon-btn-sm" title="Edit title" @onclick="() => isEditingTitle = true">
                                <i class="fa-solid fa-pen"></i>
                            </button>
                        </div>
                    }
                    else
                    {
                        <div class="ix-chat-title-edit">
                            <input class="ix-input" @bind="editingTitle" @bind:event="oninput" aria-label="Ticket title" />
                            <button class="ix-icon-btn is-ok" title="Save title" @onclick="SaveTitle"><i class="fa-solid fa-check"></i></button>
                            <button class="ix-icon-btn" title="Cancel" @onclick="CancelEditTitle"><i class="fa-solid fa-xmark"></i></button>
                        </div>
                    }

                    <div class="ix-chat-meta">
                        <button class="ix-link ix-mono" title="Open ticket details" @onclick="NavigateTicket">
                            @(SelectedTicket.IsCase ? SelectedTicket.CaseNo : SelectedTicket.TicketNo)
                            <i class="fa-solid fa-arrow-up-right-from-square"></i>
                        </button>
                        <span class="ix-status ix-st-@StatusCss(SelectedTicket.Status)"><span class="ix-dot"></span>@StatusLabel(SelectedTicket.Status)</span>
                        <span class="ix-prio ix-prio-@SelectedTicket.Priority.ToString().ToLowerInvariant()">@SelectedTicket.Priority</span>
                        <span class="ix-meta-text ix-hide-sm"><i class="fa-regular fa-calendar"></i> @SelectedTicket.DateReceived?.ToLocalTime().ToString("MMM d, yyyy")</span>
                        @if (!string.IsNullOrEmpty(SelectedTicket.ProjectTitle))
                        {
                            <span class="ix-meta-text ix-hide-sm"><i class="fa-solid fa-diagram-project"></i> @SelectedTicket.ProjectTitle</span>
                        }
                    </div>
                </div>

                @if (SelectedTicket.Status != TicketStatus.Closed.ToString() &&
                     SelectedTicket.Status != TicketStatus.Rejected.ToString() &&
                     UserState?.UserType is 1 or 2)
                {
                    <div class="ix-chat-actions">
                        @if (SelectedTicket.IsCase)
                        {
                            <button class="ix-btn ix-btn-ghost" @onclick="() => ConvertToCase(SelectedTicket.Id)">
                                <i class="fa-solid fa-right-left"></i><span class="ix-hide-sm"> Convert to ticket</span>
                            </button>
                        }
                        <button class="ix-btn ix-btn-danger-ghost" @onclick="() => showCloseTicketModal = true">
                            <i class="fa-solid fa-circle-check"></i><span class="ix-hide-sm"> Close ticket</span>
                        </button>
                    </div>
                }
            </header>

            <div class="ix-chat-body-wrap">
                <div class="ix-chat-body" @ref="chatWindowRef">
                    <ChatMessageList Messages="SelectedTicket.Messages"
                                     CurrentUserId="UserId"
                                     IsLoading="isLoadingMessages"
                                     IsLoadingOlder="isLoadingOlderMessages"
                                     AllLoaded="allMessagesLoaded"
                                     RenderKey="@MessageListKey"
                                     OnOpenImage="OpenImage"
                                     OnDownload="DownloadAttachment"
                                     OnRemove="RemoveAttachment" />
                </div>

                @if (showNewMessagesPill)
                {
                    <button class="ix-new-pill" @onclick="JumpToLatest">
                        <i class="fa-solid fa-arrow-down"></i> New messages
                    </button>
                }
            </div>

            <!-- ===================== COMPOSER ===================== -->
            @if (SelectedTicket.Status == TicketStatus.Closed.ToString())
            {
                <div class="ix-rating">
                    <div class="ix-rating-title">
                        <i class="fa-solid fa-lock"></i> This ticket is closed
                    </div>
                    <p>@(IsUserRestricted ? "The client's rating for this ticket:" : "How was our support? Rate your experience.")</p>

                    <div class="ix-stars">
                        @for (int i = 1; i <= 5; i++)
                        {
                            int starIndex = i;
                            <i class="@GetStarClass(starIndex)"
                               style="cursor:@(IsUserRestricted ? "default" : "pointer")"
                               @onclick="@(IsUserRestricted ? null : (() => SetRating(starIndex)))"
                               @onmouseover="@(IsUserRestricted ? null : (() => HoverStar(starIndex)))"
                               @onmouseout="@(IsUserRestricted ? null : ClearHover)"></i>
                        }
                    </div>

                    @if (!IsUserRestricted)
                    {
                        <button class="ix-btn ix-btn-primary" @onclick="SubmitRating" disabled="@(!canSubmitRating)">
                            Submit rating
                        </button>
                    }
                </div>
            }
            else if (SelectedTicket.Status == TicketStatus.Rejected.ToString())
            {
                <div class="ix-rating">
                    <div class="ix-rating-title"><i class="fa-solid fa-ban"></i> This ticket was rejected</div>
                    <p>Replies are disabled for rejected tickets.</p>
                </div>
            }
            else
            {
                <div class="ix-composer" @ref="composerWrapperRef"
                     @ondragover:preventDefault
                     @ondrop:preventDefault
                     data-intro="Type your reply here and send messages or attachments." data-step="6">

                    @if (NewAttachments.Any())
                    {
                        <div class="ix-pending">
                            @foreach (var file in NewAttachments)
                            {
                                <div class="ix-pending-item">
                                    @if (file.Type.StartsWith("image/"))
                                    {
                                        <img src="@($"data:{file.Type};base64,{file.Base64}")" alt="@file.Name" />
                                    }
                                    else
                                    {
                                        <span class="ix-pending-doc"><i class="fa-solid fa-file-lines"></i></span>
                                    }
                                    <span class="ix-pending-name" title="@file.Name">@file.Name</span>
                                    <button type="button" title="Remove" @onclick="() => RemoveNewAttachment(file)">
                                        <i class="fa-solid fa-xmark"></i>
                                    </button>
                                </div>
                            }
                        </div>
                    }

                    @if (_sendError != null)
                    {
                        <div class="ix-send-error">
                            <i class="fa-solid fa-circle-exclamation"></i> @_sendError
                        </div>
                    }

                    <div class="ix-composer-box">
                        <button type="button" class="ix-icon-btn" title="Attach files" @onclick="TriggerFileUpload">
                            <i class="fa-solid fa-paperclip"></i>
                        </button>
                        <button type="button" class="ix-icon-btn @(showEmojiPicker ? "is-active" : "")" title="Emoji"
                                aria-expanded="@showEmojiPicker" @onclick="ToggleEmojiPicker">
                            <i class="fa-regular fa-face-smile"></i>
                        </button>

                        <InputFile id="fileUpload" class="d-none" multiple accept="image/*,application/pdf" OnChange="HandleFileSelected" />

                        <textarea class="ix-textarea"
                                  rows="1"
                                  placeholder="Write a reply…"
                                  aria-label="Message"
                                  @bind="NewMessage"
                                  @bind:event="oninput"
                                  @ref="chatInputRef"
                                  @onkeydown="HandleKeyDown"
                                  @onpaste="HandlePaste"></textarea>

                        <button type="button" class="ix-send" title="Send (Enter)"
                                disabled="@(!CanSend)"
                                @onclick="SendMessage">
                            <i class="fa-solid @(_isSending ? "fa-circle-notch fa-spin" : "fa-paper-plane")"></i>
                        </button>
                    </div>

                    <div class="ix-composer-hint ix-hide-sm">
                        <kbd>Enter</kbd> to send · <kbd>Shift</kbd>+<kbd>Enter</kbd> new line · paste or drop files to attach
                    </div>

                    @if (showEmojiPicker)
                    {
                        <div class="ix-emoji-backdrop" @onclick="() => showEmojiPicker = false"></div>
                        <EmojiPicker OnPick="InsertEmoji" Recent="recentEmojis" />
                    }
                </div>
            }
        }
        else
        {
            <div class="ix-welcome">
                <button class="ix-icon-btn ix-only-mobile ix-welcome-menu" title="Show tickets" @onclick="ToggleSidebar">
                    <i class="fa-solid fa-bars"></i>
                </button>
                <div class="ix-welcome-art">💬</div>
                <h2>Select a conversation</h2>
                <p>Pick a ticket on the left to read and reply to its messages.</p>
                <button class="ix-btn ix-btn-ghost ix-only-mobile" @onclick="ToggleSidebar">
                    <i class="fa-solid fa-inbox"></i> Browse tickets
                </button>
            </div>
        }
    </main>
</div>

@if (showImageModal)
{
    <div class="image-modal-overlay" @onclick="CloseImage">
        <div class="image-modal-card" @onclick:stopPropagation>
            <button class="image-modal-close" @onclick="CloseImage">
                <i class="fa-solid fa-xmark"></i>
            </button>
            <img src="@($"data:{selectedImageType};base64,{selectedImageBase64}")" class="image-modal-img" alt="Preview" />
        </div>
    </div>
}
@if (showTicketModal)
{
    <div class="modal show d-block custom-modal-overlay" tabindex="-1">
        <div class="modal-dialog @(modalMode == "case" ? "modal-dialog-centered modal-sm-case" : "modal-dialog-centered modal-lg")"
             style="display:flex; justify-content:center;">
            <div class="custom-modal-content @(modalMode == "case" ? "modal-small" : "modal-large")">
                <div class="modal-header bg-modal">
                    <h5 class="modal-title">
                        @(modalMode == "case" ? "Create New Case" : "Create Ticket")
                    </h5>
                    <button type="button" class="btn-close"
                            style="background-color:white"
                            @onclick="() => showTicketModal = false"></button>
                </div>

                <div class="modal-body">

                    @if (!string.IsNullOrEmpty(clientValidationError))
                    {
                        <div class="alert alert-warning text-center mb-3">
                            @clientValidationError
                        </div>
                    }

                    <EditForm Model="@newTicket">
                        <DataAnnotationsValidator />
                        <ValidationSummary />
                        @if (modalMode == "case")
                        {
                            <div class="case-center-box">
                                <label class="fw-semibold d-block mb-2" style="text-align:right">Select Project</label>

                                <InputSelect class="form-select w-100" @bind-Value="selectedProjectId">
                                    <option value="0">-- Select Project --</option>
                                    @foreach (var p in projects)
                                    {
                                        <option value="@p.Id">@p.Title</option>
                                    }
                                </InputSelect>
                            </div>
                            <div class="form-group">
                                <label>Priority</label>
                                <InputSelect class="form-select" @bind-Value="newTicket.Priority">
                                    @foreach (var priority in Enum.GetValues<TicketPriority>())
                                    {
                                        <option value="@priority">@priority</option>
                                    }
                                </InputSelect>
                            </div>
                        }
                        else
                        {
                            <div class="modal-grid">

                                @* ---------- ISSUE TITLE ---------- *@
                                @if (modalMode == "ticket")
                                {
                                    <div class="form-group">
                                        <label>Issue Title</label>
                                        <InputText class="form-control" @bind-Value="newTicket.IssueTitle" />
                                    </div>
                                }

                                @* ---------- CLIENT ---------- *@
                                <div class="form-group">
                                    @if (UserState.UserType != 3)
                                    {
                                        <label class="fw-semibold">Select Client</label>
                                        <div class="dropdown client-dropdown">
                                            <button class="btn btn-light border w-100 d-flex justify-content-between"
                                                    type="button"
                                                    @onclick="ToggleClientDropdown"
                                                    disabled="@(UserState.ClientId != 0)">
                                                <span>
                                                    @(selectedClient != null ? selectedClient.ClientName : "-- Select Client --")
                                                </span>
                                                <i class="bi bi-chevron-down text-muted"></i>
                                            </button>

                                            @if (isClientDropdownOpen)
                                            {
                                                <div class="dropdown-menu show w-100 shadow mt-1 p-2">
                                                    <input type="text"
                                                           class="form-control form-control-sm mb-2"
                                                           placeholder="Search..."
                                                           @bind="clientSearchText"
                                                           @bind:event="oninput" />

                                                    @foreach (var c in FilteredClients)
                                                    {
                                                        <div class="dropdown-item"
                                                             @onclick="() => SelectClient(c)">
                                                            @c.ClientName
                                                        </div>
                                                    }
                                                </div>
                                            }
                                        </div>
                                    }
                                </div>

                                @* ---------- USER CLIENT DROPDOWN ---------- *@
                                @if (selectedClient != null)
                                {
                                    <div class="form-group">
                                        <label class="fw-semibold">Contact Person</label>

                                        @if (isLoadingUsers)
                                        {
                                            <div class="text-muted fst-italic">Loading users...</div>
                                        }
                                        else
                                        {
                                            <div class="dropdown user-dropdown">
                                                <button class="btn btn-light border w-100 d-flex justify-content-between"
                                                        type="button"
                                                        @onclick="ToggleUserDropdown">
                                                    <span>
                                                        @(selectedUser != null ? selectedUser.Name : "-- Select User --")
                                                    </span>
                                                    <i class="bi bi-chevron-down text-muted"></i>
                                                </button>

                                                @if (isUserDropdownOpen)
                                                {
                                                    <div class="dropdown-menu show w-100 shadow mt-1 p-2">
                                                        <input type="text"
                                                               class="form-control form-control-sm mb-2"
                                                               placeholder="Search user..."
                                                               @bind="userSearchText"
                                                               @bind:event="oninput" />

                                                        @foreach (var u in FilteredUserClients)
                                                        {
                                                            <div class="dropdown-item"
                                                                 @onclick="() => SelectUser(u)">
                                                                @u.FullName (@u.Username)
                                                            </div>
                                                        }
                                                    </div>
                                                }
                                            </div>
                                        }
                                    </div>
                                }

                                @* ---------- PROJECT ---------- *@
                                <div class="form-group">
                                    <label class="fw-semibold">Project</label>

                                    <div class="dropdown project-dropdown">
                                        <button class="btn btn-light border w-100 d-flex justify-content-between"
                                                type="button"
                                                @onclick="ToggleProjectDropdown">
                                            <span>
                                                @(selectedProject != null ? selectedProject.Title : "-- Select Project --")
                                            </span>
                                            <i class="bi bi-chevron-down text-muted"></i>
                                        </button>

                                        @if (isProjectDropdownOpen)
                                        {
                                            <div class="dropdown-menu show w-100 shadow mt-1 p-2">
                                                <input type="text"
                                                       class="form-control form-control-sm mb-2"
                                                       placeholder="Search project..."
                                                       @bind="projectSearchText"
                                                       @bind:event="oninput" />

                                                @foreach (var p in FilteredProjects)
                                                {
                                                    <div class="dropdown-item"
                                                         @onclick="() => SelectProject(p)">
                                                        @p.Title
                                                    </div>
                                                }
                                            </div>
                                        }
                                    </div>
                                </div>

                                @* ---------- STATUS ---------- *@
                                @if (modalMode == "ticket")
                                {
                                    <div class="form-group">
                                        <label>Status</label>
                                        <InputSelect class="form-select" @bind-Value="newTicket.Status">
                                            @foreach (var status in Enum.GetValues<TicketStatus>())
                                            {
                                                <option value="@status">@status</option>
                                            }
                                        </InputSelect>
                                    </div>

                                    <div class="form-group">
                                        <label>Priority</label>
                                        <InputSelect class="form-select" @bind-Value="newTicket.Priority">
                                            @foreach (var priority in Enum.GetValues<TicketPriority>())
                                            {
                                                <option value="@priority">@priority</option>
                                            }
                                        </InputSelect>
                                    </div>
                                }
                            </div>
                        }
                        @* ---------- BIG TEXTAREA FOR CONCERN (FULL WIDTH) ---------- *@
                        @if (modalMode == "ticket")
                        {
                            <div class="form-group mt-2 full-width">
                                <label>Concern</label>
                                <textarea class="form-control concern-textarea"
                                          @bind="newTicket.Concern"></textarea>
                            </div>
                        }
                        <div class="modal-footer">
                            <button class="btn-submit-small mt-3"
                                    @onclick="@(modalMode == "case" ? CreateCase : HandleCreateTicket)">
                                @(modalMode == "case" ? "Create Case" : "Submit Ticket")
                            </button>
                        </div>
                    </EditForm>
                </div>
            </div>
        </div>
    </div>
}
@if (showCloseTicketModal)
{
    <div class="modal show d-block custom-modal-overlay" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered modal-md">
            <div class="modal-content custom-modal-content">
                <div class="modal-header bg-modal">
                    <h5 class="modal-title">Close Ticket</h5>
                    <button type="button" class="btn-close" style="background-color:white" @onclick="() => showCloseTicketModal = false"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Remarks (optional)</label>
                        <textarea class="form-control" @bind="closeRemarks" rows="4" placeholder="Add remarks before closing the ticket..."></textarea>
                    </div>
                    <div class="d-flex justify-content-end gap-2">
                        <button class="btn btn-secondary" @onclick="() => showCloseTicketModal = false">Cancel</button>
                        <button class="btn btn-danger" @onclick="ConfirmCloseTicket">Close Ticket</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
}
@if (isImageModalOpen)
{
    <!-- Fullscreen Overlay -->
    <div class="image-modal-overlay" @onclick="CloseImage">

        <!-- Modal Card: centers image -->
        <div class="image-modal-card" @onclick:stopPropagation>

            <!-- Image -->
            <img src="@modalImageSrc" class="image-modal-img" alt="Ticket Image" />

        </div>

        <!-- Close Button (fixed top-right) -->
