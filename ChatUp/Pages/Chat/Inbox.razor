    private async void HandleIncomingMessage(MessageDto msg)
    {
        try
        {
            await InvokeAsync(() =>
            {
                if (msg == null)
                    return;

                // The same message can arrive twice (ticket group + personal group): handle it once
                if (msg.Id != 0 && !_seenMessageIds.Add(msg.Id))
                    return;
                if (_seenMessageIds.Count > 2000)
                    _seenMessageIds.Clear();

                var mine = msg.SenderId == UserId;
                var isOpen = SelectedTicket?.Id == msg.TicketId;

                // The open conversation is updated even when its ticket isn't in the loaded list page
                var changed = AddMessageToConversation(msg, scroll: true, force: mine);

                var listItem = Tickets.FirstOrDefault(t => t.Id == msg.TicketId);
                if (listItem != null)
                {
                    BumpTicket(msg.TicketId, msg);
                    changed = true;
                }
                else if (!mine)
                {
                    // A ticket outside the loaded page got a message (e.g. another agent's client chat): refresh quietly
                    QueueSilentRefresh();
                }

                if (!isOpen && !mine)
                {
                    unreadTicketIds.Add(msg.TicketId);
                    changed = true;
                }

                if (changed)
                    StateHasChanged();
            });
        }
        catch (Exception ex)
        {
            // async void: never let an exception escape and tear down the circuit
            Console.WriteLine($"HandleIncomingMessage error: {ex.Message}");
        }
    }

