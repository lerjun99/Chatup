    [JSInvokable]
    public void ReceiveDroppedFile(string base64, string fileName, string fileType)
    {
        NewAttachments.Add(new AttachmentItem
        {
            Base64 = base64,
            Name = fileName,
            Type = fileType
        });

        InvokeAsync(async () =>
           {
               StateHasChanged();
               await JS.InvokeVoidAsync("initLazyImages", chatWindowRef);
           });
    }
    [JSInvokable]
    private async Task DownloadAttachment(TicketUploadDto file)
    {
        try
        {
            var dto = await Http.GetFromJsonAsync<TicketUploadContentDto>($"{AppConfig.ChatUrl}TicketMessage/GetUploadContent/upload/{file.Id}");
            if (dto == null || string.IsNullOrEmpty(dto.Base64Content))
                return;

            var fileBytes = Convert.FromBase64String(dto.Base64Content);
            var fileName = dto.FileName;

            using var memoryStream = new MemoryStream(fileBytes);
            var streamRef = new DotNetStreamReference(memoryStream);

            await JS.InvokeVoidAsync("downloadFileFromStream", fileName, streamRef);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Download failed: {ex.Message}");
        }
    }

}
