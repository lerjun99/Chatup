    private bool _pasteHandlerInitialized = false;
    private DotNetObjectReference<Inbox>? _dotNetRef; // Chat = your component class
    private bool _jsInitialized;
    private bool _isPrerendering = true;
    private bool _onboardingStarted;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        _dotNetRef ??= DotNetObjectReference.Create(this);

        // The chat body and composer are created/destroyed as tickets are opened and closed,
        // so bind browser behaviour to each new element exactly once (instead of waiting for
        // them on first render, which never happened when no ticket was open yet)
        try
        {
            if (!string.IsNullOrEmpty(chatWindowRef.Id) && chatWindowRef.Id != _boundBodyId)
            {
                _boundBodyId = chatWindowRef.Id;
                await JS.InvokeVoidAsync("inboxBindScroll", chatWindowRef, _dotNetRef);
            }

            if (!string.IsNullOrEmpty(chatInputRef.Id) && chatInputRef.Id != _boundInputId)
            {
                _boundInputId = chatInputRef.Id;
                await JS.InvokeVoidAsync("inboxBindComposer", chatInputRef);
                // Pasting is handled by @onpaste (HandlePaste); dropping by this JS drop zone only
                await JS.InvokeVoidAsync("registerDropZone", composerWrapperRef, _dotNetRef);
            }
        }
        catch (JSDisconnectedException) { }

        if (shouldScroll)
        {
            shouldScroll = false;
            await ScrollToBottom();
        }
    }

