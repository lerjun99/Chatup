    private async Task SelectTicket(TicketDto ticket)
    {
        // Clicking another ticket while one is loading must not let the older response win
        var version = ++_selectionVersion;

        SelectedTicket = ticket;
        SelectedTicket.Messages = new List<MessageDto>();
        IsSidebarOpen = false;
        isLoadingMessages = true;
        isEditingTitle = false;
        editingTitle = ticket.IssueTitle;
        showEmojiPicker = false;
        showNewMessagesPill = false;
        _sendError = null;
        StateHasChanged();

        try
        {
            // Join the SignalR group for this ticket
            if (ChatService.IsConnected)
            {
                await ChatService.JoinConversation(ticket.Id);
            }

            // Load full ticket details
            var loaded = await Http.GetFromJsonAsync<TicketDto>(
                $"{AppConfig.ChatUrl}TicketMessage/GetTicket/{ticket.Id}", EnumJsonOptions);

            if (version != _selectionVersion || loaded == null)
                return;

            SelectedTicket = loaded;
            editingTitle = loaded.IssueTitle;

            // Messages and rating are independent — fetch them together
            var ratingTask = loaded.Status == TicketStatus.Closed.ToString()
                ? Http.GetFromJsonAsync<int>($"{AppConfig.ChatUrl}TicketMessage/GetTicketRating/GetTicketRating/{loaded.Id}")
                : Task.FromResult(0);

            await Task.WhenAll(LoadConversation(loaded.Id, loadMore: false), ratingTask);

            if (version != _selectionVersion)
                return;

            if (loaded.Status == TicketStatus.Closed.ToString())
            {
                Rating = ratingTask.Result;      // Set current rating
                HoverRating = ratingTask.Result; // Hover stars match rating
                canSubmitRating = Rating == 0;   // Allow submit only if no rating yet
            }
            else
            {
                canSubmitRating = false; // Disable if ticket is not closed
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"SelectTicket error: {ex.Message}");
        }
        finally
        {
            if (version == _selectionVersion)
            {
                isLoadingMessages = false;
                StateHasChanged();
                await ScrollToBottom();
            }
        }
    }
