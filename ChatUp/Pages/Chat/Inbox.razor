    private async Task SendMessage()
    {
        if (SelectedTicket == null || SelectedTicket.Status is "Closed" or "Rejected")
            return;

        if (!CanSend)
            return;

        IsFromSupport = UserState.UserType == 2 ? false : true;
        var ticket = SelectedTicket;

        // ------------------- Optimistic UI -------------------
        // Take the draft out of the composer right away so a double Enter can't send twice
        var content = NewMessage;
        var attachments = NewAttachments.ToList();
        NewMessage = string.Empty;
        NewAttachments.Clear();
        _isSending = true;
        _sendError = null;
        showEmojiPicker = false;
        StateHasChanged();
        _ = JS.InvokeVoidAsync("inboxResetComposer", chatInputRef).AsTask();

        try
        {
            var request = new AddMessageRequest
            {
                UserId = UserId,
                IsUser = IsFromSupport,
                Content = content,
                Attachments = attachments.Select(a => new TicketUploadDto
                {
                    FileName = a.Name,
                    FileType = a.Type,
                    Base64Content = a.Base64,
                    ThumbnailBase64 = a.Type.StartsWith("image/") ? a.Base64 : null
                }).ToList()
            };

            var response = await Http.PostAsJsonAsync(
                $"{AppConfig.ChatUrl}TicketMessage/AddMessage/{ticket.Id}/messages",
                request);

            if (!response.IsSuccessStatusCode)
            {
                RestoreDraft(content, attachments);
                _sendError = $"Message not sent ({(int)response.StatusCode}). Your text was kept — try again.";
                return;
            }

            // Show the saved message immediately; the SignalR echo is de-duplicated by Id
            var saved = await TryReadMessageAsync(response);
            if (saved != null && saved.Id != 0)
            {
                if (saved.TicketId == 0)
                    saved.TicketId = ticket.Id;
                AddMessageToConversation(saved, scroll: true, force: true);
            }
            else if (!ChatService.IsConnected)
                await LoadConversation(ticket.Id, loadMore: false);

            // Move this ticket to the top locally instead of reloading the whole list
            BumpTicket(ticket.Id);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"SendMessage error: {ex.Message}");
            RestoreDraft(content, attachments);
            _sendError = "Message not sent. Check your connection — your text was kept.";
        }
        finally
        {
            _isSending = false;
            StateHasChanged();
        }
    }

    private void RestoreDraft(string content, List<AttachmentItem> attachments)
    {
        // Don't overwrite anything typed since the failed send
        if (string.IsNullOrEmpty(NewMessage))
            NewMessage = content;
        if (!NewAttachments.Any())
            NewAttachments.AddRange(attachments);
    }

    private static async Task<MessageDto?> TryReadMessageAsync(HttpResponseMessage response)
    {
        try
        {
            return await response.Content.ReadFromJsonAsync<MessageDto>(EnumJsonOptions);
        }
        catch
        {
            return null;
        }
    }

    private void BumpTicket(int ticketId)
    {
        var item = Tickets.FirstOrDefault(t => t.Id == ticketId);
        if (item == null)
            return;

        item.ResponseTime = "Just now";
        item.ResponseTimeSeconds = DateTimeOffset.UtcNow.ToUnixTimeSeconds();
        Tickets.Remove(item);
        Tickets.Insert(0, item);
    }

    /// <summary>Adds a message to the open conversation once (by Id). Returns true if it was new.</summary>
    private bool AddMessageToConversation(MessageDto msg, bool scroll, bool force = false)
    {
        if (SelectedTicket == null || SelectedTicket.Id != msg.TicketId)
            return false;

        SelectedTicket.Messages ??= new List<MessageDto>();
        if (msg.Id != 0 && SelectedTicket.Messages.Any(m => m.Id == msg.Id))
            return false;

        SelectedTicket.Messages.Add(msg);

        if (scroll)
            _ = ScrollToLatestAsync(force);

        return true;
    }

    // Follow new messages only if the reader is already near the bottom;
    // otherwise offer a "New messages" pill instead of yanking the view away
    private async Task ScrollToLatestAsync(bool force)
    {
        try
        {
            var nearBottom = force || await JS.InvokeAsync<bool>("inboxIsNearBottom", chatWindowRef);
            if (nearBottom)
            {
                await ScrollToBottom();
            }
            else
            {
                showNewMessagesPill = true;
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (JSDisconnectedException) { }
    }

