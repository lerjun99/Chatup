    private async Task LoadMoreTickets(bool isloading)
    {
        if (isLoadingTickets && currentPage > 1)
            return;

        if (Tickets.Count == 0)
            hasMoreTickets = true;

        // A filter change while a page is loading wins over the older request
        var version = currentPage == 1 ? ++_loadVersion : _loadVersion;
        var pageToLoad = currentPage;

        isLoadingTickets = isloading;
        await InvokeAsync(StateHasChanged);

        try
        {
            var response = await FetchTicketsAsync(pageToLoad, pageSize);

            if (version != _loadVersion)
                return;

            if (response == null)
            {
                hasMoreTickets = false;
                return;
            }

            ApplyCounts(response);

            // De-duplicate: a ticket bumped by realtime activity may move between pages
            var known = Tickets.Select(t => t.Id).ToHashSet();
            Tickets.AddRange(response.Tickets.Where(t => known.Add(t.Id)));

            currentPage = pageToLoad + 1;
            hasMoreTickets = response.HasMore;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Loading tickets failed: {ex.Message}");
            if (version == _loadVersion)
                hasMoreTickets = false;
        }
        finally
        {
            if (version == _loadVersion)
                isLoadingTickets = false;
            await InvokeAsync(StateHasChanged);
        }
    }
