    private async Task LoadTicketFromRoute(string ticketNo , string status)
    {
        try
        {
            // 1. set search box
            SearchText = ticketNo;
            // ✅ FIX: parse string → enum
            if (!string.IsNullOrWhiteSpace(status) &&
                Enum.TryParse<TicketStatus>(status, true, out var parsedStatus))
            {
                SelectedStatusFilter = parsedStatus;
            }
            else
            {
                SelectedStatusFilter = null;
            }

            // Reset pagination
            currentPage = 1;
            pageSize = 99;
            hasMoreTickets = true;
            Tickets.Clear();

            // 2. ensure tickets are loaded
            if (Tickets == null || !Tickets.Any())
                await LoadTickets(true);

            // 3. find ticket locally first
            var ticket = Tickets
                .FirstOrDefault(x =>
                    x.TicketNo.Equals(ticketNo, StringComparison.OrdinalIgnoreCase));

            // 4. if not found, fetch from API
            if (ticket == null)
            {
                var url = $"{AppConfig.ChatUrl}Tickets/GetByTicketNo/{ticketNo}";
                ticket = await Http.GetFromJsonAsync<TicketDto>(url);
            }

            if (ticket == null)
                return;

            // 5. select ticket (this triggers conversation load)
            await SelectTicket(ticket);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"LoadTicketFromRoute error: {ex.Message}");
        }
    }
