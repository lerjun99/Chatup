    protected override async Task OnInitializedAsync()
    {
        if (string.IsNullOrWhiteSpace(EncryptedId))
        {
            // Prevent crash
            return;
        }
        var decrypted = LinkService.Unprotect(Uri.UnescapeDataString(EncryptedId));

        if (string.IsNullOrEmpty(decrypted))
        {
            // If invalid token, redirect to error or home
            Navigation.NavigateTo("/unauthorized");
            return;
        }
        // Resolve the user before connecting — the hub URL carries the user id
        UserId = int.Parse(decrypted);
        TitleService.SetTitle("Inbox");

        ChatService.OnMessageInboxReceived += HandleIncomingMessage;
        ChatService.OnTicketUpdated += HandleTicketUpdated;
        ChatService.OnTypingReceived += HandleTypingStatus;
        ChatService.OnUserStatusChanged += HandleUserStatusChanged;

        // Needed by the onboarding tour, which may start while tickets load
        _dotNetRef ??= DotNetObjectReference.Create(this);

        // Coming from a ticket link shows that ticket, not the remembered filters
        if (string.IsNullOrWhiteSpace(TicketNo))
            await RestoreFiltersAsync();

        // Independent startup work runs concurrently
        await Task.WhenAll(StartChatAsync(), LoadClient(), LoadTickets(true));
        await base.OnInitializedAsync();
        // 👇 AUTO LOAD TICKET IF PASSED
        if (!string.IsNullOrWhiteSpace(TicketNo))
        {
            await LoadTicketFromRoute(TicketNo,Status);
        }
        if (ReceiverId != 0)
        {
        }
        else if (users.Any())
        {
            ReceiverId = users.First().Id;
            selectedUser = users.First();
        }

    }
