        ChatService.OnMessageInboxReceived -= HandleIncomingMessage;
        ChatService.OnTypingReceived -= HandleTypingStatus;
        ChatService.OnUserStatusChanged -= HandleUserStatusChanged;
    }

    private async void HandleIncomingMessage(MessageDto msg)
    {
        try
        {
            await InvokeAsync(() =>
            {
                if (msg == null)
                    return;

                var mine = msg.SenderId == UserId;

                // The open conversation is updated even when its ticket isn't in the loaded list page
                var changed = AddMessageToConversation(msg, scroll: true, force: mine);

                var listItem = Tickets.FirstOrDefault(t => t.Id == msg.TicketId);
                if (listItem != null && !ReferenceEquals(listItem, SelectedTicket))
                {
                    listItem.Messages ??= new List<MessageDto>();
                    if (!listItem.Messages.Any(m => m.Id == msg.Id))
                    {
                        listItem.Messages.Add(msg);
                        changed = true;
                    }
                }

                if (listItem != null)
                    BumpTicket(msg.TicketId);

                if (changed || listItem != null)
                    StateHasChanged();
            });
        }
        catch (Exception ex)
        {
            // async void: never let an exception escape and tear down the circuit
            Console.WriteLine($"HandleIncomingMessage error: {ex.Message}");
        }
    }

