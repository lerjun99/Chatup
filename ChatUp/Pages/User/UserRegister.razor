@page "/user-registers/{EncryptedId}"
@implements IDisposable
@using ChatUp.Application.Features.Client.DTOs
@using ChatUp.Application.Features.User.DTOs
@using ChatUp.Application.Features.UserRegistration.Commands
@using ChatUp.Application.Features.UserRegistration.DTOs
@using ChatUp.Services
@using ChatUp.Domain.Entities
@inject UserService UserService
@inject IDialogService DialogService
@inject NavigationManager Navigation
@inject HttpClient Http
@inject UserState UserState
@inject Blazored.LocalStorage.ILocalStorageService LocalStorage
<link href="css/users.css" rel="stylesheet" />

<div class="us us-form-page">
    <!-- ============ HEADER ============ -->
    <header class="us-hero us-hero-form">
        <div class="us-hero-main">
            <button class="us-back" title="Back to users" @onclick="GoBack"><i class="fa-solid fa-arrow-left"></i></button>
            <div>
                <div class="us-eyebrow"><i class="fa-solid fa-id-card"></i> @(IsEditMode ? "Edit account" : "New account")</div>
                <h1>@(IsEditMode ? Fallback(model.FullName, model.Username, "Edit user") : "Create a new user")</h1>
                <p>@(IsEditMode ? $"@{model.Username}" : "Set up their sign-in, profile and access.")</p>
            </div>
        </div>
    </header>

    @if (isLoading)
    {
        <div class="us-form-grid">
            <div class="us-card us-skel" style="height:280px"></div>
            <div class="us-card us-skel" style="height:520px"></div>
        </div>
    }
    else
    {
        <EditForm Model="@model" OnValidSubmit="HandleSubmit" OnInvalidSubmit="() => submitTried = true">
            <DataAnnotationsValidator />

            <div class="us-form-grid">

                <!-- ============ PROFILE PHOTO ============ -->
                <aside class="us-card us-photo-card">
                    <h2 class="us-card-title"><i class="fa-regular fa-image"></i> Profile photo</h2>

                    <label class="us-dropzone" for="fileInput" id="dropZone">
                        @if (PreviewUrl != null)
                        {
                            <img src="@PreviewUrl" class="us-photo" alt="Profile preview" />
                            <span class="us-dropzone-overlay"><i class="fa-solid fa-camera"></i> Change photo</span>
                        }
                        else
                        {
                            <span class="us-photo us-photo-empty">@Initials(model.FullName)</span>
                            <span class="us-dropzone-text">
                                <i class="fa-solid fa-cloud-arrow-up"></i>
                                <strong>Upload a photo</strong>
                                <small>PNG, JPG or WEBP · up to @MaxPhotoMb MB</small>
                            </span>
                        }
                    </label>

                    <InputFile id="fileInput" OnChange="OnFileSelection" accept=".jpeg,.jpg,.png,.webp" class="d-none" />

                    @if (pendingPhoto != null)
                    {
                        <div class="us-photo-note">
                            <span><i class="fa-solid fa-circle-info"></i> New photo is saved when you save the user.</span>
                            <button type="button" class="us-link" @onclick="DiscardPhoto">Undo</button>
                        </div>
                    }
                    @if (photoError != null)
                    {
                        <small class="us-error">@photoError</small>
                    }

                    @if (IsEditMode)
                    {
                        <dl class="us-mini-facts">
                            <div><dt>Role</dt><dd>@RoleLabel(model.UserType)</dd></div>
                            <div><dt>Status</dt><dd>@StatusLabel(model.Status)</dd></div>
                            <div><dt>Active</dt><dd>@(model.IsActive ? "Yes" : "No")</dd></div>
                        </dl>
                    }
                </aside>

                <div class="us-form-main">
                    <!-- ============ ACCOUNT ============ -->
                    <section class="us-card">
                        <h2 class="us-card-title"><i class="fa-solid fa-key"></i> Sign-in</h2>
                        <div class="us-fields">
                            <div class="us-field">
                                <label for="username">Username <span class="us-req">*</span></label>
                                <div class="us-input-icon">
                                    <i class="fa-solid fa-at"></i>
                                    <InputText id="username" class="us-input" @bind-Value="model.Username" placeholder="e.g. jdelacruz" autocomplete="off" />
                                </div>
                                <ValidationMessage For="() => model.Username" class="us-error" />
                            </div>

                            <div class="us-field">
                                <label for="password">Password</label>
                                @if (!IsEditMode)
                                {
                                    <div class="us-input-icon">
                                        <i class="fa-solid fa-lock"></i>
                                        <InputText id="password" class="us-input us-input-pad-end" type="@(showPassword ? "text" : "password")"
                                                   @bind-Value="model.Password" placeholder="Set a password" autocomplete="new-password" />
                                        <button type="button" class="us-input-btn" title="@(showPassword ? "Hide password" : "Show password")" @onclick="() => showPassword = !showPassword">
                                            <i class="fa-solid @(showPassword ? "fa-eye-slash" : "fa-eye")"></i>
                                        </button>
                                    </div>
                                    <ValidationMessage For="() => model.Password" class="us-error" />
                                }
                                else
                                {
                                    <div class="us-readonly">
                                        <span><i class="fa-solid fa-lock"></i> ••••••••</span>
                                        @if (IsEditingSelf)
                                        {
                                            <button type="button" class="us-btn us-btn-ghost us-btn-sm" @onclick="NavigateChangePassword">
                                                <i class="fa-solid fa-key"></i> Change password
                                            </button>
                                        }
                                    </div>
                                    <small class="us-hint">@(IsEditingSelf ? "Passwords are hidden for security." : "Users change their own password from their account.")</small>
                                }
                            </div>

                            <div class="us-field us-field-wide">
                                <label for="email">Email address</label>
                                <div class="us-input-icon">
                                    <i class="fa-regular fa-envelope"></i>
                                    <InputText id="email" type="email" class="us-input" @bind-Value="model.EmailAddress" placeholder="name@company.com" />
                                </div>
                                <ValidationMessage For="() => model.EmailAddress" class="us-error" />
                                <small class="us-hint">Used for approval and login emails.</small>
                            </div>
                        </div>
                    </section>

                    <!-- ============ PERSONAL DETAILS ============ -->
                    <section class="us-card">
                        <h2 class="us-card-title"><i class="fa-regular fa-user"></i> Personal details</h2>
                        <div class="us-fields us-fields-3">
                            <div class="us-field">
                                <label for="firstName">First name <span class="us-req">*</span></label>
                                <input id="firstName" class="us-input" placeholder="First name" @bind="firstName" @bind:event="oninput" @bind:after="UpdateFullName" />
                            </div>
                            <div class="us-field">
                                <label for="middleName">Middle name</label>
                                <input id="middleName" class="us-input" placeholder="Optional" @bind="middleName" @bind:event="oninput" @bind:after="UpdateFullName" />
                            </div>
                            <div class="us-field">
                                <label for="lastName">Last name <span class="us-req">*</span></label>
                                <input id="lastName" class="us-input" placeholder="Last name" @bind="lastName" @bind:event="oninput" @bind:after="UpdateFullName" />
                            </div>
                        </div>
                        <div class="us-fullname">
                            <span>Display name</span>
                            <strong>@Fallback(model.FullName, null, "Type a first and last name")</strong>
                        </div>
                        <ValidationMessage For="() => model.FullName" class="us-error" />
                    </section>

                    <!-- ============ ACCESS (admins only) ============ -->
                    @if (UserState?.UserType == 1)
                    {
                        <section class="us-card">
                            <h2 class="us-card-title"><i class="fa-solid fa-shield-halved"></i> Access</h2>
                            <div class="us-fields">
                                <div class="us-field">
                                    <label for="userType">Role</label>
                                    <InputSelect id="userType" class="us-input" @bind-Value="model.UserType">
                                        <option value="">Select a role…</option>
                                        <option value="1">Admin</option>
                                        <option value="2">Support</option>
                                        <option value="3">User</option>
                                        <option value="4">Developer / QA</option>
                                        <option value="5">HR</option>
                                    </InputSelect>
                                </div>

                                <div class="us-field">
                                    <label for="status">Approval status</label>
                                    <InputSelect id="status" class="us-input" @bind-Value="model.Status">
                                        <option value="">Select a status…</option>
                                        <option value="1">Pending</option>
                                        <option value="2">Approved</option>
                                        <option value="3">Blocked</option>
                                    </InputSelect>
                                </div>

                                <label class="us-toggle-card">
                                    <InputCheckbox @bind-Value="model.IsActive" />
                                    <span class="us-switch"><span></span></span>
                                    <span>
                                        <strong>Account active</strong>
                                        <small>@(model.IsActive ? "This user can sign in." : "This user can't sign in.")</small>
                                    </span>
                                </label>

                                <label class="us-toggle-card">
                                    <InputCheckbox @bind-Value="model.IsClient" />
                                    <span class="us-switch"><span></span></span>
                                    <span>
                                        <strong>Client user</strong>
                                        <small>@(model.IsClient ? "Belongs to a client company." : "Internal team member.")</small>
                                    </span>
                                </label>

                                @if (model.IsClient)
                                {
                                    <div class="us-field us-field-wide">
                                        <label>Client company <span class="us-req">*</span></label>
                                        <div class="us-picker">
                                            <button type="button" class="us-input us-picker-btn @(submitTried && selectedClient == null ? "is-invalid" : "")" @onclick="ToggleClientDropdown">
                                                @if (selectedClient != null)
                                                {
                                                    <span class="us-avatar us-avatar-xs us-avatar-client">@Initials(selectedClient.ClientName)</span>
                                                    <span>@selectedClient.ClientName</span>
                                                }
                                                else
                                                {
                                                    <span class="us-muted">Select a client…</span>
                                                }
                                                <i class="fa-solid fa-chevron-down"></i>
                                            </button>

                                            @if (isClientDropdownOpen)
                                            {
                                                <div class="us-menu">
                                                    <input class="us-input" type="search" placeholder="Search clients…" @bind="clientSearchText" @bind:event="oninput" />
                                                    <div class="us-menu-list">
                                                        @if (FilteredClients.Any())
                                                        {
                                                            @foreach (var c in FilteredClients)
                                                            {
                                                                <button type="button" class="us-menu-item @(selectedClient?.Id == c.Id ? "is-selected" : "")" @onclick="() => SelectClient(c)">
                                                                    <span class="us-avatar us-avatar-xs us-avatar-client">@Initials(c.ClientName)</span>
                                                                    <span>@c.ClientName</span>
                                                                    @if (selectedClient?.Id == c.Id)
                                                                    {
                                                                        <i class="fa-solid fa-check"></i>
                                                                    }
                                                                </button>
                                                            }
                                                        }
                                                        else
                                                        {
                                                            <div class="us-menu-empty">No clients found.</div>
                                                        }
                                                    </div>
                                                </div>
                                            }
                                        </div>
                                        @if (submitTried && selectedClient == null)
                                        {
                                            <small class="us-error">Choose the client this user belongs to.</small>
                                        }
                                    </div>
                                }
                            </div>
                        </section>
                    }
                </div>
            </div>

            <!-- ============ ACTIONS ============ -->
            <footer class="us-form-actions">
                <button type="button" class="us-btn us-btn-ghost" @onclick="GoBack" disabled="@isSaving">Cancel</button>
                <div>
                    <button type="button" class="us-btn us-btn-ghost" @onclick="ResetForm" disabled="@isSaving" title="@(IsEditMode ? "Discard your changes" : "Clear the form")">
                        <i class="fa-solid fa-rotate-left"></i><span class="us-hide-sm"> @(IsEditMode ? "Discard changes" : "Clear")</span>
                    </button>
                    <button type="submit" class="us-btn us-btn-primary" disabled="@isSaving">
                        <i class="fa-solid @(isSaving ? "fa-circle-notch fa-spin" : "fa-floppy-disk")"></i>
                        @(isSaving ? "Saving…" : IsEditMode ? "Save changes" : "Create user")
                    </button>
                </div>
            </footer>
        </EditForm>
    }
</div>

@code {
    [Parameter] public string EncryptedId { get; set; } = string.Empty;
    [Inject] public LinkService LinkService { get; set; } = default!;

    private const int MaxPhotoMb = 5;
    private static readonly JsonSerializerOptions JsonOptions = new() { PropertyNameCaseInsensitive = true };

    private int UserId;
    private bool IsEditMode;
    private bool isLoading = true;
    private bool isSaving;
    private bool submitTried;
    private bool showPassword;

    private CreateUserCommand model = new();
    private string firstName = string.Empty;
    private string middleName = string.Empty;
    private string lastName = string.Empty;

    private List<ClientDto> clients = new();
    private ClientDto? selectedClient;
    private bool isClientDropdownOpen;
    private string clientSearchText = string.Empty;

    // Photo: kept in memory until the user is saved, so cancelling leaves nothing behind
    private sealed record PendingPhoto(byte[] Data, string Extension, string ContentType, long Size, string DataUrl);
    private PendingPhoto? pendingPhoto;
    private string? existingPhotoUrl;
    private string? photoError;

    private string? PreviewUrl => pendingPhoto?.DataUrl ?? existingPhotoUrl;
    private bool IsEditingSelf => IsEditMode && UserState.UserId == UserId;

    private IEnumerable<ClientDto> FilteredClients =>
        string.IsNullOrWhiteSpace(clientSearchText)
            ? clients
            : clients.Where(c => (c.ClientName ?? string.Empty).Contains(clientSearchText, StringComparison.OrdinalIgnoreCase));

    // =============================
    // LOADING
    // =============================
    protected override async Task OnInitializedAsync()
    {
        var decrypted = LinkService.Unprotect(Uri.UnescapeDataString(EncryptedId));

        if (string.IsNullOrEmpty(decrypted))
        {
            Navigation.NavigateTo("/unauthorized");
            return;
        }

        UserState.OnChange += StateHasChanged;

        try
        {
            if (decrypted.Equals("new", StringComparison.OrdinalIgnoreCase))
            {
                // 🟢 Create New Mode — nothing to fetch but the client list
                IsEditMode = false;
                model = new CreateUserCommand();
                await LoadClient();
            }
            else if (int.TryParse(decrypted, out UserId))
            {
                // 🟣 Edit Mode — clients and user details load together
                IsEditMode = true;
                var userTask = FetchUserDetails(UserId);
                await Task.WhenAll(LoadClient(), userTask);
                ApplyUserDetails(userTask.Result);
            }
            else
            {
                Navigation.NavigateTo("/unauthorized");
            }
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task<UserDetailsDto?> FetchUserDetails(int userId)
    {
        try
        {
            var response = await Http.GetAsync($"{AppConfig.ChatUrl}User/GetUser/{userId}");
            if (!response.IsSuccessStatusCode)
            {
                Console.WriteLine($"Failed to load user details: {response.StatusCode}");
                return null;
            }

            var rawJson = await response.Content.ReadAsStringAsync();
            try
            {
                // Try single object
                return JsonSerializer.Deserialize<UserDetailsDto>(rawJson, JsonOptions);
            }
            catch (JsonException)
            {
                // Try array fallback
                return JsonSerializer.Deserialize<List<UserDetailsDto>>(rawJson, JsonOptions)?.FirstOrDefault();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading user details: {ex.Message}");
            return null;
        }
    }

    private void ApplyUserDetails(UserDetailsDto? user)
    {
        if (user == null)
            return;

        model = new CreateUserCommand
        {
            Username = user.Username,
            FullName = user.FullName,
            EmailAddress = user.EmailAddress,
            UserType = user.UserType,
            Status = user.Status,
            IsClient = user.IsClient,
            IsActive = user.IsActive,
            ClientId = user.ClientId
        };

        // 🖼️ Profile photo
        var photo = user.UploadedFiles?.FirstOrDefault(f => f.FileType == "ProfileImg");
        existingPhotoUrl = null;
        if (photo != null)
        {
            model.UploadFile = new UploadedFileDto
            {
                Name = photo.Name,
                Base64Content = photo.Base64Content,
                FileType = photo.FileType,
                ContentType = photo.ContentType,
                Size = photo.Size
            };
            existingPhotoUrl = $"/{photo.Base64Content?.TrimStart('/')}";
        }

        // 👤 Full name is stored as "First Middle Last" (see UpdateFullName)
        var parts = (user.FullName ?? string.Empty).Split(' ', StringSplitOptions.RemoveEmptyEntries);
        firstName = parts.Length > 0 ? parts[0] : string.Empty;
        lastName = parts.Length > 1 ? parts[^1] : string.Empty;
        middleName = parts.Length > 2 ? string.Join(' ', parts[1..^1]) : string.Empty;

        // 🧩 Select client if exists
        selectedClient = model.ClientId.HasValue ? clients.FirstOrDefault(c => c.Id == model.ClientId.Value) : null;
    }

    private async Task LoadClient()
    {
        try
        {
            clients = await Http.GetFromJsonAsync<List<ClientDto>>($"{AppConfig.ChatUrl}Client/GetAll", JsonOptions) ?? new();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Failed to load clients: {ex.Message}");
        }
    }

    // =============================
    // FORM
    // =============================
    private void UpdateFullName()
    {
        model.FullName = string.Join(' ', new[] { firstName, middleName, lastName }
            .Select(Capitalize)
            .Where(p => p.Length > 0));
    }

    private static string Capitalize(string? input) =>
        string.IsNullOrWhiteSpace(input) ? "" : char.ToUpper(input.Trim()[0]) + input.Trim()[1..].ToLower();

    private void ToggleClientDropdown() => isClientDropdownOpen = !isClientDropdownOpen;

    private void SelectClient(ClientDto client)
    {
        selectedClient = client;
        model.ClientId = client.Id;
        isClientDropdownOpen = false;
        clientSearchText = string.Empty;
    }

    private async Task OnFileSelection(InputFileChangeEventArgs e)
    {
        photoError = null;
        var file = e.File;
        var ext = Path.GetExtension(file.Name).ToLowerInvariant();

        if (ext is not (".png" or ".jpg" or ".jpeg" or ".webp"))
        {
            photoError = "Only PNG, JPG, JPEG and WEBP images are allowed.";
            return;
        }

        if (file.Size > MaxPhotoMb * 1024L * 1024L)
        {
            photoError = $"That image is larger than {MaxPhotoMb} MB.";
            return;
        }

        using var ms = new MemoryStream();
        await file.OpenReadStream(MaxPhotoMb * 1024L * 1024L).CopyToAsync(ms);
        var data = ms.ToArray();
        var contentType = string.IsNullOrWhiteSpace(file.ContentType) ? "image/png" : file.ContentType;

        pendingPhoto = new PendingPhoto(data, ext, contentType, file.Size, $"data:{contentType};base64,{Convert.ToBase64String(data)}");
    }

    private void DiscardPhoto()
    {
        pendingPhoto = null;
        photoError = null;
    }

    /// <summary>Writes the chosen photo under wwwroot/images and points the model at it.</summary>
    private async Task<string?> SavePendingPhotoAsync()
    {
        if (pendingPhoto == null)
            return null;

        // Generate unique filename to prevent overwrite
        var uniqueFileName = $"cha{Guid.NewGuid().ToString()[..8]}{pendingPhoto.Extension}";
        var folder = Path.Combine(Directory.GetCurrentDirectory(), "wwwroot", "images");
        Directory.CreateDirectory(folder);
        await File.WriteAllBytesAsync(Path.Combine(folder, uniqueFileName), pendingPhoto.Data);

        model.UploadFile = new UploadedFileDto
        {
            Name = uniqueFileName,
            FileType = "ProfileImg",
            Base64Content = $"images/{uniqueFileName}", // relative path used in <img src="..." />
            ContentType = pendingPhoto.ContentType,
            Size = pendingPhoto.Size > int.MaxValue ? int.MaxValue : (int)pendingPhoto.Size
        };

        return $"images/{uniqueFileName}";
    }

    private async Task HandleSubmit()
    {
        submitTried = true;
        UpdateFullName();

        if (string.IsNullOrWhiteSpace(firstName) || string.IsNullOrWhiteSpace(lastName))
        {
            await DialogService.ShowWarningAsync("Please enter both a first and a last name.");
            return;
        }

        if (model.IsClient && selectedClient == null && UserState?.UserType == 1)
            return;

        isSaving = true;
        try
        {
            var newPhotoPath = await SavePendingPhotoAsync();

            if (IsEditMode)
            {
                var updateCommand = new UpdateUserCommand
                {
                    Id = UserId,
                    Username = model.Username,
                    FullName = model.FullName,
                    EmailAddress = model.EmailAddress,
                    UserType = model.UserType,
                    Status = model.Status,
                    IsClient = model.IsClient,
                    IsActive = model.IsActive,
                    UploadFile = model.UploadFile,
                    ClientId = model.IsClient ? model.ClientId : null
                };
                await UserService.UpdateAsync(updateCommand);

                // Refresh the header avatar only once the change is actually saved
                if (newPhotoPath != null && IsEditingSelf)
                {
                    UserState.AvatarUrl = newPhotoPath;
                    await LocalStorage.SetItemAsync("AvatarUrl", newPhotoPath);
                    UserState.NotifyStateChanged();
                }

                existingPhotoUrl = newPhotoPath != null ? $"/{newPhotoPath}" : existingPhotoUrl;
                pendingPhoto = null;
                await DialogService.ShowSuccessAsync("User updated successfully!", "Saved");
            }
            else
            {
                // 🆕 Create new user
                model.Role = model.UserType;
                model.IsDeleted = false;
                model.CreatedBy = UserState.UserId;
                model.RememberToken = "";
                if (!model.IsClient)
                    model.ClientId = null;

                await UserService.RegisterAsync(model);
                await DialogService.ShowSuccessAsync($"{model.FullName} was registered.", "User created");
                Navigation.NavigateTo("/users");
            }
        }
        catch (InvalidOperationException ex)
        {
            // Map specific backend messages to user-friendly UI text
            string userMessage;

            if (ex.Message.Contains("Username already exists", StringComparison.OrdinalIgnoreCase))
                userMessage = "The username you entered is already in use. Please choose another one.";
            else if (ex.Message.Contains("Email address already exists", StringComparison.OrdinalIgnoreCase))
                userMessage = "The email address you entered is already in use. Please use a different email.";
            else if (ex.Message.Contains("Client user must be linked", StringComparison.OrdinalIgnoreCase))
                userMessage = "You must select a client before creating a client user.";
            else if (ex.Message.Contains("Client with ID", StringComparison.OrdinalIgnoreCase))
                userMessage = "The specified client record does not exist.";
            else
                userMessage = "A validation error occurred while processing your request.";

            await DialogService.ShowWarningAsync(userMessage);
        }
        catch (HttpRequestException)
        {
            // Handles failed API calls (network/server issues)
            await DialogService.ShowWarningAsync("Unable to connect to the server. Please try again later.");
        }
        catch (Exception)
        {
            // Fallback for unexpected exceptions
            await DialogService.ShowWarningAsync("An unexpected error occurred. Please contact support.");
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task ResetForm()
    {
        submitTried = false;
        pendingPhoto = null;
        photoError = null;
        isClientDropdownOpen = false;

        if (IsEditMode)
        {
            // Discard changes: reload what's saved
            isLoading = true;
            ApplyUserDetails(await FetchUserDetails(UserId));
            isLoading = false;
        }
        else
        {
            model = new CreateUserCommand();
            selectedClient = null;
            existingPhotoUrl = null;
            firstName = middleName = lastName = string.Empty;
        }
    }

    // =============================
    // NAVIGATION
    // =============================
    private void GoBack() => Navigation.NavigateTo("/users");

    private void NavigateChangePassword()
    {
        if (UserState.UserId.HasValue)
        {
            // 🔐 Encrypt user ID
            var token = LinkService.Protect(UserState.UserId.Value.ToString());
            Navigation.NavigateTo($"/change-password/{Uri.EscapeDataString(token)}", true);
        }
    }

    // =============================
    // FORMATTING
    // =============================
    private static string Fallback(string? value, string? second, string fallback = "—") =>
        !string.IsNullOrWhiteSpace(value) ? value : !string.IsNullOrWhiteSpace(second) ? second : fallback;

    private static string Initials(string? name)
    {
        var parts = (name ?? string.Empty).Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return parts.Length switch
        {
            0 => "?",
            1 => parts[0][..1].ToUpperInvariant(),
            _ => $"{parts[0][0]}{parts[^1][0]}".ToUpperInvariant()
        };
    }

    private static string RoleLabel(int? userType) => userType switch
    {
        1 => "Admin",
        2 => "Support",
        3 => "User",
        4 => "Developer / QA",
        5 => "HR",
        _ => "—"
    };

    private static string StatusLabel(int? status) => status switch
    {
        1 => "Pending",
        2 => "Approved",
        3 => "Blocked",
        _ => "—"
    };

    public void Dispose() => UserState.OnChange -= StateHasChanged;
}
