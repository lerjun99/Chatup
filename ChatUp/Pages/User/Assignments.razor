@page "/assignments/{EncryptedId}"
@using System.Net.Http.Json
@using ChatUp.Application.Features.Client.DTOs
@using ChatUp.Application.Features.Projects.DTOs
@using ChatUp.Application.Features.User.DTOs
@using ChatUp.Application.Features.UserRegistration.DTOs
@using ChatUp.Services
@inject HttpClient Http
@inject NavigationManager Navigation
@inject ChatUp.Services.UserClientAssignmentService AssignmentService
@inject ChatUp.Services.ProjectAssignmentService ProjectAssignmentService
@inject IDialogService DialogService
<link href="css/assignments.css" rel="stylesheet" />

<div class="as">

    <!-- ============ HEADER ============ -->
    <header class="as-hero">
        <div>
            <div class="as-eyebrow"><i class="fa-solid fa-shield-halved"></i> Access control</div>
            <h1>Account Assignments</h1>
            <p>Decide which support agents handle which clients, and which developers work on which projects.</p>
        </div>
        <button class="as-btn as-btn-glass" @onclick="AddNewAssignment" disabled="@isLoading">
            <i class="fa-solid fa-plus"></i> @(activeTab == "dev" ? "Assign developer" : "Assign support agent")
        </button>
    </header>

    <!-- ============ STATS ============ -->
    <section class="as-stats" aria-label="Summary">
        <div class="as-stat">
            <span class="as-stat-icon"><i class="fa-solid fa-headset"></i></span>
            <div><strong>@SupportGroups.Count</strong><span>Support agents</span></div>
        </div>
        <div class="as-stat">
            <span class="as-stat-icon"><i class="fa-solid fa-building"></i></span>
            <div><strong>@CoveredClientCount</strong><span>Clients covered</span></div>
        </div>
        <div class="as-stat">
            <span class="as-stat-icon"><i class="fa-solid fa-diagram-project"></i></span>
            <div><strong>@projectAssignments.Count</strong><span>Projects</span></div>
        </div>
        <div class="as-stat">
            <span class="as-stat-icon"><i class="fa-solid fa-laptop-code"></i></span>
            <div><strong>@DeveloperCount</strong><span>Developers assigned</span></div>
        </div>
    </section>

    <!-- ============ TOOLBAR ============ -->
    <section class="as-toolbar">
        <div class="as-tabs" role="tablist">
            <button role="tab" class="@(activeTab == "client" ? "is-active" : "")" aria-selected="@(activeTab == "client")" @onclick='() => SwitchTab("client")'>
                <i class="fa-solid fa-users"></i> Support ↔ Clients <span>@SupportGroups.Count</span>
            </button>
            <button role="tab" class="@(activeTab == "dev" ? "is-active" : "")" aria-selected="@(activeTab == "dev")" @onclick='() => SwitchTab("dev")'>
                <i class="fa-solid fa-laptop-code"></i> Dev team ↔ Projects <span>@projectAssignments.Count</span>
            </button>
        </div>

        <div class="as-search">
            <i class="fa-solid fa-magnifying-glass"></i>
            <input type="search" aria-label="Search"
                   placeholder="@(activeTab == "dev" ? "Search project, client or developer…" : "Search agent or client…")"
                   @bind="searchText" @bind:event="oninput" />
            @if (!string.IsNullOrEmpty(searchText))
            {
                <button class="as-search-clear" title="Clear search" @onclick='() => searchText = string.Empty'>
                    <i class="fa-solid fa-xmark"></i>
                </button>
            }
        </div>

        <button class="as-btn as-btn-ghost" @onclick="ToggleAll">
            <i class="fa-solid @(AllExpanded ? "fa-compress" : "fa-expand")"></i>
            <span class="as-hide-sm">@(AllExpanded ? "Collapse all" : "Expand all")</span>
        </button>
    </section>

    @if (notice != null)
    {
        <div class="as-alert as-alert-ok" role="status">
            <i class="fa-solid fa-circle-check"></i>
            <span>@notice</span>
            <button class="as-icon-btn" title="Dismiss" @onclick="() => notice = null"><i class="fa-solid fa-xmark"></i></button>
        </div>
    }
    @if (loadError != null)
    {
        <div class="as-alert as-alert-error" role="alert">
            <i class="fa-solid fa-circle-exclamation"></i>
            <span>@loadError</span>
            <button class="as-btn as-btn-ghost as-btn-sm" @onclick="ReloadAllAsync">Try again</button>
        </div>
    }

    @if (isLoading)
    {
        for (var i = 0; i < 4; i++)
        {
            <div class="as-skel"></div>
        }
    }
    else if (activeTab == "client")
    {
        <!-- ============ SUPPORT ↔ CLIENTS ============ -->
        @if (!VisibleSupportGroups.Any())
        {
            <div class="as-empty">
                <i class="fa-solid fa-user-plus"></i>
                <p>@(string.IsNullOrWhiteSpace(searchText) ? "No support agents are assigned to clients yet." : $"Nothing matches “{searchText}”.")</p>
                @if (string.IsNullOrWhiteSpace(searchText))
                {
                    <button class="as-btn as-btn-primary" @onclick="AddNewAssignment"><i class="fa-solid fa-plus"></i> Assign a support agent</button>
                }
            </div>
        }
        else
        {
            @foreach (var group in VisibleSupportGroups)
            {
                var key = $"s_{group.Key}";
                var isOpen = IsExpanded(key);

                <article @key="key" class="as-group @(isOpen ? "is-open" : "")">
                    <button class="as-group-head" aria-expanded="@isOpen" @onclick="() => Toggle(key)">
                        <span class="as-avatar">
                            @if (AvatarSrc(group.AvatarUrl) is string src)
                            {
                                <img src="@src" alt="" />
                            }
                            else
                            {
                                @Initials(group.FullName)
                            }
                        </span>
                        <span class="as-group-text">
                            <strong>@Fallback(group.FullName, group.UserName)</strong>
                            <small>@@@group.UserName</small>
                        </span>
                        <span class="as-chip">@Plural(group.Items.Count, "client")</span>
                        <i class="fa-solid fa-chevron-down as-caret"></i>
                    </button>

                    @if (isOpen)
                    {
                        <div class="as-group-body">
                            <div class="as-rows">
                                <div class="as-row as-row-head as-cols-client">
                                    <span>Client</span>
                                    <span>Location</span>
                                    <span>Client user accounts</span>
                                    <span></span>
                                </div>

                                @foreach (var item in group.Items)
                                {
                                    var accountsKey = $"a_{item.Id}";
                                    var accountsOpen = IsExpanded(accountsKey);

                                    <div @key="item.Id" class="as-row as-cols-client">
                                        <div class="as-cell-main">
                                            <span class="as-avatar as-avatar-sm as-avatar-client">@Initials(item.ClientName)</span>
                                            <div>
                                                <div class="as-strong">@Fallback(item.ClientName)</div>
                                                <div class="as-muted as-small">@Fallback(item.UserEmail, "No email")</div>
                                            </div>
                                        </div>
                                        <div class="as-cell" data-label="Location">
                                            <i class="fa-solid fa-location-dot as-muted"></i> @Fallback(item.Location)
                                        </div>
                                        <div class="as-cell" data-label="Accounts">
                                            @if (item.UserAccounts?.Any() == true)
                                            {
                                                <button class="as-pill-btn @(accountsOpen ? "is-open" : "")" @onclick="() => Toggle(accountsKey)">
                                                    <i class="fa-solid fa-user-group"></i> @Plural(item.UserAccounts.Count, "account")
                                                    <i class="fa-solid fa-chevron-down as-caret-sm"></i>
                                                </button>
                                            }
                                            else
                                            {
                                                <span class="as-muted as-small">No client accounts</span>
                                            }
                                        </div>
                                        <div class="as-actions">
                                            <button class="as-icon-btn" title="Change assignment" @onclick="() => EditAssignment(item)">
                                                <i class="fa-solid fa-pen"></i>
                                            </button>
                                            <button class="as-icon-btn is-danger" title="Remove assignment"
                                                    disabled="@(busyId == item.Id)"
                                                    @onclick="() => DeleteAssignment(item)">
                                                <i class="fa-solid @(busyId == item.Id ? "fa-circle-notch fa-spin" : "fa-trash-can")"></i>
                                            </button>
                                        </div>

                                        @if (accountsOpen && item.UserAccounts?.Any() == true)
                                        {
                                            <ul class="as-accounts">
                                                @foreach (var u in item.UserAccounts)
                                                {
                                                    <li>
                                                        <span class="as-avatar as-avatar-xs">@Initials(u.FullName)</span>
                                                        <div>
                                                            <div class="as-strong">@Fallback(u.FullName) <span class="as-muted">@@@u.Username</span></div>
                                                            <div class="as-muted as-small">@Fallback(u.EmailAddress, "No email")</div>
                                                        </div>
                                                        @if (u.isLoggedIn == 1)
                                                        {
                                                            <span class="as-online" title="Online"></span>
                                                        }
                                                    </li>
                                                }
                                            </ul>
                                        }
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </article>
            }
        }
    }
    else
    {
        <!-- ============ DEV TEAM ↔ PROJECTS ============ -->
        @if (!VisibleProjects.Any())
        {
            <div class="as-empty">
                <i class="fa-solid fa-laptop-code"></i>
                <p>@(string.IsNullOrWhiteSpace(searchText) ? "No projects found." : $"Nothing matches “{searchText}”.")</p>
            </div>
        }
        else
        {
            @foreach (var project in VisibleProjects)
            {
                var key = $"p_{project.Id}";
                var isOpen = IsExpanded(key);

                <article @key="key" class="as-group @(isOpen ? "is-open" : "")">
                    <button class="as-group-head" aria-expanded="@isOpen" @onclick="() => Toggle(key)">
                        <span class="as-avatar as-avatar-project"><i class="fa-solid fa-diagram-project"></i></span>
                        <span class="as-group-text">
                            <strong>@Fallback(project.Title)</strong>
                            <small><i class="fa-solid fa-building"></i> @Fallback(project.ClientName, "No client")</small>
                        </span>
                        <span class="as-chip @(project.Users.Count == 0 ? "is-warn" : "")">@Plural(project.Users.Count, "member")</span>
                        <i class="fa-solid fa-chevron-down as-caret"></i>
                    </button>

                    @if (isOpen)
                    {
                        <div class="as-group-body">
                            @if (!project.Users.Any())
                            {
                                <div class="as-group-empty">
                                    <span><i class="fa-solid fa-triangle-exclamation"></i> Nobody is assigned to this project yet.</span>
                                    <button class="as-btn as-btn-ghost as-btn-sm" @onclick="() => AddDeveloperToProject(project)">
                                        <i class="fa-solid fa-plus"></i> Assign developer
                                    </button>
                                </div>
                            }
                            else
                            {
                                <div class="as-rows">
                                    <div class="as-row as-row-head as-cols-dev">
                                        <span>Member</span>
                                        <span>Role</span>
                                        <span>Team</span>
                                        <span></span>
                                    </div>

                                    @foreach (var dev in project.Users)
                                    {
                                        <div @key="dev.Id" class="as-row as-cols-dev">
                                            <div class="as-cell-main">
                                                <span class="as-avatar as-avatar-sm">
                                                    @if (AvatarSrc(dev.AvatarUrl) is string src)
                                                    {
                                                        <img src="@src" alt="" />
                                                    }
                                                    else
                                                    {
                                                        @Initials(dev.FullName)
                                                    }
                                                </span>
                                                <span class="as-strong">@Fallback(dev.FullName)</span>
                                            </div>
                                            <div class="as-cell" data-label="Role">
                                                <span class="as-role as-role-@dev.UserType">@RoleLabel(dev.UserType)</span>
                                            </div>
                                            <div class="as-cell" data-label="Team">@Fallback(dev.TeamName, "No team")</div>
                                            <div class="as-actions">
                                                <button class="as-icon-btn" title="Change assignment" @onclick="() => EditDevAssignment(project, dev)">
                                                    <i class="fa-solid fa-pen"></i>
                                                </button>
                                                <button class="as-icon-btn is-danger" title="Remove from project"
                                                        disabled="@(busyId == dev.Id)"
                                                        @onclick="() => DeleteDevAssignment(project, dev)">
                                                    <i class="fa-solid @(busyId == dev.Id ? "fa-circle-notch fa-spin" : "fa-user-minus")"></i>
                                                </button>
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    }
                </article>
            }
        }
    }
</div>

<!-- ============ ASSIGNMENT MODAL ============ -->
@if (isModalVisible)
{
    <div class="as-modal-backdrop" @onclick="CloseModal">
        <div class="as-modal" role="dialog" aria-modal="true" aria-labelledby="as-modal-title" @onclick:stopPropagation="true">
            <header class="as-modal-head">
                <div>
                    <h2 id="as-modal-title">@(isEdit ? "Change" : "New") @(activeTab == "dev" ? "developer assignment" : "support assignment")</h2>
                    <p>@(activeTab == "dev" ? "Give a developer access to a client's project." : "Make a support agent responsible for a client.")</p>
                </div>
                <button class="as-icon-btn" title="Close" @onclick="CloseModal"><i class="fa-solid fa-xmark"></i></button>
            </header>

            <div class="as-modal-body">
                <!-- USER -->
                <div class="as-field">
                    <label>@(activeTab == "dev" ? "Developer" : "Support agent")</label>
                    <div class="as-select-wrap">
                        <button type="button" class="as-select @(validationTried && selectedUser == null ? "is-invalid" : "")" @onclick="ToggleUserDropdown">
                            @if (selectedUser != null)
                            {
                                <span class="as-avatar as-avatar-xs">@Initials(selectedUser.Name)</span>
                                <span class="as-select-value">@selectedUser.Name</span>
                            }
                            else
                            {
                                <span class="as-muted">Select a @(activeTab == "dev" ? "developer" : "support agent")…</span>
                            }
                            <i class="fa-solid fa-chevron-down"></i>
                        </button>

                        @if (isUserDropdownOpen)
                        {
                            <div class="as-menu">
                                <input class="as-menu-search" type="search" placeholder="Search by name…" @bind="userSearchText" @bind:event="oninput" />
                                <div class="as-menu-list">
                                    @if (FilteredUsers.Any())
                                    {
                                        @foreach (var u in FilteredUsers)
                                        {
                                            <button type="button" class="as-menu-item @(selectedUser?.Id == u.Id ? "is-selected" : "")" @onclick="() => SelectUser(u)">
                                                <span class="as-avatar as-avatar-xs">@Initials(u.Name)</span>
                                                <span>@u.Name</span>
                                                @if (selectedUser?.Id == u.Id)
                                                {
                                                    <i class="fa-solid fa-check"></i>
                                                }
                                            </button>
                                        }
                                    }
                                    else
                                    {
                                        <div class="as-menu-empty">No matching users.</div>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                    @if (validationTried && selectedUser == null)
                    {
                        <small class="as-error">Please choose a user.</small>
                    }
                </div>

                <!-- CLIENT -->
                <div class="as-field">
                    <label>Client</label>
                    <div class="as-select-wrap">
                        <button type="button" class="as-select @(validationTried && selectedClient == null ? "is-invalid" : "")" @onclick="ToggleClientDropdown">
                            @if (selectedClient != null)
                            {
                                <span class="as-avatar as-avatar-xs as-avatar-client">@Initials(selectedClient.ClientName)</span>
                                <span class="as-select-value">@selectedClient.ClientName</span>
                            }
                            else
                            {
                                <span class="as-muted">Select a client…</span>
                            }
                            <i class="fa-solid fa-chevron-down"></i>
                        </button>

                        @if (isClientDropdownOpen)
                        {
                            <div class="as-menu">
                                <input class="as-menu-search" type="search" placeholder="Search clients…" @bind="clientSearchText" @bind:event="oninput" />
                                <div class="as-menu-list">
                                    @if (FilteredClients.Any())
                                    {
                                        @foreach (var c in FilteredClients)
                                        {
                                            <button type="button" class="as-menu-item @(selectedClient?.Id == c.Id ? "is-selected" : "")" @onclick="() => SelectClient(c)">
                                                <span class="as-avatar as-avatar-xs as-avatar-client">@Initials(c.ClientName)</span>
                                                <span>@c.ClientName</span>
                                                @if (selectedClient?.Id == c.Id)
                                                {
                                                    <i class="fa-solid fa-check"></i>
                                                }
                                            </button>
                                        }
                                    }
                                    else
                                    {
                                        <div class="as-menu-empty">No matching clients.</div>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                    @if (validationTried && selectedClient == null)
                    {
                        <small class="as-error">Please choose a client.</small>
                    }
                </div>

                <!-- PROJECT (dev only) -->
                @if (activeTab == "dev")
                {
                    <div class="as-field">
                        <label>Project</label>
                        @if (selectedClient == null)
                        {
                            <div class="as-hint"><i class="fa-solid fa-circle-info"></i> Choose a client first to see its projects.</div>
                        }
                        else if (isLoadingProjects)
                        {
                            <div class="as-hint"><i class="fa-solid fa-circle-notch fa-spin"></i> Loading projects…</div>
                        }
                        else if (!projects.Any())
                        {
                            <div class="as-hint"><i class="fa-solid fa-triangle-exclamation"></i> This client has no projects yet.</div>
                        }
                        else
                        {
                            <select class="as-native-select @(validationTried && selectedProjectId == 0 ? "is-invalid" : "")" @bind="selectedProjectId">
                                <option value="0">Select a project…</option>
                                @foreach (var p in projects)
                                {
                                    <option value="@p.Id">@p.Title</option>
                                }
                            </select>
                        }
                        @if (validationTried && selectedClient != null && selectedProjectId == 0 && projects.Any())
                        {
                            <small class="as-error">Please choose a project.</small>
                        }
                    </div>
                }

                @if (!string.IsNullOrWhiteSpace(errorMessage))
                {
                    <div class="as-alert as-alert-error"><i class="fa-solid fa-circle-exclamation"></i><span>@errorMessage</span></div>
                }
            </div>

            <footer class="as-modal-foot">
                <button class="as-btn as-btn-ghost" @onclick="CloseModal" disabled="@isSaving">Cancel</button>
                <button class="as-btn as-btn-primary" @onclick="SaveAssignment" disabled="@isSaving">
                    <i class="fa-solid @(isSaving ? "fa-circle-notch fa-spin" : "fa-floppy-disk")"></i>
                    @(isSaving ? "Saving…" : isEdit ? "Save changes" : "Create assignment")
                </button>
            </footer>
        </div>
    </div>
}

@code {
    [Parameter] public string EncryptedId { get; set; } = string.Empty;
    [Inject] public LinkService LinkService { get; set; } = default!;

    private static readonly JsonSerializerOptions JsonOptions = new() { PropertyNameCaseInsensitive = true };

    private int UserId;

    // Data
    private List<UserClientAssignmentDto> assignments = new();
    private List<ProjectDto> projectAssignments = new();
    private List<ClientDto> clients = new();
    private List<UserDto> allUsers = new();
    private List<ProjectDto> projects = new();

    // Page state
    private bool isLoading = true;
    private string? loadError;
    private string? notice;
    private int? busyId;
    private string activeTab = "client";
    private string searchText = string.Empty;
    private readonly HashSet<string> expanded = new();

    // Modal state
    private bool isModalVisible;
    private bool isEdit;
    private bool isSaving;
    private bool validationTried;
    private bool isLoadingProjects;
    private int selectedProjectId;
    private UserClientAssignmentDto model = new();
    private UserDto? selectedUser;
    private ClientDto? selectedClient;
    private string? errorMessage;
    private bool isUserDropdownOpen;
    private bool isClientDropdownOpen;
    private string userSearchText = string.Empty;
    private string clientSearchText = string.Empty;

    private sealed record SupportGroup(string Key, string? UserName, string? FullName, string? AvatarUrl, List<UserClientAssignmentDto> Items);

    // =============================
    // DERIVED VIEW DATA
    // =============================
    private List<SupportGroup> SupportGroups => assignments
        .Where(a => a.UserType == 2) // Support users only
        .GroupBy(a => a.UserId?.ToString() ?? a.UserName ?? string.Empty)
        .Select(g => new SupportGroup(g.Key, g.First().UserName, g.First().FullName, g.First().AvatarUrl, g.ToList()))
        .OrderBy(g => g.FullName)
        .ToList();

    private IEnumerable<SupportGroup> VisibleSupportGroups
    {
        get
        {
            if (string.IsNullOrWhiteSpace(searchText))
                return SupportGroups;

            return SupportGroups
                .Select(g => Matches(g.FullName) || Matches(g.UserName)
                    ? g
                    : g with { Items = g.Items.Where(i => Matches(i.ClientName) || Matches(i.Location)).ToList() })
                .Where(g => g.Items.Any());
        }
    }

    private IEnumerable<ProjectDto> VisibleProjects =>
        string.IsNullOrWhiteSpace(searchText)
            ? projectAssignments
            : projectAssignments.Where(p => Matches(p.Title) || Matches(p.ClientName) || p.Users.Any(u => Matches(u.FullName)));

    private int CoveredClientCount => assignments.Where(a => a.UserType == 2).Select(a => a.ClientId).Distinct().Count();
    private int DeveloperCount => projectAssignments.SelectMany(p => p.Users).Select(u => u.UserId).Distinct().Count();

    private IEnumerable<UserDto> TabUsers =>
        allUsers.Where(u => u.UserType == (activeTab == "dev" ? 4 : 2)); // Dev users / Support users

    private IEnumerable<UserDto> FilteredUsers => string.IsNullOrWhiteSpace(userSearchText)
        ? TabUsers
        : TabUsers.Where(u => (u.Name ?? string.Empty).Contains(userSearchText, StringComparison.OrdinalIgnoreCase));

    private IEnumerable<ClientDto> FilteredClients => string.IsNullOrWhiteSpace(clientSearchText)
        ? clients
        : clients.Where(c => (c.ClientName ?? string.Empty).Contains(clientSearchText, StringComparison.OrdinalIgnoreCase));

    private bool Matches(string? value) =>
        !string.IsNullOrEmpty(value) && value.Contains(searchText.Trim(), StringComparison.OrdinalIgnoreCase);

    // =============================
    // EXPAND / COLLAPSE (pure component state — no Bootstrap/JS)
    // =============================
    private IEnumerable<string> GroupKeys => activeTab == "dev"
        ? VisibleProjects.Select(p => $"p_{p.Id}")
        : VisibleSupportGroups.Select(g => $"s_{g.Key}");

    // While searching, every matching group is shown open
    private bool IsExpanded(string key) =>
        expanded.Contains(key) || (!string.IsNullOrWhiteSpace(searchText) && !key.StartsWith("a_"));

    private bool AllExpanded => GroupKeys.Any() && GroupKeys.All(IsExpanded);

    private void Toggle(string key)
    {
        if (!expanded.Remove(key))
            expanded.Add(key);
    }

    private void ToggleAll()
    {
        if (AllExpanded)
            expanded.Clear();
        else
            foreach (var key in GroupKeys)
                expanded.Add(key);
    }

    private void SwitchTab(string tab)
    {
        // Users are loaded once and filtered per tab — switching tabs is instant
        activeTab = tab;
        searchText = string.Empty;
    }

    // =============================
    // LOADING
    // =============================
    protected override async Task OnInitializedAsync()
    {
        var decrypted = LinkService.Unprotect(Uri.UnescapeDataString(EncryptedId));
        if (string.IsNullOrEmpty(decrypted) || !int.TryParse(decrypted, out UserId))
        {
            Navigation.NavigateTo("/unauthorized");
            return;
        }

        await ReloadAllAsync();
    }

    private async Task ReloadAllAsync()
    {
        isLoading = true;
        loadError = null;

        try
        {
            // Independent requests run concurrently instead of one after another
            await Task.WhenAll(LoadAssignments(), LoadClients(), LoadUserProjects(), LoadUsers());
        }
        catch (Exception ex)
        {
            Console.WriteLine($"❌ Error loading assignments: {ex.Message}");
            loadError = "Couldn't load assignments. Check your connection and try again.";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task LoadAssignments() =>
        assignments = await AssignmentService.GetAllAsync() ?? new List<UserClientAssignmentDto>();

    private async Task LoadUserProjects() =>
        projectAssignments = await ProjectAssignmentService.GetAllAsync() ?? new List<ProjectDto>();

    private async Task LoadClients() =>
        clients = await Http.GetFromJsonAsync<List<ClientDto>>($"{AppConfig.ChatUrl}Client/GetAll") ?? new();

    private async Task LoadUsers()
    {
        try
        {
            allUsers = await Http.GetFromJsonAsync<List<UserDto>>($"{AppConfig.ChatUrl}User/GetUsers", JsonOptions) ?? new();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Failed to load users: {ex.Message}");
        }
    }

    private async Task LoadProjects(int clientId)
    {
        isLoadingProjects = true;
        projects = new();
        StateHasChanged();

        try
        {
            projects = await Http.GetFromJsonAsync<List<ProjectDto>>($"{AppConfig.ChatUrl}Projects/GetByClient/{clientId}", JsonOptions) ?? new();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Failed to load projects: {ex.Message}");
        }
        finally
        {
            isLoadingProjects = false;
        }
    }

    // =============================
    // MODAL
    // =============================
    private void ToggleUserDropdown()
    {
        isUserDropdownOpen = !isUserDropdownOpen;
        isClientDropdownOpen = false;
    }

    private void ToggleClientDropdown()
    {
        isClientDropdownOpen = !isClientDropdownOpen;
        isUserDropdownOpen = false;
    }

    private void SelectUser(UserDto u)
    {
        selectedUser = u;
        model.UserId = u.Id;
        isUserDropdownOpen = false;
        userSearchText = string.Empty;
    }

    private async Task SelectClient(ClientDto c)
    {
        var changed = selectedClient?.Id != c.Id;
        selectedClient = c;
        model.ClientId = c.Id;
        isClientDropdownOpen = false;
        clientSearchText = string.Empty;

        if (activeTab == "dev" && changed)
        {
            selectedProjectId = 0;
            await LoadProjects(c.Id);
        }
    }

    private void ResetModal()
    {
        model = new UserClientAssignmentDto();
        selectedUser = null;
        selectedClient = null;
        selectedProjectId = 0;
        projects = new();
        errorMessage = null;
        validationTried = false;
        isUserDropdownOpen = false;
        isClientDropdownOpen = false;
        userSearchText = string.Empty;
        clientSearchText = string.Empty;
    }

    private void AddNewAssignment()
    {
        ResetModal();
        isEdit = false;
        isModalVisible = true;
    }

    private async Task AddDeveloperToProject(ProjectDto project)
    {
        ResetModal();
        isEdit = false;
        isModalVisible = true;
        selectedClient = clients.FirstOrDefault(c => c.Id == project.ClientId);
        if (selectedClient != null)
        {
            model.ClientId = selectedClient.Id;
            await LoadProjects(selectedClient.Id);
            selectedProjectId = project.Id;
        }
    }

    private void EditAssignment(UserClientAssignmentDto a)
    {
        ResetModal();
        model = new UserClientAssignmentDto
        {
            Id = a.Id,
            UserId = a.UserId,
            ClientId = a.ClientId
        };

        // Show the current values instead of empty pickers
        selectedUser = allUsers.FirstOrDefault(u => u.Id == a.UserId)
                       ?? new UserDto { Id = a.UserId ?? 0, Name = a.FullName ?? a.UserName ?? string.Empty };
        selectedClient = clients.FirstOrDefault(c => c.Id == a.ClientId);

        isEdit = true;
        isModalVisible = true;
    }

    private async Task EditDevAssignment(ProjectDto project, ChatUp.Application.Features.Projects.DTOs.UserAccountDto dev)
    {
        ResetModal();

        // dev.Id is the project-assignment id; dev.UserId is the user's account id
        selectedUser = allUsers.FirstOrDefault(u => u.Id == dev.UserId)
                       ?? new UserDto { Id = dev.UserId, Name = dev.FullName ?? string.Empty };

        model = new UserClientAssignmentDto
        {
            Id = dev.Id,
            UserId = dev.UserId,
            ClientId = project.ClientId,
            UserType = 4
        };

        isEdit = true;
        isModalVisible = true;

        selectedClient = clients.FirstOrDefault(c => c.Id == project.ClientId);
        if (selectedClient != null)
        {
            await LoadProjects(selectedClient.Id);
            selectedProjectId = project.Id;
        }
    }

    private void CloseModal()
    {
        if (!isSaving)
            isModalVisible = false;
    }

    private async Task SaveAssignment()
    {
        validationTried = true;
        errorMessage = null;

        if (selectedUser == null || selectedClient == null || (activeTab == "dev" && selectedProjectId == 0))
            return;

        isSaving = true;
        model.UserId = selectedUser.Id;
        model.ClientId = selectedClient.Id;

        try
        {
            if (activeTab == "dev")
            {
                var projectDto = new UserProjectAssignmentDto
                {
                    Id = model.Id,
                    UserId = selectedUser.Id,
                    ProjectId = selectedProjectId,
                    UserType = 4
                };

                if (isEdit)
                    await ProjectAssignmentService.UpdateAsync(projectDto);
                else
                    await ProjectAssignmentService.CreateAsync(projectDto);

                await LoadUserProjects();
                expanded.Add($"p_{selectedProjectId}");
                notice = isEdit ? "Developer assignment updated." : $"{selectedUser.Name} was assigned to the project.";
            }
            else
            {
                var clientDto = new UserClientAssignmentDto
                {
                    Id = model.Id,
                    UserId = selectedUser.Id,
                    ClientId = selectedClient.Id,
                    UserType = 2
                };

                if (isEdit)
                    await AssignmentService.UpdateAsync(clientDto);
                else
                    await AssignmentService.CreateAsync(clientDto);

                await LoadAssignments();
                expanded.Add($"s_{selectedUser.Id}");
                notice = isEdit ? "Support assignment updated." : $"{selectedUser.Name} now supports {selectedClient.ClientName}.";
            }

            isModalVisible = false;
        }
        catch (Exception ex)
        {
            errorMessage = ExtractMessage(ex.Message);
            if (string.IsNullOrWhiteSpace(errorMessage))
                errorMessage = "Couldn't save the assignment. Please try again.";
        }
        finally
        {
            isSaving = false;
        }
    }

    private static string ExtractMessage(string rawMessage)
    {
        if (string.IsNullOrWhiteSpace(rawMessage))
            return string.Empty;

        try
        {
            using var doc = JsonDocument.Parse(rawMessage);
            if (doc.RootElement.TryGetProperty("message", out var msgElement))
                return msgElement.GetString() ?? string.Empty;
        }
        catch
        {
            // Not a JSON message, return as-is
        }

        return rawMessage;
    }

    // =============================
    // DELETE
    // =============================
    private async Task<bool> ConfirmAsync(string message)
    {
        var dialog = await DialogService.ShowConfirmationAsync(message, "Remove", "Cancel");
        var result = await dialog.Result;
        return !result.Cancelled;
    }

    private async Task DeleteAssignment(UserClientAssignmentDto item)
    {
        if (!await ConfirmAsync($"Remove {item.FullName ?? item.UserName} from {item.ClientName}?"))
            return;

        busyId = item.Id;
        notice = null;
        try
        {
            if (await AssignmentService.DeleteAsync(item.Id))
            {
                // Update locally instead of reloading everything
                assignments.Remove(item);
                notice = $"{item.FullName ?? item.UserName} no longer supports {item.ClientName}.";
            }
            else
            {
                await DialogService.ShowErrorAsync("Failed to remove the assignment.");
            }
        }
        catch (Exception ex)
        {
            await DialogService.ShowErrorAsync($"Error removing assignment: {ex.Message}");
        }
        finally
        {
            busyId = null;
        }
    }

    private async Task DeleteDevAssignment(ProjectDto project, ChatUp.Application.Features.Projects.DTOs.UserAccountDto dev)
    {
        if (!await ConfirmAsync($"Remove {dev.FullName} from {project.Title}?"))
            return;

        busyId = dev.Id;
        notice = null;
        try
        {
            if (await ProjectAssignmentService.DeleteAsync(dev.Id))
            {
                project.Users.Remove(dev);
                notice = $"{dev.FullName} was removed from {project.Title}.";
            }
            else
            {
                await DialogService.ShowErrorAsync("Failed to remove user assignment.");
            }
        }
        catch (Exception ex)
        {
            await DialogService.ShowErrorAsync($"Error removing assignment: {ex.Message}");
        }
        finally
        {
            busyId = null;
        }
    }

    // =============================
    // FORMATTING
    // =============================
    private static string Fallback(string? value, string? fallback = "—") =>
        string.IsNullOrWhiteSpace(value) ? fallback ?? "—" : value;

    private static string Plural(int n, string noun) => $"{n} {noun}{(n == 1 ? "" : "s")}";

    private static string RoleLabel(int? userType) => userType switch
    {
        1 => "Admin",
        2 => "Support",
        3 => "Client",
        4 => "Developer",
        _ => "Member"
    };

    private static string Initials(string? name)
    {
        var parts = (name ?? string.Empty).Split(new[] { ' ', '.', '_' }, StringSplitOptions.RemoveEmptyEntries);
        return parts.Length switch
        {
            0 => "?",
            1 => parts[0][..1].ToUpperInvariant(),
            _ => $"{parts[0][0]}{parts[^1][0]}".ToUpperInvariant()
        };
    }

    // Avatars arrive as URLs, data URIs or raw base64; the default placeholder is shown as initials
    private static string? AvatarSrc(string? value)
    {
        if (string.IsNullOrWhiteSpace(value) || value.Contains("default", StringComparison.OrdinalIgnoreCase))
            return null;
        if (value.StartsWith("data:") || value.StartsWith("http") || value.StartsWith("/") || value.StartsWith("images/"))
            return value;
        return $"data:image/png;base64,{value}";
    }
